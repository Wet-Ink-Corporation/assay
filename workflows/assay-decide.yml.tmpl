# assay's decide-only workflow (#61), installed by a consumer as .github/workflows/assay-decide.yml
# on its default branch: a decision pointer is accepted only from a run of that file (02 §5).
# Spec: docs/architecture/02-architecture.md §1 and §5, 03-contracts.md §4a, 05-security.md §4,
# docs/decisions/0006.
#
# - It decides a PR's head again from the evidence bundle the ledger points at, with a fresh
#   GitHub snapshot, for an /assay command comment, an assay:* label change, or the hourly poll
#   of PRs awaiting owner approval. No model call and no PR code.
# - pull_request_review is not a trigger: it would run the workflow file of the PR's merge
#   commit. There is no branches: filter.
# - guard runs first and holds no secret, environment or App token. Its if: is 02 §5's filter,
#   so a comment that is not an /assay command, or a label that is not assay:*, bills no job. It
#   exits 1 for a head that is not this repository's (0006), so redecide never runs for a fork.
# - redecide runs once per PR guard selected, on the first attempt only (02 §1, T22), in one
#   queue per PR that never cancels and keeps every pending run (queue: max), so a pending owner
#   command is never evicted.
# - No run: holds an expression (T19): every value reaches assay through env:.
# - Every action is pinned by commit SHA; none uses the Actions cache (ADR-21, 05 T6).
# - Repository settings: as assay.yml's (environment assay-publish holding secrets
#   ASSAY_VERDICT_PRIVATE_KEY and ASSAY_LEDGER_PRIVATE_KEY; repository variables
#   ASSAY_VERDICT_APP_ID, ASSAY_VERDICT_BOT_ID and ASSAY_LEDGER_APP_ID).
name: assay-decide

on:
  issue_comment:
    types: [created]
  pull_request_target:
    types: [labeled, unlabeled]
  schedule:
    - cron: "17 * * * *"

permissions: {}

jobs:
  # The PRs to decide again and why (03 §4a): the comment's or the label's PR, or the poll's
  # selection. Base config is read at the commit whose copy of this file runs.
  guard:
    if: github.event_name == 'schedule' || (github.event_name == 'issue_comment' && github.event.issue.pull_request && startsWith(github.event.comment.body, '/assay ') && github.event.sender.type != 'Bot') || (github.event_name == 'pull_request_target' && startsWith(github.event.label.name, 'assay:') && github.event.sender.type != 'Bot')
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    permissions:
      checks: read
      contents: read
      packages: read
      pull-requests: read
    outputs:
      prs: ${{ steps.guard.outputs.prs }}
      trigger: ${{ steps.guard.outputs.trigger }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ github.sha }}
          path: base
          sparse-checkout: .assay
          persist-credentials: false
      - uses: Wet-Ink-Corporation/assay/.github/actions/fetch-by-digest@68f9c188523698bcec37a75dfd70de7d51aa3bae # main, 2026-11-01
        with:
          repository: ghcr.io/wet-ink-corporation/assay
          config: base/.assay/plugins.toml
          artifact-type: application/vnd.wet-ink.assay.binary.v1
          out-dir: bin
      - id: guard
        env:
          # Read only for a comment's PR and the poll (pull-requests, checks: read).
          ASSAY_RUN_TOKEN: ${{ github.token }}
          ASSAY_VERDICT_APP_ID: ${{ vars.ASSAY_VERDICT_APP_ID }}
          ASSAY_VERDICT_BOT_ID: ${{ vars.ASSAY_VERDICT_BOT_ID }}
        run: bin/assay decide-only guard

  # S7-S9 for one PR: decide again, upload the decision bundle, then publish under the per-head
  # lock over the publication register's key.
  redecide:
    needs: [guard]
    if: github.run_attempt == 1 && needs.guard.outputs.prs != '[]'
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    environment: assay-publish
    concurrency:
      group: ${{ format('assay-recheck-{0}-{1}', github.repository_id, matrix.pr) }}
      cancel-in-progress: false
      queue: max
    strategy:
      fail-fast: false
      matrix:
        pr: ${{ fromJSON(needs.guard.outputs.prs) }}
    permissions:
      actions: read
      contents: read
      packages: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ github.sha }}
          path: base
          sparse-checkout: .assay
          persist-credentials: false
      - uses: Wet-Ink-Corporation/assay/.github/actions/fetch-by-digest@68f9c188523698bcec37a75dfd70de7d51aa3bae # main, 2026-11-01
        with:
          repository: ghcr.io/wet-ink-corporation/assay
          config: base/.assay/plugins.toml
          artifact-type: application/vnd.wet-ink.assay.binary.v1
          out-dir: bin
      - id: ledger
        name: Read the ledger repository from base config
        run: |
          python3 -I - base/.assay/plugins.toml >> "$GITHUB_OUTPUT" <<'EOF'
          import re, sys, tomllib
          with open(sys.argv[1], "rb") as config:
              repo = tomllib.load(config)["assay"]["ledger_repo"]
          if not isinstance(repo, str) or not re.fullmatch(r"[A-Za-z0-9-]+/[A-Za-z0-9._-]+", repo):
              sys.exit("[assay].ledger_repo is not owner/name")
          owner, name = repo.split("/")
          print(f"owner={owner}")
          print(f"name={name}")
          EOF
      - id: verdict-token
        uses: actions/create-github-app-token@df432ceedc7162793a195dd1713ff69aefc7379e # v2.0.6
        with:
          app-id: ${{ vars.ASSAY_VERDICT_APP_ID }}
          private-key: ${{ secrets.ASSAY_VERDICT_PRIVATE_KEY }}
          repositories: ${{ github.event.repository.name }}
          permission-checks: write
          permission-contents: read
          permission-pull-requests: write
      - id: ledger-token
        uses: actions/create-github-app-token@df432ceedc7162793a195dd1713ff69aefc7379e # v2.0.6
        with:
          app-id: ${{ vars.ASSAY_LEDGER_APP_ID }}
          private-key: ${{ secrets.ASSAY_LEDGER_PRIVATE_KEY }}
          owner: ${{ steps.ledger.outputs.owner }}
          repositories: ${{ steps.ledger.outputs.name }}
          permission-contents: write
      - id: decide
        env:
          ASSAY_NEEDS: ${{ toJSON(needs) }}
          ASSAY_PR: ${{ matrix.pr }}
          ASSAY_GITHUB_TOKEN: ${{ steps.verdict-token.outputs.token }}
          ASSAY_LEDGER_TOKEN: ${{ steps.ledger-token.outputs.token }}
          ASSAY_RUN_TOKEN: ${{ github.token }}
          ASSAY_VERDICT_APP_ID: ${{ vars.ASSAY_VERDICT_APP_ID }}
          ASSAY_VERDICT_BOT_ID: ${{ vars.ASSAY_VERDICT_BOT_ID }}
        run: bin/assay decide-only decide --config base/.assay/plugins.toml --out decide-out
      # The decision bundle is uploaded before the lock is taken, under the name decide chose for
      # this PR; publish confirms it by sha256 before it writes the decision pointer (J10).
      - id: persist
        if: steps.decide.outputs.bundle == 'true'
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: ${{ steps.decide.outputs.artifact }}
          path: decide-out/run-decision.json
          retention-days: 90
          if-no-files-found: error
      - if: ${{ !cancelled() && steps.decide.outcome == 'success' }}
        env:
          ASSAY_NEEDS: ${{ toJSON(needs) }}
          ASSAY_PR: ${{ matrix.pr }}
          ASSAY_GITHUB_TOKEN: ${{ steps.verdict-token.outputs.token }}
          ASSAY_LEDGER_TOKEN: ${{ steps.ledger-token.outputs.token }}
          ASSAY_RUN_TOKEN: ${{ github.token }}
          ASSAY_VERDICT_APP_ID: ${{ vars.ASSAY_VERDICT_APP_ID }}
          ASSAY_VERDICT_BOT_ID: ${{ vars.ASSAY_VERDICT_BOT_ID }}
          ASSAY_PERSIST: ${{ steps.persist.outcome }}
        run: bin/assay decide-only publish --config base/.assay/plugins.toml --state decide-out
