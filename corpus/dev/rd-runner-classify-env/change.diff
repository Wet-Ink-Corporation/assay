@@ -0,0 +1,69 @@
+//! The `Replay` adapter: recorded stream-json transcripts instead of a live model (03 §7).
+
+use std::cell::Cell;
+
+use assay_app::{ModelCall, ModelResult, ModelRunner};
+
+use crate::stream::{self, Ending};
+
+/// A recorded model call: its stream-json transcript and how the process stopped.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Recording {
+    /// The process exited on its own after writing this transcript.
+    Completed(Vec<u8>),
+    /// The process was killed at its wall-clock limit after writing this much.
+    TimedOut(Vec<u8>),
+}
+
+/// A [`ModelRunner`] that answers each call with the next [`Recording`], classified exactly as
+/// `ClaudeHeadless` classifies a live transcript, with the call's budget as the cap.
+///
+/// It keeps its position in a [`Cell`], so it is not `Sync`: one replay serves one thread.
+#[derive(Debug)]
+pub struct Replay {
+    recordings: Vec<Recording>,
+    next: Cell<usize>,
+}
+
+/// Why a replayed call failed.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, thiserror::Error)]
+pub enum ReplayError {
+    /// Every recording has been replayed.
+    #[error("all {recorded} recorded model calls have been replayed")]
+    Exhausted {
+        /// How many recordings the replay held.
+        recorded: usize,
+    },
+}
+
+impl Replay {
+    /// A replay of `recordings`, in order.
+    #[must_use]
+    pub fn new(recordings: impl IntoIterator<Item = Recording>) -> Self {
+        Self {
+            recordings: recordings.into_iter().collect(),
+            next: Cell::new(0),
+        }
+    }
+}
+
+impl ModelRunner for Replay {
+    type Error = ReplayError;
+
+    /// Classifies the next recording under `call`'s budget.
+    ///
+    /// # Errors
+    /// Returns [`ReplayError::Exhausted`] once every recording has been replayed.
+    fn run(&self, call: &ModelCall) -> Result<ModelResult, ReplayError> {
+        let index = self.next.get();
+        let recording = self.recordings.get(index).ok_or(ReplayError::Exhausted {
+            recorded: self.recordings.len(),
+        })?;
+        self.next.set(index.saturating_add(1));
+        let (transcript, ending) = match recording {
+            Recording::Completed(transcript) => (transcript, Ending::Exited),
+            Recording::TimedOut(transcript) => (transcript, Ending::TimedOut),
+        };
+        Ok(stream::classify(transcript, ending, call.budget))
+    }
+}
diff --git a/crates/assay-runner/src/stream.rs b/crates/assay-runner/src/stream.rs
new file mode 100644
index 0000000..1245f7c
--- /dev/null
+++ b/crates/assay-runner/src/stream.rs
@@ -0,0 +1,114 @@
+//! Classification of a `--output-format stream-json --verbose` transcript (03 §7, §8).
+//!
+//! Each line is one JSON message. Only three kinds matter: `rate_limit_event` (kept when its
+//! status is `rejected` or `allowed_warning`), `assistant` (whose `error: "rate_limit"` marks a
+//! usage-limit refusal) and the final `result`, which alone carries `total_cost_usd` and the
+//! structured output. Every other message is skipped, so new message kinds do not break a call.
+
+mod message;
+
+use assay_app::{ModelOutcome, ModelResult, RateLimitObserved, RateLimitStatus, Structured};
+use assay_domain::Aeu;
+
+use message::{Message, ResultKind, ResultMessage};
+
+/// How the process behind a transcript stopped.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Ending {
+    /// It exited on its own.
+    Exited,
+    /// It was killed at its wall-clock limit.
+    TimedOut,
+    /// It was killed for writing more than the output cap; the transcript is cut short.
+    OutputCapped,
+}
+
+/// The outcome, cost and rate limits of the call behind `transcript`.
+///
+/// The cost is the last `result`'s `total_cost_usd`, or `budget` when the call timed out, was
+/// cut short, or reported no readable cost (03 §8: on timeout the cap is charged).
+pub(crate) fn classify(transcript: &[u8], ending: Ending, budget: Aeu) -> ModelResult {
+    let Scan {
+        result,
+        rate_limits,
+        rate_limited,
+        unreadable,
+    } = Scan::of(transcript);
+    let (outcome, cost) = match ending {
+        Ending::TimedOut => (ModelOutcome::Timeout, budget),
+        Ending::OutputCapped => (ModelOutcome::Malformed, budget),
+        Ending::Exited => {
+            let cost = result
+                .as_ref()
+                .and_then(|result| result.cost)
+                .unwrap_or(budget);
+            let outcome = if unreadable {
+                ModelOutcome::Malformed
+            } else {
+                outcome(result, rate_limited)
+            };
+            (outcome, cost)
+        }
+    };
+    ModelResult {
+        outcome,
+        cost,
+        rate_limits,
+    }
+}
+
+/// What a transcript holds, as far as classification needs it.
+#[derive(Debug, Default)]
+struct Scan {
+    /// The last `result` message.
+    result: Option<ResultMessage>,
+    /// The `rejected` and `allowed_warning` rate-limit events, in order.
+    rate_limits: Vec<RateLimitObserved>,
+    /// A rate-limit event was `rejected` or an assistant message reported `rate_limit`.
+    rate_limited: bool,
+    /// A non-empty line was not a JSON message.
+    unreadable: bool,
+}
+
+impl Scan {
+    fn of(transcript: &[u8]) -> Self {
+        let mut scan = Self::default();
+        let lines = transcript
+            .split(|&byte| byte == b'\n')
+            .filter(|line| !line.trim_ascii().is_empty());
+        for line in lines {
+            match Message::parse(line) {
+                Ok(Message::RateLimit(Some(observed))) => {
+                    scan.rate_limited |= observed.status == RateLimitStatus::Rejected;
+                    scan.rate_limits.push(observed);
+                }
+                Ok(Message::Assistant { rate_limited }) => scan.rate_limited |= rate_limited,
+                Ok(Message::Result(result)) => scan.result = Some(result),
+                Ok(Message::RateLimit(None) | Message::Other) => {}
+                Err(_) => scan.unreadable = true,
+            }
+        }
+        scan
+    }
+}
+
+/// The outcome of a call that exited with a readable transcript.
+fn outcome(result: Option<ResultMessage>, rate_limited: bool) -> ModelOutcome {
+    let Some(result) = result else {
+        return if rate_limited {
+            ModelOutcome::QuotaExhausted
+        } else {
+            ModelOutcome::Malformed
+        };
+    };
+    match result.kind {
+        ResultKind::MaxBudget => ModelOutcome::BudgetExhausted,
+        ResultKind::MaxTurns => ModelOutcome::TurnsExhausted,
+        ResultKind::Success => match result.structured {
+            Some(value) if !value.is_null() => ModelOutcome::Ok(Structured::new(value)),
+            _ => ModelOutcome::Malformed,
+        },
+        ResultKind::Error if rate_limited || result.usage_limit => ModelOutcome::QuotaExhausted,
+        ResultKind::Error => ModelOutcome::Malformed,
+    }
+}
diff --git a/crates/assay-runner/src/stream/message.rs b/crates/assay-runner/src/stream/message.rs
new file mode 100644
index 0000000..43ae7a4
--- /dev/null
+++ b/crates/assay-runner/src/stream/message.rs
@@ -0,0 +1,118 @@
+//! One stream-json line, reduced to the fields classification reads (OUT-01). The shapes are
+//! those of Claude Code 2.1.296's SDK messages.
+
+use assay_app::{RateLimitObserved, RateLimitStatus};
+use assay_domain::Aeu;
+use serde_json::{Map, Value};
+
+use crate::cost;
+
+/// A stream line that is not a JSON object with a string `type`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(super) struct Unreadable;
+
+/// The parts of one message that matter.
+#[derive(Debug, PartialEq)]
+pub(super) enum Message {
+    /// A `rate_limit_event`; `None` unless its status is `rejected` or `allowed_warning`.
+    RateLimit(Option<RateLimitObserved>),
+    /// An `assistant` message; `rate_limited` when its `error` is `rate_limit`.
+    Assistant { rate_limited: bool },
+    /// The `result` message.
+    Result(ResultMessage),
+    /// Any other message.
+    Other,
+}
+
+/// The final `result` message.
+#[derive(Debug, PartialEq)]
+pub(super) struct ResultMessage {
+    pub(super) kind: ResultKind,
+    /// `total_cost_usd`, when it is a readable cost.
+    pub(super) cost: Option<Aeu>,
+    /// `structured_output`, when present.
+    pub(super) structured: Option<Value>,
+    /// `api_error` is `usage_limit_reached`.
+    pub(super) usage_limit: bool,
+}
+
+/// How a `result` message ended the call.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(super) enum ResultKind {
+    /// `subtype: success` with `is_error: false`.
+    Success,
+    /// `subtype: error_max_budget_usd`.
+    MaxBudget,
+    /// `subtype: error_max_turns`.
+    MaxTurns,
+    /// Any other ending: an error result, or a subtype this code does not know.
+    Error,
+}
+
+impl Message {
+    pub(super) fn parse(line: &[u8]) -> Result<Self, Unreadable> {
+        let Ok(Value::Object(mut object)) = serde_json::from_slice::<Value>(line) else {
+            return Err(Unreadable);
+        };
+        let kind = object
+            .get("type")
+            .and_then(Value::as_str)
+            .ok_or(Unreadable)?;
+        Ok(match kind {
+            "rate_limit_event" => Self::RateLimit(rate_limit(&object)),
+            "assistant" => Self::Assistant {
+                rate_limited: object.get("error").and_then(Value::as_str) == Some("rate_limit"),
+            },
+            "result" => Self::Result(result(&mut object)),
+            _ => Self::Other,
+        })
+    }
+}
+
+fn rate_limit(object: &Map<String, Value>) -> Option<RateLimitObserved> {
+    let info = object.get("rate_limit_info")?;
+    let status = match info.get("status").and_then(Value::as_str)? {
+        "rejected" => RateLimitStatus::Rejected,
+        "allowed_warning" => RateLimitStatus::AllowedWarning,
+        _ => return None,
+    };
+    Some(RateLimitObserved {
+        status,
+        resets_at: info.get("resetsAt").and_then(Value::as_u64),
+    })
+}
+
+fn result(object: &mut Map<String, Value>) -> ResultMessage {
+    let is_error = object.get("is_error").and_then(Value::as_bool);
+    let kind = match object.get("subtype").and_then(Value::as_str) {
+        Some("success") if is_error == Some(false) => ResultKind::Success,
+        Some("error_max_budget_usd") => ResultKind::MaxBudget,
+        Some("error_max_turns") => ResultKind::MaxTurns,
+        _ => ResultKind::Error,
+    };
+    ResultMessage {
+        kind,
+        cost: object.get("total_cost_usd").and_then(cost::from_usd),
+        structured: object.remove("structured_output"),
+        usage_limit: object.get("api_error").and_then(Value::as_str) == Some("usage_limit_reached"),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{Message, Unreadable};
+
+    #[test]
+    fn a_line_that_is_not_an_object_is_unreadable() {
+        assert_eq!(Message::parse(b"[1, 2]"), Err(Unreadable));
+        assert_eq!(Message::parse(br#"{"no_type": 1}"#), Err(Unreadable));
+    }
+
+    #[test]
+    fn an_unknown_message_kind_is_skipped() {
+        assert_eq!(
+            Message::parse(br#"{"type": "stream_event"}"#),
+            Ok(Message::Other)
+        );
+    }
+}
diff --git a/crates/assay-runner/tests/fixtures/fake-claude b/crates/assay-runner/tests/fixtures/fake-claude
