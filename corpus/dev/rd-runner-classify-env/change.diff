index 0000000..08605bb
--- /dev/null
+++ b/crates/assay-runner/src/cost.rs
@@ -0,0 +1,65 @@
+//! `total_cost_usd` (a JSON number of dollars) to [`Aeu`].
+
+use assay_domain::Aeu;
+use serde_json::Value;
+
+/// Micro-AEU in one AEU.
+const MICROS_PER_AEU: u64 = 1_000_000;
+
+/// The cost a `total_cost_usd` value reports, rounded to the nearest micro-AEU, or `None` when it
+/// is not a non-negative number that fits.
+///
+/// The float is rendered with six fixed decimals and parsed back as integers, which converts it
+/// without a lossy `as` cast (H-11); fixed-precision formatting never uses an exponent.
+pub(crate) fn from_usd(value: &Value) -> Option<Aeu> {
+    let dollars = value.as_f64()?;
+    if dollars.is_sign_negative() {
+        return None;
+    }
+    let text = format!("{dollars:.6}");
+    let (whole, fraction) = text.split_once('.')?;
+    let whole: u64 = whole.parse().ok()?;
+    let fraction: u64 = fraction.parse().ok()?;
+    whole
+        .checked_mul(MICROS_PER_AEU)?
+        .checked_add(fraction)
+        .map(Aeu::from_micros)
+}
+
+#[cfg(test)]
+mod tests {
+    use serde_json::json;
+
+    use super::{Aeu, from_usd};
+
+    #[test]
+    fn converts_a_fraction_of_a_dollar() {
+        assert_eq!(from_usd(&json!(0.4213)), Some(Aeu::from_micros(421_300)));
+    }
+
+    #[test]
+    fn converts_whole_dollars_given_as_an_integer() {
+        assert_eq!(from_usd(&json!(2)), Some(Aeu::from_micros(2_000_000)));
+    }
+
+    #[test]
+    fn rounds_to_the_nearest_micro_aeu() {
+        assert_eq!(from_usd(&json!(0.000_000_6)), Some(Aeu::from_micros(1)));
+        assert_eq!(from_usd(&json!(1e-9)), Some(Aeu::ZERO));
+    }
+
+    #[test]
+    fn rejects_negative_costs() {
+        assert_eq!(from_usd(&json!(-0.5)), None);
+    }
+
+    #[test]
+    fn rejects_costs_too_large_to_hold() {
+        assert_eq!(from_usd(&json!(1e30)), None);
+    }
+
+    #[test]
+    fn rejects_values_that_are_not_numbers() {
+        assert_eq!(from_usd(&json!("0.42")), None);
+    }
+}
diff --git a/crates/assay-runner/src/headless.rs b/crates/assay-runner/src/headless.rs
new file mode 100644
index 0000000..1b144ed
--- /dev/null
+++ b/crates/assay-runner/src/headless.rs
@@ -0,0 +1,151 @@
+//! The `ClaudeHeadless` adapter: `claude -p` under the hardened headless profile (03 §8).
+
+mod env;
+mod supervise;
+mod workdir;
+
+use std::io;
+use std::path::PathBuf;
+use std::process::Command;
+use std::time::Duration;
+
+use assay_app::{ModelCall, ModelResult, ModelRunner};
+
+pub use env::{EnvVarError, HeadlessEnv};
+pub use workdir::{Workdir, WorkdirError};
+
+use crate::stream;
+
+/// The transcript cap when none is set: 32 MiB.
+const DEFAULT_MAX_OUTPUT_BYTES: u64 = 32 * 1024 * 1024;
+
+/// The only tools a headless call has (03 §8): no `Bash`, no web, no writes.
+const TOOLS: &str = "Read,Grep,Glob";
+
+/// `--settings` (03 §8): hooks off, reads of `/proc`, `/sys`, `~` and `/etc` denied, and
+/// `blockReadsOutsideWorkingDirectories` nested under `permissions`, where the CLI reads it.
+const SETTINGS: &str = r#"{"disableAllHooks":true,"permissions":{"deny":["Read(//proc/**)","Read(//sys/**)","Read(~/**)","Read(//etc/**)"],"blockReadsOutsideWorkingDirectories":true}}"#;
+
+/// A [`ModelRunner`] that runs `claude -p` with the headless profile of 03 §8, authenticated by
+/// an OAuth token.
+///
+/// Every call runs in the same empty [`Workdir`] with the [`HeadlessEnv`] environment, under the
+/// call's timeout and this runner's transcript cap. Its transcript is classified like a
+/// `Replay` recording: a timeout is charged at the call's budget, as is a transcript cut off at
+/// the cap (reported [`Malformed`](assay_app::ModelOutcome::Malformed)). The exit status is not
+/// consulted: the transcript's `result` message decides. The CLI's stderr is discarded.
+#[derive(Debug)]
+pub struct ClaudeHeadless {
+    program: PathBuf,
+    workdir: Workdir,
+    env: HeadlessEnv,
+    max_output_bytes: u64,
+}
+
+/// Why a headless call could not be made or supervised.
+///
+/// Up to and including [`Spawn`](Self::Spawn), the CLI never ran and nothing is charged. After
+/// it, the CLI may have run and its cost is unknown: the caller charges the call's budget.
+#[derive(Debug, thiserror::Error)]
+pub enum HeadlessError {
+    /// A path in the call is relative, so it would resolve against the empty working directory.
+    #[error("{path} is not an absolute path")]
+    RelativePath {
+        /// The relative path.
+        path: PathBuf,
+    },
+    /// The working directory is unusable, or no longer empty.
+    #[error(transparent)]
+    Workdir(#[from] WorkdirError),
+    /// The timeout reaches past what the clock can represent.
+    #[error("the timeout of {timeout:?} cannot be represented")]
+    TimeoutTooLong {
+        /// The requested timeout.
+        timeout: Duration,
+    },
+    /// The temporary file holding the transcript could not be created or read.
+    #[error("the transcript spool failed")]
+    Spool(#[source] io::Error),
+    /// The CLI could not be started.
+    #[error("the claude CLI could not be started")]
+    Spawn(#[source] io::Error),
+    /// The running CLI could not be polled or reaped.
+    #[error("the claude CLI could not be supervised")]
+    Supervise(#[source] io::Error),
+    /// The CLI could not be killed and may still be running: abort the job rather than retry.
+    #[error("the claude CLI could not be killed")]
+    Kill(#[source] io::Error),
+}
+
+impl ClaudeHeadless {
+    /// A runner that starts `program` (the pinned `claude` binary) in `workdir` with `env`, and
+    /// caps each transcript at 32 MiB.
+    #[must_use]
+    pub fn new(program: impl Into<PathBuf>, workdir: Workdir, env: HeadlessEnv) -> Self {
+        Self {
+            program: program.into(),
+            workdir,
+            env,
+            max_output_bytes: DEFAULT_MAX_OUTPUT_BYTES,
+        }
+    }
+
+    /// This runner with each transcript capped at `bytes`.
+    #[must_use]
+    pub fn with_max_output_bytes(self, bytes: u64) -> Self {
+        Self {
+            max_output_bytes: bytes,
+            ..self
+        }
+    }
+
+    fn command(&self, call: &ModelCall) -> Command {
+        let mut command = Command::new(&self.program);
+        command
+            .arg("-p")
+            .arg(call.user_prompt.as_str())
+            .args(["--output-format", "stream-json", "--verbose"])
+            .arg("--json-schema")
+            .arg(&call.json_schema)
+            .arg("--append-system-prompt-file")
+            .arg(&call.system_prompt_file)
+            .arg("--exclude-dynamic-system-prompt-sections")
+            .args(["--restricted", "--safe-mode"])
+            .args(["--settings", SETTINGS])
+            .args(["--tools", TOOLS])
+            .arg("--add-dir")
+            .arg(&call.add_dir)
+            .args(["--permission-mode", "dontAsk"])
+            .arg("--max-turns")
+            .arg(call.max_turns.to_string())
+            .arg("--max-budget-usd")
+            .arg(call.budget.to_string())
+            .current_dir(self.workdir.path());
+        self.env.apply(&mut command);
+        command
+    }
+}
+
+impl ModelRunner for ClaudeHeadless {
+    type Error = HeadlessError;
+
+    /// Runs `call` once under the headless profile.
+    ///
+    /// # Errors
+    /// Returns [`HeadlessError`] when a path in `call` is relative, the working directory is not
+    /// empty, or the CLI could not be started, supervised or killed.
+    fn run(&self, call: &ModelCall) -> Result<ModelResult, HeadlessError> {
+        for path in [&call.system_prompt_file, &call.add_dir] {
+            if !path.is_absolute() {
+                return Err(HeadlessError::RelativePath { path: path.clone() });
+            }
+        }
+        self.workdir.ensure_empty()?;
+        let captured = supervise::run(self.command(call), call.timeout, self.max_output_bytes)?;
+        Ok(stream::classify(
+            &captured.transcript,
+            captured.ending,
+            call.budget,
+        ))
+    }
+}
diff --git a/crates/assay-runner/src/headless/env.rs b/crates/assay-runner/src/headless/env.rs
new file mode 100644
index 0000000..e4e1c78
--- /dev/null
+++ b/crates/assay-runner/src/headless/env.rs
@@ -0,0 +1,121 @@
+//! The environment of a headless call (03 §8): cleared, then the OAuth token, the subprocess
+//! scrub flag and the variables the composition root passes on purpose.
+
+use std::ffi::OsString;
+use std::fmt;
+use std::process::Command;
+
+/// The variable carrying the OAuth token.
+const OAUTH_TOKEN: &str = "CLAUDE_CODE_OAUTH_TOKEN";
+
+/// The variable that scrubs credentials from the CLI's subprocesses (03 §8: moot with no
+/// process-spawning tool, kept as belt and braces).
+const SUBPROCESS_ENV_SCRUB: &str = "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB";
+
+/// Prefixes of variables that select another credential or provider: API keys and auth tokens,
+/// and the Bedrock, Vertex and Foundry switches with their cloud credentials (03 §8: unset).
+const RESERVED_PREFIXES: [&str; 6] = [
+    "ANTHROPIC_",
+    "CLAUDE_CODE_USE_",
+    "AWS_",
+    "GOOGLE_",
+    "CLOUD_ML_",
+    "VERTEX_",
+];
+
+/// The environment a `claude -p` call starts with; nothing is inherited.
+///
+/// The call sees the OAuth token, `CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=1` and the variables passed
+/// with [`pass`](Self::pass) (such as `HOME` and `PATH`), and nothing else. API keys, auth tokens
+/// and cloud-provider variables cannot be passed, so they are unset by construction.
+///
+/// `Debug` shows variable names only: the token and the values may be secrets.
+#[derive(Clone)]
+pub struct HeadlessEnv {
+    oauth_token: String,
+    passed: Vec<(String, OsString)>,
+}
+
+/// Why a variable cannot be passed to a headless call.
+#[derive(Debug, Clone, PartialEq, Eq, thiserror::Error)]
+pub enum EnvVarError {
+    /// The name is not a plain identifier (`[A-Za-z_][A-Za-z0-9_]*`).
+    #[error("{name:?} is not a valid environment variable name")]
+    InvalidName {
+        /// The rejected name.
+        name: String,
+    },
+    /// The name is set by the runner itself, or selects another credential or provider.
+    #[error("{name} is reserved by the headless profile")]
+    Reserved {
+        /// The rejected name.
+        name: String,
+    },
+}
+
+impl HeadlessEnv {
+    /// An environment holding only `oauth_token` (and the scrub flag).
+    #[must_use]
+    pub fn new(oauth_token: impl Into<String>) -> Self {
+        Self {
+            oauth_token: oauth_token.into(),
+            passed: Vec::new(),
+        }
+    }
+
+    /// Passes `name=value` to every call. A later value for the same name replaces the earlier.
+    ///
+    /// # Errors
+    /// Returns [`EnvVarError::InvalidName`] for a name that is not a plain identifier, and
+    /// [`EnvVarError::Reserved`] for the token, the scrub flag, and any `ANTHROPIC_`,
+    /// `CLAUDE_CODE_USE_`, `AWS_`, `GOOGLE_`, `CLOUD_ML_` or `VERTEX_` variable. The value is
+    /// dropped, never echoed back.
+    pub fn pass(&mut self, name: &str, value: impl Into<OsString>) -> Result<(), EnvVarError> {
+        if !is_identifier(name) {
+            return Err(EnvVarError::InvalidName {
+                name: name.to_owned(),
+            });
+        }
+        let reserved = name == OAUTH_TOKEN
+            || name == SUBPROCESS_ENV_SCRUB
+            || RESERVED_PREFIXES
+                .iter()
+                .any(|prefix| name.starts_with(prefix));
+        if reserved {
+            return Err(EnvVarError::Reserved {
+                name: name.to_owned(),
+            });
+        }
+        self.passed.push((name.to_owned(), value.into()));
+        Ok(())
+    }
+
+    /// Replaces `command`'s environment with this one.
+    pub(super) fn apply(&self, command: &mut Command) {
+        command
+            .env_clear()
+            .envs(self.passed.iter().map(|(name, value)| (name, value)))
+            .env(OAUTH_TOKEN, &self.oauth_token)
+            .env(SUBPROCESS_ENV_SCRUB, "1");
+    }
+}
+
+impl fmt::Debug for HeadlessEnv {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("HeadlessEnv")
+            .field(
+                "passed",
+                &self.passed.iter().map(|(name, _)| name).collect::<Vec<_>>(),
+            )
+            .finish_non_exhaustive()
+    }
+}
+
+/// `[A-Za-z_][A-Za-z0-9_]*`.
+fn is_identifier(name: &str) -> bool {
+    let mut bytes = name.bytes();
+    bytes
+        .next()
+        .is_some_and(|first| first.is_ascii_alphabetic() || first == b'_')
+        && bytes.all(|byte| byte.is_ascii_alphanumeric() || byte == b'_')
+}
diff --git a/crates/assay-runner/src/headless/supervise.rs b/crates/assay-runner/src/headless/supervise.rs
new file mode 100644
index 0000000..39a6769
--- /dev/null
+++ b/crates/assay-runner/src/headless/supervise.rs
@@ -0,0 +1,119 @@
+//! A bounded `claude` process: a wall-clock deadline, a capped transcript, and a child that is
+//! killed and waited on rather than left behind (H-13).
+//!
+//! stdout goes to an anonymous temporary file, not a pipe, so no reader can block; stdin and
+//! stderr are closed. The calling thread polls the child and the size of its output against one
+//! deadline. Past the deadline or the cap, the child is killed and reaped.
+//!
+//! The child leads its own process group, but only the child itself is killed: the group killer
+//! that also stops descendants lives in `assay-forge`, which this crate may not depend on
+//! (ADR-07). With no process-spawning tool (`--tools Read,Grep,Glob`, `--restricted`) the CLI's
+//! only descendants are its own helpers, which exit once the CLI is gone.
+
+use std::fs::File;
+use std::io::{self, Read, Seek, SeekFrom};
+use std::os::unix::process::CommandExt;
+use std::process::{Child, Command, Stdio};
+use std::thread;
+use std::time::{Duration, Instant};
+
+use super::HeadlessError;
+use crate::stream::Ending;
+
+/// How often the child and its output are checked.
+const POLL_INTERVAL: Duration = Duration::from_millis(10);
+
+/// A finished call: how it stopped and what it wrote (at most the cap).
+#[derive(Debug)]
+pub(super) struct Captured {
+    pub(super) ending: Ending,
+    pub(super) transcript: Vec<u8>,
+}
+
+/// Why polling stopped.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Watched {
+    /// The child exited and was reaped.
+    Exited,
+    /// The child must be killed.
+    Stop(Ending),
+}
+
+/// Runs `command` until it exits, `timeout` passes or its stdout passes `cap` bytes.
+pub(super) fn run(
+    mut command: Command,
+    timeout: Duration,
+    cap: u64,
+) -> Result<Captured, HeadlessError> {
+    let deadline = Instant::now()
+        .checked_add(timeout)
+        .ok_or(HeadlessError::TimeoutTooLong { timeout })?;
+    let mut stdout = tempfile::tempfile().map_err(HeadlessError::Spool)?;
+    let child_end = stdout.try_clone().map_err(HeadlessError::Spool)?;
+    command
+        .stdin(Stdio::null())
+        .stdout(child_end)
+        .stderr(Stdio::null())
+        .process_group(0);
+    let mut child = command.spawn().map_err(HeadlessError::Spawn)?;
+    // Closes this process's copy of the child's stdout.
+    drop(command);
+
+    let ending = match watch(&mut child, &stdout, cap, deadline) {
+        Ok(Watched::Exited) => {
+            if size(&stdout).map_err(HeadlessError::Supervise)? > cap {
+                Ending::OutputCapped
+            } else {
+                Ending::Exited
+            }
+        }
+        Ok(Watched::Stop(ending)) => {
+            stop(&mut child)?;
+            ending
+        }
+        Err(source) => {
+            // A failed kill outranks the polling failure: the CLI may still be running.
+            stop(&mut child)?;
+            return Err(HeadlessError::Supervise(source));
+        }
+    };
+    let transcript = read_capped(&mut stdout, cap).map_err(HeadlessError::Spool)?;
+    Ok(Captured { ending, transcript })
+}
+
+/// Polls until the child exits, its output passes `cap`, or `deadline` passes.
+fn watch(child: &mut Child, stdout: &File, cap: u64, deadline: Instant) -> io::Result<Watched> {
+    loop {
+        if size(stdout)? > cap {
+            return Ok(Watched::Stop(Ending::OutputCapped));
+        }
+        if child.try_wait()?.is_some() {
+            return Ok(Watched::Exited);
+        }
+        let left = deadline.saturating_duration_since(Instant::now());
+        if left.is_zero() {
+            return Ok(Watched::Stop(Ending::TimedOut));
+        }
+        thread::sleep(left.min(POLL_INTERVAL));
+    }
+}
+
+/// Kills the child and reaps it. When the kill fails the child is not waited on, since the wait
+/// could be unbounded; the error says it may still be running.
+fn stop(child: &mut Child) -> Result<(), HeadlessError> {
+    child.kill().map_err(HeadlessError::Kill)?;
+    child.wait().map_err(HeadlessError::Supervise)?;
+    Ok(())
+}
+
+fn size(file: &File) -> io::Result<u64> {
+    Ok(file.metadata()?.len())
+}
+
+/// The first `cap` bytes of `file`.
+fn read_capped(file: &mut File, cap: u64) -> io::Result<Vec<u8>> {
+    file.seek(SeekFrom::Start(0))?;
+    let mut transcript = Vec::new();
+    file.take(cap).read_to_end(&mut transcript)?;
+    Ok(transcript)
+}
