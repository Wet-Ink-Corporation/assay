+//! The `plan` use case (S1, `docs/architecture/04-pipeline.md` §2): the run description
+//! `assay.run/1` (`docs/architecture/03-contracts.md` §4) of one PR head.
+//!
+//! It reads base `.assay/` at the pinned `base_sha`, never at head; lists the changed files
+//! with git over `base_sha...head_sha` and asserts them against GitHub's REST list; tiers the
+//! change; names each job's artifact with its own nonce; and validates the document before
+//! returning it. It has no ledger port: `admit` owns the ledger. Anything it cannot read or
+//! reconcile is refused, loudly, rather than modelled (wi-b5affa).
+
+mod base_config;
+mod changes;
+mod document;
+mod nonce;
+mod objects;
+mod rest;
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::num::NonZeroU64;
+
+use assay_domain::{ContentHash, RunUid, Tiering, tier};
+use thiserror::Error;
+
+pub use self::base_config::BaseConfigError;
+pub use self::document::{ArtifactJob, EvidenceKey};
+pub use self::nonce::{ArtifactNonce, NonceSource, ParseNonceError};
+pub use self::objects::{ChangedFiles, EntryKind, PullRequestObjects, TreeEntry};
+pub use self::rest::{FileListError, REST_FILE_CAP, RestFile, RestFiles};
+use crate::config::CommitId;
+use crate::contract::{Contract, ContractValidator, ReadContractError};
+use crate::tiering::PackageSet;
+
+/// The PR as the triggering event names it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct PullRequestEvent {
+    /// The repository, `owner/name`.
+    pub repo: String,
+    /// The PR number.
+    pub number: NonZeroU64,
+    /// The base commit the run is pinned to; base config is read here.
+    pub base_sha: CommitId,
+    /// The head commit the run is pinned to.
+    pub head_sha: CommitId,
+    /// The base branch, which `decide` re-fetches (R3-03).
+    pub base_ref: String,
+    /// Whether the PR is a draft: gates only (04 §2.4).
+    pub draft: bool,
+}
+
+/// Which files `.rs` sources read at compile time (#64's `syn` scan).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum IncludeTargets {
+    /// The scan ran: these canonical repo-relative paths, at base or head.
+    Scanned(Vec<String>),
+    /// No scan ran: every changed path may be a target, so no change is `trivial`.
+    NotScanned,
+}
+
+/// Everything `plan` is given besides the PR's objects.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct PlanRequest {
+    /// The PR and its pinned commits.
+    pub pull_request: PullRequestEvent,
+    /// This workflow run; it keys leases and ledger records, never evidence reuse.
+    pub run_uid: RunUid,
+    /// GitHub's list of the PR's files, which git's must match.
+    pub rest_files: RestFiles,
+    /// The base commit's package set (#65); `None` when it could not be computed, which is
+    /// exec surface.
+    pub base_packages: Option<PackageSet>,
+    /// The head commit's package set; `None` as for the base.
+    pub head_packages: Option<PackageSet>,
+    /// The compile-time include targets.
+    pub include_targets: IncludeTargets,
+    /// The reviewer prompt bundle's hash (04 §3), part of the evidence key.
+    pub prompt_bundle: ContentHash,
+}
+
+/// A validated `assay.run/1` document and what it was computed from.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct PlannedRun {
+    json: Vec<u8>,
+    run_key: EvidenceKey,
+    tiering: Tiering,
+    artifact_names: BTreeMap<ArtifactJob, String>,
+}
+
+impl PlannedRun {
+    /// The document, exactly as validated against `run-1.schema.json`.
+    #[must_use]
+    pub fn json(&self) -> &[u8] {
+        &self.json
+    }
+
+    /// The evidence key the document carries as `run_key`: for evidence reuse only.
+    #[must_use]
+    pub const fn run_key(&self) -> EvidenceKey {
+        self.run_key
+    }
+
+    /// The tiering the document records.
+    #[must_use]
+    pub const fn tiering(&self) -> &Tiering {
+        &self.tiering
+    }
+
+    /// Each job's artifact name.
+    #[must_use]
+    pub const fn artifact_names(&self) -> &BTreeMap<ArtifactJob, String> {
+        &self.artifact_names
+    }
+}
+
+/// Why no run description was written. Every variant fails the run.
+#[derive(Debug, Error)]
+pub enum PlanError<O, N> {
+    /// The PR's objects could not be read.
+    #[error("could not read the pull request's objects")]
+    Objects(#[source] O),
+    /// The objects port returned a different number of blobs than entries asked for.
+    #[error("asked for {asked} blobs, read {returned}")]
+    ShortRead {
+        /// Entries asked for.
+        asked: usize,
+        /// Blobs returned.
+        returned: usize,
+    },
+    /// git did not list the changed files within its cap: there is no file list to plan, and
+    /// the PR needs a split.
+    #[error("git did not list the changed files within its cap; the PR needs a split")]
+    DiffTooSlow,
+    /// The git and REST file lists disagree, or the REST list is not usable.
+    #[error("the PR's file list could not be confirmed")]
+    FileList(#[source] FileListError),
+    /// Base `.assay/` was refused.
+    #[error("the base configuration was refused")]
+    BaseConfig(#[source] BaseConfigError),
+    /// No nonce could be drawn.
+    #[error("could not draw an artifact nonce")]
+    Nonce(#[source] N),
+    /// The nonce source repeated itself, so artifact names would not be unpredictable.
+    #[error("the nonce source repeated a nonce, for the {} artifact", job.name())]
+    RepeatedNonce {
+        /// The job whose nonce was a repeat.
+        job: ArtifactJob,
+    },
+    /// The document could not be encoded.
+    #[error("could not encode the run description")]
+    Encode(#[source] serde_json::Error),
+    /// The document failed its own schema: a defect in `plan`, never written out.
+    #[error("the run description failed its schema")]
+    Invalid(#[source] ReadContractError),
+}
+
+/// Plans one PR head: `request`'s PR read through `objects`, artifact nonces from `nonces`,
+/// and the document checked by `validator` before it is returned.
+///
+/// # Examples
+///
+/// ```
+/// use assay_app::{
+///     ContractValidator, NonceSource, PlanError, PlanRequest, PullRequestObjects, plan,
+/// };
+///
+/// # fn demo<O: PullRequestObjects, N: NonceSource>(
+/// #     request: &PlanRequest,
+/// #     objects: &O,
+/// #     nonces: &mut N,
+/// #     validator: &ContractValidator,
+/// # ) -> Result<(), PlanError<O::Error, N::Error>> {
+/// let run = plan(request, objects, nonces, validator)?;
+/// // The bytes to upload as the `plan` artifact; its digest goes in the job's outputs.
+/// let document: &[u8] = run.json();
+/// # Ok(())
+/// # }
+/// ```
+///
+/// # Errors
+///
+/// [`PlanError`]: the objects could not be read ([`PlanError::Objects`],
+/// [`PlanError::ShortRead`]), git ran past its cap ([`PlanError::DiffTooSlow`]), the file lists
+/// disagree ([`PlanError::FileList`]), base `.assay/` was refused ([`PlanError::BaseConfig`]),
+/// no fresh nonce could be drawn ([`PlanError::Nonce`], [`PlanError::RepeatedNonce`]), or the
+/// document could not be written valid ([`PlanError::Encode`], [`PlanError::Invalid`]).
+pub fn plan<O: PullRequestObjects, N: NonceSource>(
+    request: &PlanRequest,
+    objects: &O,
+    nonces: &mut N,
+    validator: &ContractValidator,
+) -> Result<PlannedRun, PlanError<O::Error, N::Error>> {
+    let pull_request = &request.pull_request;
+    let files = match objects
+        .changed_files(&pull_request.base_sha, &pull_request.head_sha)
+        .map_err(PlanError::Objects)?
+    {
+        ChangedFiles::Listed(files) => files,
+        ChangedFiles::TooSlow => return Err(PlanError::DiffTooSlow),
+    };
+    rest::check(&request.rest_files, &files).map_err(PlanError::FileList)?;
+    let config = base_config::read(objects, &pull_request.base_sha)?;
+    let change_set = changes::change_set(objects, request, files)?;
+    let tiering = tier(&config.globs, &change_set);
+    let artifact_names = artifact_names(nonces)?;
+    let run_key = EvidenceKey::new(pull_request, &config, request.prompt_bundle);
+    let json = document::to_json(&document::Inputs {
+        pull_request,
+        run_uid: request.run_uid,
+        run_key,
+        config: &config,
+        tiering: &tiering,
+        files: &change_set.files,
+        artifact_names: &artifact_names,
+    })
+    .map_err(PlanError::Encode)?;
+    validator
+        .read(Contract::Run, &json)
+        .map_err(PlanError::Invalid)?;
+    Ok(PlannedRun {
+        json,
+        run_key,
+        tiering,
+        artifact_names,
+    })
+}
+
+/// One fresh nonce per job, named `assay-<job>-<nonce>`.
+fn artifact_names<N: NonceSource, O>(
+    nonces: &mut N,
+) -> Result<BTreeMap<ArtifactJob, String>, PlanError<O, N::Error>> {
+    let mut seen = BTreeSet::new();
+    let mut names = BTreeMap::new();
+    for job in ArtifactJob::ALL {
+        let nonce = nonces.nonce().map_err(PlanError::Nonce)?;
+        let name = format!("assay-{}-{nonce}", job.name());
+        if !seen.insert(nonce) {
+            return Err(PlanError::RepeatedNonce { job });
+        }
+        names.insert(job, name);
+    }
+    Ok(names)
+}
+
+/// Reads `entries` through `objects`, refusing a reply that is not one blob per entry.
+fn read_entries<O: PullRequestObjects, N>(
+    objects: &O,
+    entries: &[&TreeEntry],
+) -> Result<Vec<Vec<u8>>, PlanError<O::Error, N>> {
+    if entries.is_empty() {
+        return Ok(Vec::new());
+    }
+    let blobs = objects.read(entries).map_err(PlanError::Objects)?;
+    if blobs.len() == entries.len() {
+        Ok(blobs)
+    } else {
+        Err(PlanError::ShortRead {
+            asked: entries.len(),
+            returned: blobs.len(),
+        })
+    }
+}
diff --git a/crates/assay-app/src/plan/base_config.rs b/crates/assay-app/src/plan/base_config.rs
new file mode 100644
index 0000000..9643682
--- /dev/null
+++ b/crates/assay-app/src/plan/base_config.rs
@@ -0,0 +1,109 @@
+//! Base `.assay/`, read at the pinned `base_sha` and never at head
+//! (`docs/architecture/03-contracts.md` §1): what a PR changes in it applies from the next PR.
+
+use assay_domain::{ContentHash, RepoGlobs};
+use thiserror::Error;
+
+use super::objects::{EntryKind, PullRequestObjects};
+use super::{PlanError, read_entries};
+use crate::config::{CommitId, ConfigError, GlobsConfigError, PluginsConfig, parse_globs};
+
+/// The base configuration directory.
+const CONFIG_DIR: &str = ".assay";
+/// The gates and repository settings; required.
+const PLUGINS: &str = ".assay/plugins.toml";
+/// The repository's glob additions; optional, and absent adds nothing.
+const GLOBS: &str = ".assay/globs.toml";
+
+/// Why the base configuration was refused. It comes from the protected base, so messages may
+/// name its paths.
+#[derive(Debug, Error)]
+pub enum BaseConfigError {
+    /// The base has no `.assay/plugins.toml`: no gate is known, so nothing can be planned.
+    #[error("the base has no {PLUGINS}")]
+    Missing,
+    /// An entry under `.assay/` is a symlink or submodule, which is refused rather than
+    /// followed (wi-b5affa).
+    #[error("{path} in the base is a {kind:?}, not a regular file")]
+    NotARegularFile {
+        /// The entry's path.
+        path: String,
+        /// What it is.
+        kind: EntryKind,
+    },
+    /// A file `plan` parses is not UTF-8.
+    #[error("{path} in the base is not UTF-8")]
+    NotUtf8 {
+        /// The file's path.
+        path: String,
+    },
+    /// `.assay/plugins.toml` was refused.
+    #[error("{PLUGINS} in the base was refused")]
+    Plugins(#[source] ConfigError),
+    /// `.assay/globs.toml` was refused.
+    #[error("{GLOBS} in the base was refused")]
+    Globs(#[source] GlobsConfigError),
+}
+
+/// What `plan` takes from base `.assay/`.
+#[derive(Debug)]
+pub(super) struct BaseConfig {
+    pub(super) plugins: PluginsConfig,
+    pub(super) globs: RepoGlobs,
+    /// Every file under `.assay/`, path and bytes in path order: the evidence key's
+    /// `config_hash` (02 §3), so any base config change makes evidence stale.
+    pub(super) hash: ContentHash,
+}
+
+/// Reads every file under `.assay/` at `base`, refusing any entry that is not a regular file,
+/// and parses `plugins.toml` and `globs.toml`.
+pub(super) fn read<O: PullRequestObjects, N>(
+    objects: &O,
+    base: &CommitId,
+) -> Result<BaseConfig, PlanError<O::Error, N>> {
+    let entries = objects
+        .list(base, Some(CONFIG_DIR))
+        .map_err(PlanError::Objects)?;
+    if let Some(entry) = entries.iter().find(|entry| entry.kind != EntryKind::File) {
+        return Err(PlanError::BaseConfig(BaseConfigError::NotARegularFile {
+            // The error owns the path it names.
+            path: entry.path.clone(),
+            kind: entry.kind,
+        }));
+    }
+    let borrowed: Vec<_> = entries.iter().collect();
+    let blobs = read_entries(objects, &borrowed)?;
+    let files: Vec<(&str, &[u8])> = entries
+        .iter()
+        .map(|entry| entry.path.as_str())
+        .zip(blobs.iter().map(Vec::as_slice))
+        .collect();
+    let text = |wanted: &str| -> Result<Option<&str>, BaseConfigError> {
+        files
+            .iter()
+            .find(|(path, _)| *path == wanted)
+            .map(|(path, bytes)| {
+                str::from_utf8(bytes).map_err(|_not_utf8| BaseConfigError::NotUtf8 {
+                    path: (*path).to_owned(),
+                })
+            })
+            .transpose()
+    };
+    let plugins = text(PLUGINS)
+        .map_err(PlanError::BaseConfig)?
+        .ok_or(PlanError::BaseConfig(BaseConfigError::Missing))?
+        .parse()
+        .map_err(|source| PlanError::BaseConfig(BaseConfigError::Plugins(source)))?;
+    let globs = text(GLOBS)
+        .map_err(PlanError::BaseConfig)?
+        .map(parse_globs)
+        .transpose()
+        .map_err(|source| PlanError::BaseConfig(BaseConfigError::Globs(source)))?
+        // No `globs.toml` adds nothing to the shipped lists (03 §1).
+        .unwrap_or_default();
+    Ok(BaseConfig {
+        plugins,
+        globs,
+        hash: ContentHash::of_files(files.iter().copied()),
+    })
+}
diff --git a/crates/assay-app/src/plan/changes.rs b/crates/assay-app/src/plan/changes.rs
new file mode 100644
index 0000000..a398dcb
--- /dev/null
+++ b/crates/assay-app/src/plan/changes.rs
@@ -0,0 +1,153 @@
+//! The tiering inputs of one PR (`docs/architecture/04-pipeline.md` §2.2): manifests and the
+//! temper baseline read at both SHAs, and the exec surface from the package sets.
+
+use std::collections::{BTreeMap, BTreeSet};
+
+use assay_domain::{BaselineChange, ChangeSet, FileChange, ManifestTrustChange};
+
+use super::objects::{EntryKind, PullRequestObjects};
+use super::{IncludeTargets, PlanError, PlanRequest, read_entries};
+use crate::config::CommitId;
+use crate::tiering::{baseline_change, exec_surface, manifest_exec_roots, manifest_trust_keys};
+
+/// TOML that never parses: what a manifest reads as when it is a symlink, a submodule or not
+/// UTF-8, so it gets exactly the fail-closed treatment of an unparseable one (cargo would
+/// follow the symlink or refuse the file; `plan` does neither).
+const UNREADABLE_MANIFEST: &str = "[";
+
+/// The temper ratchet file (04 §2.2).
+const TEMPER_BASELINE: &str = ".claude/temper-baseline.json";
+
+/// Manifest texts by path at one commit.
+type Manifests = BTreeMap<String, String>;
+
+/// The tiering input for `files`: trust keys of every changed manifest, the exec roots of
+/// every manifest at either commit with the package-set diff, the include targets and the
+/// temper baseline's change.
+pub(super) fn change_set<O: PullRequestObjects, N>(
+    objects: &O,
+    request: &PlanRequest,
+    files: Vec<FileChange>,
+) -> Result<ChangeSet, PlanError<O::Error, N>> {
+    let pull_request = &request.pull_request;
+    let base = manifests(objects, &pull_request.base_sha)?;
+    let head = manifests(objects, &pull_request.head_sha)?;
+    let paths: BTreeSet<&str> = base.keys().chain(head.keys()).map(String::as_str).collect();
+    let declared: Vec<_> = paths
+        .iter()
+        .flat_map(|path| manifest_exec_roots(path, text(&base, path), text(&head, path)))
+        .collect();
+    let surface = exec_surface(
+        request.base_packages.as_ref(),
+        request.head_packages.as_ref(),
+        &declared,
+    );
+
+    let changed: BTreeSet<&str> = files.iter().flat_map(FileChange::sides).collect();
+    let manifest_changes = changed
+        .iter()
+        .filter(|path| is_manifest(path))
+        .flat_map(|path| {
+            manifest_trust_keys(text(&base, path), text(&head, path))
+                .into_iter()
+                .map(|key| ManifestTrustChange {
+                    path: (*path).to_owned(),
+                    key,
+                })
+        })
+        .collect();
+    let include_targets = match &request.include_targets {
+        // The change set owns its targets; the request keeps its own.
+        IncludeTargets::Scanned(targets) => targets.clone(),
+        IncludeTargets::NotScanned => changed.iter().map(|path| (*path).to_owned()).collect(),
+    };
+    let temper_baseline = if changed.contains(TEMPER_BASELINE) {
+        baseline(objects, request)?
+    } else {
+        BaselineChange::Other
+    };
+    Ok(ChangeSet {
+        files,
+        manifests: manifest_changes,
+        include_targets,
+        exec_roots: surface.exec_roots,
+        packages: surface.packages,
+        temper_baseline,
+    })
+}
+
+/// The text of the manifest at `path` on one side; `None` where there is none.
+fn text<'a>(side: &'a Manifests, path: &str) -> Option<&'a str> {
+    side.get(path).map(String::as_str)
+}
+
+/// Whether `path` names a cargo manifest, ignoring ASCII case (fail closed: a `cargo.toml`
+/// is read as one too).
+fn is_manifest(path: &str) -> bool {
+    path.rsplit('/')
+        .next()
+        .is_some_and(|name| name.eq_ignore_ascii_case("Cargo.toml"))
+}
+
+/// Every manifest in `commit`'s tree, by path.
+fn manifests<O: PullRequestObjects, N>(
+    objects: &O,
+    commit: &CommitId,
+) -> Result<Manifests, PlanError<O::Error, N>> {
+    let mut found = objects.list(commit, None).map_err(PlanError::Objects)?;
+    found.retain(|entry| is_manifest(&entry.path));
+    let readable: Vec<_> = found
+        .iter()
+        .filter(|entry| entry.kind == EntryKind::File)
+        .collect();
+    let mut blobs = read_entries(objects, &readable)?.into_iter();
+    Ok(found
+        .into_iter()
+        .map(|entry| {
+            let text = if entry.kind == EntryKind::File {
+                blobs.next().and_then(utf8)
+            } else {
+                None
+            };
+            let text = text.unwrap_or_else(|| UNREADABLE_MANIFEST.to_owned());
+            (entry.path, text)
+        })
+        .collect())
+}
+
+/// `bytes` as text, or `None` when they are not UTF-8: the caller reads that as unreadable,
+/// never as an absent file.
+fn utf8(bytes: Vec<u8>) -> Option<String> {
+    String::from_utf8(bytes).ok()
+}
+
+/// How the temper baseline changed between the base and head commits.
+fn baseline<O: PullRequestObjects, N>(
+    objects: &O,
+    request: &PlanRequest,
+) -> Result<BaselineChange, PlanError<O::Error, N>> {
+    let pull_request = &request.pull_request;
+    let base = file_text(objects, &pull_request.base_sha, TEMPER_BASELINE)?;
+    let head = file_text(objects, &pull_request.head_sha, TEMPER_BASELINE)?;
+    Ok(baseline_change(base.as_deref(), head.as_deref()))
+}
+
+/// The text of the regular file at exactly `path` in `commit`; `None` when there is none, or
+/// it is not a regular UTF-8 file (which `baseline_change` reads as any other change).
+fn file_text<O: PullRequestObjects, N>(
+    objects: &O,
+    commit: &CommitId,
+    path: &str,
+) -> Result<Option<String>, PlanError<O::Error, N>> {
+    let entries = objects
+        .list(commit, Some(path))
+        .map_err(PlanError::Objects)?;
+    let Some(entry) = entries
+        .iter()
+        .find(|entry| entry.path == path && entry.kind == EntryKind::File)
+    else {
+        return Ok(None);
+    };
+    let blob = read_entries(objects, &[entry])?.into_iter().next();
+    Ok(blob.and_then(utf8))
+}
diff --git a/crates/assay-app/src/plan/document.rs b/crates/assay-app/src/plan/document.rs
new file mode 100644
index 0000000..a9b2607
--- /dev/null
+++ b/crates/assay-app/src/plan/document.rs
@@ -0,0 +1,291 @@
+//! The `assay.run/1` document `plan` writes (`docs/architecture/03-contracts.md` §4), the
+//! evidence key it carries as `run_key`, and the per-job artifact names.
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::fmt;
+
+use assay_domain::{
+    ContentHash, FileChange, PrClass, RequiredRole, RunUid, Tier, TierReason, Tiering,
+};
+use serde::Serialize;
+
+use super::PullRequestEvent;
+use super::base_config::BaseConfig;
+use crate::config::{Adapter, Plugin};
+
+/// The contract and version `plan` writes.
+const SCHEMA: &str = "assay.run/1";
+
+/// The evidence key (`docs/architecture/02-architecture.md` §3), for evidence reuse only.
+///
+/// It identifies a run's expensive evidence, gates and model output. A requeue, a retry and
+/// a same-head run share it, so it never keys a lease, a ledger record or the pending stamp;
+/// `run_uid` does (R3-16).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub struct EvidenceKey(ContentHash);
+
+impl fmt::Display for EvidenceKey {
+    /// `sha256:` and 64 lowercase hex digits.
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        self.0.fmt(f)
+    }
+}
+
+impl EvidenceKey {
+    /// SHA-256 over the 02 §3 fields in order, each a length-prefixed name and value:
+    /// `repo`, `pr`, `head_sha`, `base_sha`, `config_hash`, `assay_digest`,
+    /// `claude_cli_version` (empty when unpinned), `prompt_bundle_hash` and `tool_pins` (one
+    /// `<plugin>=<pin>` line per built-in gate, in file order).
+    pub(super) fn new(
+        pull_request: &PullRequestEvent,
+        config: &BaseConfig,
+        prompt_bundle: ContentHash,
+    ) -> Self {
+        let assay = config.plugins.assay();
+        let pins: String = config
+            .plugins
+            .plugins()
+            .iter()
+            .filter_map(|plugin| pin(plugin).map(|pin| format!("{}={pin}\n", plugin.name())))
+            .collect();
+        let pr = pull_request.number.to_string();
+        let config_hash = config.hash.to_string();
+        let prompt_bundle = prompt_bundle.to_string();
+        let fields: [(&str, &str); 9] = [
+            ("repo", &pull_request.repo),
+            ("pr", &pr),
+            ("head_sha", pull_request.head_sha.as_str()),
+            ("base_sha", pull_request.base_sha.as_str()),
+            ("config_hash", &config_hash),
+            ("assay_digest", assay.digest.as_str()),
+            (
+                "claude_cli_version",
+                assay
+                    .claude_cli
+                    .as_ref()
+                    .map_or("", |version| version.as_str()),
+            ),
+            ("prompt_bundle_hash", &prompt_bundle),
+            ("tool_pins", &pins),
+        ];
+        Self(ContentHash::of_files(
+            fields
+                .into_iter()
+                .map(|(name, value)| (name, value.as_bytes())),
+        ))
+    }
+}
+
+/// A job whose artifact another job of the run consumes, each named with its own nonce
+/// (`docs/architecture/02-architecture.md` §1).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord)]
+pub enum ArtifactJob {
+    /// `plan`: this run description.
+    Plan,
+    /// `gates-static`: the Z2s gate documents.
+    GatesStatic,
+    /// `gates-lint`: the Z2b lint gate documents.
+    GatesLint,
+    /// `gates-test`: the Z2b test gate documents.
+    GatesTest,
+    /// `admit`: the context pack.
+    Admit,
+    /// `review`: the reviewers' findings.
+    Review,
+    /// `decide`: the persisted input bundle.
+    Decide,
+}
+
+impl ArtifactJob {
+    /// Every job, in pipeline order.
+    pub const ALL: [Self; 7] = [
+        Self::Plan,
+        Self::GatesStatic,
+        Self::GatesLint,
+        Self::GatesTest,
+        Self::Admit,
+        Self::Review,
+        Self::Decide,
+    ];
+
+    /// The job's name in the workflow, and its key in `artifact_names`.
+    #[must_use]
+    pub const fn name(self) -> &'static str {
+        match self {
+            Self::Plan => "plan",
+            Self::GatesStatic => "gates-static",
+            Self::GatesLint => "gates-lint",
+            Self::GatesTest => "gates-test",
+            Self::Admit => "admit",
+            Self::Review => "review",
+            Self::Decide => "decide",
+        }
+    }
+}
+
+/// The pin of a built-in gate; `None` for `exec`, which runs PR-controlled code and has none.
+fn pin(plugin: &Plugin) -> Option<String> {
+    match plugin.adapter() {
+        Adapter::Temper { pin, .. } | Adapter::WeighIn { pin } => Some(pin.to_string()),
+        Adapter::Exec { .. } => None,
+    }
+}
+
+/// Everything the document is written from.
+pub(super) struct Inputs<'a> {
+    pub(super) pull_request: &'a PullRequestEvent,
+    pub(super) run_uid: RunUid,
+    pub(super) run_key: EvidenceKey,
+    pub(super) config: &'a BaseConfig,
+    pub(super) tiering: &'a Tiering,
+    /// The changed files tiered.
+    pub(super) files: &'a [FileChange],
+    pub(super) artifact_names: &'a BTreeMap<ArtifactJob, String>,
+}
+
+/// `assay.run/1` as `plan` writes it: no `budget`, which `admit` adds.
+#[derive(Debug, Serialize)]
+struct RunDocument<'a> {
+    schema: &'static str,
+    run_key: String,
+    run_uid: RunUid,
+    repo: &'a str,
+    pr: u64,
+    base_sha: &'a str,
+    head_sha: &'a str,
+    base_ref: &'a str,
+    tier: Tier,
+    tier_reasons: &'a [TierReason],
+    classes: &'a [PrClass],
+    roles: &'a [RequiredRole],
+    required_roles: &'a [RequiredRole],
+    shards: Vec<Shard<'a>>,
+    plugins: Vec<PluginEntry<'a>>,
+    trust_paths_changed: &'a [String],
+    exec_surface_changed: &'a [String],
+    filtered_stats: FilteredStats<'a>,
+    artifact_names: BTreeMap<&'static str, &'a str>,
+    draft: bool,
+}
+
+#[derive(Debug, Serialize)]
+struct Shard<'a> {
+    files: Vec<&'a str>,
+}
+
+#[derive(Debug, Serialize)]
+struct PluginEntry<'a> {
+    name: &'a str,
+    required: bool,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pin: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    job: Option<String>,
+    steps: Vec<StepEntry<'a>>,
+}
+
+#[derive(Debug, Serialize)]
+struct StepEntry<'a> {
+    name: &'a str,
+    job: String,
+    timeout_s: u64,
+}
+
+#[derive(Debug, Serialize)]
+struct FilteredStats<'a> {
+    files: usize,
+    lines: u64,
+    excluded: &'a [String],
+}
+
+/// The document as JSON. A draft schedules no reviewer and no shard (04 §2.4: gates only), but
+/// keeps the roles its tier requires, so `decide` knows what review it lacks; otherwise every
+/// file left after filtering is one shard (sharding is #98's).
+pub(super) fn to_json(inputs: &Inputs<'_>) -> Result<Vec<u8>, serde_json::Error> {
+    let Inputs {
+        pull_request,
+        run_uid,
+        run_key,
+        config,
+        tiering,
+        files,
+        artifact_names,
+    } = inputs;
+    let roles: &[RequiredRole] = if pull_request.draft {
+        &[]
+    } else {
+        &tiering.required_roles
+    };
+    let reviewed = reviewed_files(files, &tiering.filtered.excluded);
+    let shards = if roles.is_empty() || reviewed.is_empty() {
+        Vec::new()
+    } else {
+        vec![Shard { files: reviewed }]
+    };
+    let document = RunDocument {
+        schema: SCHEMA,
+        run_key: run_key.to_string(),
+        run_uid: *run_uid,
+        repo: &pull_request.repo,
+        pr: pull_request.number.get(),
+        base_sha: pull_request.base_sha.as_str(),
+        head_sha: pull_request.head_sha.as_str(),
+        base_ref: &pull_request.base_ref,
+        tier: tiering.tier,
+        tier_reasons: &tiering.tier_reasons,
+        classes: &tiering.classes,
+        roles,
+        required_roles: &tiering.required_roles,
+        shards,
+        plugins: config.plugins.plugins().iter().map(plugin_entry).collect(),
+        trust_paths_changed: &tiering.trust_paths_changed,
+        exec_surface_changed: &tiering.exec_surface_changed,
+        filtered_stats: FilteredStats {
+            files: tiering.filtered.files,
+            lines: tiering.filtered.lines,
+            excluded: &tiering.filtered.excluded,
+        },
+        artifact_names: artifact_names
+            .iter()
+            .map(|(job, name)| (job.name(), name.as_str()))
+            .collect(),
+        draft: pull_request.draft,
+    };
+    serde_json::to_vec_pretty(&document)
+}
+
+/// The files the reviewers read: every changed file filtering did not exclude, in change
+/// order.
+fn reviewed_files<'a>(files: &'a [FileChange], excluded: &[String]) -> Vec<&'a str> {
+    let excluded: BTreeSet<&str> = excluded.iter().map(String::as_str).collect();
+    files
+        .iter()
+        .map(|file| file.path.as_str())
+        .filter(|path| !excluded.contains(path))
+        .collect()
+}
+
+fn plugin_entry(plugin: &Plugin) -> PluginEntry<'_> {
+    let (job, steps) = match plugin.adapter() {
+        Adapter::Temper { steps, .. } => (
+            None,
+            steps
+                .iter()
+                .map(|step| StepEntry {
+                    name: step.name().as_str(),
+                    job: step.job().to_string(),
+                    timeout_s: step.timeout().as_secs(),
+                })
+                .collect(),
+        ),
+        Adapter::WeighIn { .. } => (None, Vec::new()),
+        Adapter::Exec { job, .. } => (Some(job.to_string()), Vec::new()),
+    };
+    PluginEntry {
+        name: plugin.name().as_str(),
+        required: plugin.required(),
+        pin: pin(plugin),
+        job,
+        steps,
+    }
+}
