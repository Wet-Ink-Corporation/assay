new file mode 100644
index 0000000..4b04aa3
--- /dev/null
+++ b/crates/assay-app/src/publish/ports.rs
@@ -0,0 +1,281 @@
+//! The ports `decide` publishes through: the verdict check and summary comment on GitHub, the
+//! per-head lock and per-PR state in the ledger, and the run's artifact store (02 §5, 06 §1).
+
+use std::fmt;
+use std::num::NonZeroU64;
+
+use assay_domain::Tier;
+
+use crate::config::{CommitId, Sha256Digest};
+
+/// The verdict check and the summary comment, written with the `assay-verdict` App's token.
+/// Implemented by the forge adapter (#53).
+pub trait VerdictForge {
+    /// Why GitHub could not be read or written.
+    type Error: std::error::Error;
+
+    /// The check run named `name` on `head` that the `assay-verdict` App authored, if any. A
+    /// same-named check from any other app is never returned.
+    ///
+    /// # Errors
+    ///
+    /// [`Self::Error`] when the check runs cannot be listed.
+    fn find_check(
+        &self,
+        head: &CommitId,
+        name: &CheckName,
+    ) -> Result<Option<CheckRun>, Self::Error>;
+
+    /// Overwrites the check's status, conclusion, output and `external_id` with `update`. The
+    /// update carries no annotations, so none ever accumulate on the verdict check (R3-11).
+    ///
+    /// # Errors
+    ///
+    /// [`Self::Error`] when the check cannot be updated.
+    fn update_check(&self, id: CheckRunId, update: &CheckUpdate) -> Result<(), Self::Error>;
+
+    /// The comment on PR `number` that the App authored and whose body contains `marker`, if
+    /// any. A comment by anyone else is never returned, whatever it contains.
+    ///
+    /// # Errors
+    ///
+    /// [`Self::Error`] when the comments cannot be listed.
+    fn find_summary(
+        &self,
+        number: NonZeroU64,
+        marker: &str,
+    ) -> Result<Option<SummaryComment>, Self::Error>;
+
+    /// Posts `body` as a new comment on PR `number`.
+    ///
+    /// # Errors
+    ///
+    /// [`Self::Error`] when the comment cannot be posted.
+    fn create_summary(&self, number: NonZeroU64, body: &str) -> Result<(), Self::Error>;
+
+    /// Replaces the body of comment `id` with `body`.
+    ///
+    /// # Errors
+    ///
+    /// [`Self::Error`] when the comment cannot be edited.
+    fn update_summary(&self, id: CommentId, body: &str) -> Result<(), Self::Error>;
+}
+
+/// The ledger repository, written with the App's ledger installation token. Implemented by the
+/// ledger adapter (#70).
+pub trait PublishLedger {
+    /// Why the ledger could not be read or written.
+    type Error: std::error::Error;
+    /// Proof of holding the per-head lock: what releasing it compares and sets.
+    type Lease;
+
+    /// Takes the per-head publish lock `refs/heads/lock-<repo_id>-<head>` by creating it (2-minute
+    /// TTL). `None` when another writer holds it and the adapter's bounded wait ran out.
+    ///
+    /// # Errors
+    ///
+    /// [`Self::Error`] when the ledger cannot be reached.
+    fn acquire(
+        &self,
+        repo_id: NonZeroU64,
+        head: &CommitId,
+    ) -> Result<Option<Self::Lease>, Self::Error>;
+
+    /// Releases the lock `lease` holds, by compare-and-set: a lock another writer took after this
+    /// one expired is never released.
+    ///
+    /// # Errors
+    ///
+    /// [`Self::Error`] when the lock could not be released; it then expires with its TTL.
+    fn release(&self, lease: Self::Lease) -> Result<(), Self::Error>;
+
+    /// Writes `entry`'s evidence pointer and evidence record into the PR's state
+    /// `state/<repo_id>/<pr>.json`, by compare-and-set on the file.
+    ///
+    /// # Errors
+    ///
+    /// [`Self::Error`] when the state file could not be written.
+    fn record_evidence(&self, entry: &EvidenceEntry) -> Result<(), Self::Error>;
+}
+
+/// The run's artifact store, written with the run's token. Implemented by the forge adapter.
+pub trait BundleStore {
+    /// Why the artifact could not be uploaded.
+    type Error: std::error::Error;
+
+    /// Uploads `bytes` as `file` of a new artifact named `artifact`, kept 90 days.
+    ///
+    /// # Errors
+    ///
+    /// [`Self::Error`] when the upload failed.
+    fn upload(&self, artifact: &str, file: &str, bytes: &[u8]) -> Result<(), Self::Error>;
+}
+
+/// The verdict check's name: `assay / verdict` on the default branch, `assay / verdict @<base>`
+/// on any other base, so a verdict never passes for a base it was not decided for (R3-03).
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct CheckName(String);
+
+impl CheckName {
+    /// The name of the verdict check for a PR into `base_ref` in a repository whose default
+    /// branch is `default_branch`.
+    #[must_use]
+    pub fn for_base(base_ref: &str, default_branch: &str) -> Self {
+        if base_ref == default_branch {
+            Self("assay / verdict".to_owned())
+        } else {
+            Self(format!("assay / verdict @{base_ref}"))
+        }
+    }
+
+    /// The name as GitHub shows it.
+    #[must_use]
+    pub fn as_str(&self) -> &str {
+        &self.0
+    }
+}
+
+impl fmt::Display for CheckName {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(&self.0)
+    }
+}
+
+/// A check run's numeric id.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord)]
+pub struct CheckRunId(pub NonZeroU64);
+
+/// An issue comment's numeric id.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord)]
+pub struct CommentId(pub NonZeroU64);
+
+/// The App's verdict check as GitHub shows it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct CheckRun {
+    /// Its id.
+    pub id: CheckRunId,
+    /// `pending:<run_id>:<seq>` as `open` stamped it, or the decision key `decide` wrote.
+    pub external_id: String,
+    /// Its status.
+    pub status: CheckStatus,
+}
+
+/// A check run's status.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum CheckStatus {
+    /// Queued.
+    Queued,
+    /// In progress: `open` stamped it, or a decision is pending.
+    InProgress,
+    /// Completed with a final conclusion.
+    Completed,
+}
+
+/// Everything `decide` writes to the verdict check. There is no annotations field: location
+/// data travels in inline comments and the per-gate checks (R3-11).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct CheckUpdate {
+    /// Status and conclusion.
+    pub state: CheckState,
+    /// `output.title`.
+    pub title: String,
+    /// `output.summary`: counts, reasons, tier, degraded roles, AEU and how to respond.
+    pub summary: String,
+    /// `output.text`: the ledger state it projects.
+    pub text: String,
+    /// The decision key (02 §5).
+    pub external_id: String,
+}
+
+/// The status and conclusion `decide` gives the verdict check.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum CheckState {
+    /// A `pending` decision (rule 8a), shown as `in_progress`, never `neutral` (03 §5).
+    InProgress,
+    /// Completed with this conclusion.
+    Completed(CheckConclusion),
+}
+
+/// A final conclusion of the verdict check.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum CheckConclusion {
+    /// `success`.
+    Success,
+    /// `failure`.
+    Failure,
+    /// `neutral`: an owner override.
+    Neutral,
+}
+
+/// The App's summary comment on a PR.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SummaryComment {
+    /// Its id.
+    pub id: CommentId,
+    /// Its body as GitHub returns it.
+    pub body: String,
+}
+
+/// What `decide` records in the PR's ledger state for one evidence bundle (02 §5).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct EvidenceEntry {
+    /// The repository's numeric id.
+    pub repo_id: NonZeroU64,
+    /// The PR number.
+    pub pr: NonZeroU64,
+    /// Where the bundle is: replay and decide-only read it only through this (R3-08).
+    pub pointer: EvidencePointer,
+    /// What the bundle holds, for `admit`'s reuse check (R3-17).
+    pub record: EvidenceRecord,
+}
+
+/// The evidence pointer `{run_id, run_attempt, sha256}` (02 §5, R3-08).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct EvidencePointer {
+    /// The workflow run that uploaded the bundle.
+    pub run_id: NonZeroU64,
+    /// Its attempt, always 1.
+    pub run_attempt: NonZeroU64,
+    /// The sha256 of the uploaded bundle file.
+    pub sha256: Sha256Digest,
+}
+
+/// The evidence record `{evidence_key, bundle_sha256, llm, tier}` (02 §5, R3-17).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct EvidenceRecord {
+    /// The evidence key the bundle's run was planned under.
+    pub evidence_key: String,
+    /// The sha256 of the bundle, as in the pointer.
+    pub bundle_sha256: Sha256Digest,
+    /// How the LLM stage ran.
+    pub llm: LlmEvidence,
+    /// The tier the LLM stage ran at.
+    pub tier: Tier,
+}
+
+/// How the LLM stage of an evidence bundle ran: only `Complete` can stand in for an LLM review
+/// (R3-17).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum LlmEvidence {
+    /// It completed with no degraded role, or the tier has no LLM stage.
+    Complete,
+    /// It did not run because the PR was a draft (gates only).
+    SkippedDraft,
+    /// It was deferred, or did not run when it should have.
+    Deferred,
+    /// It completed with a degraded role.
+    Degraded,
+}
+
+impl LlmEvidence {
+    /// The record's wire word: `complete`, `skipped(draft)`, `deferred`, `degraded`.
+    #[must_use]
+    pub const fn code(self) -> &'static str {
+        match self {
+            Self::Complete => "complete",
+            Self::SkippedDraft => "skipped(draft)",
+            Self::Deferred => "deferred",
+            Self::Degraded => "degraded",
+        }
+    }
+}
diff --git a/crates/assay-app/src/publish/render.rs b/crates/assay-app/src/publish/render.rs
new file mode 100644
index 0000000..30087f5
--- /dev/null
+++ b/crates/assay-app/src/publish/render.rs
@@ -0,0 +1,302 @@
+//! The verdict check's output and the summary comment (04 §6): fixed text, closed vocabularies
+//! and digests `decide` computed, with every other string inside one fenced block per list, so
+//! nothing a PR or a model wrote renders as Markdown.
+
+use assay_domain::{Aeu, Conclusion, Counts, DegradedRole, PrClass, Reason, Tier};
+
+use super::ports::EvidenceEntry;
+
+/// The hidden marker the summary comment is found by (02 §5).
+pub const SUMMARY_MARKER: &str = "<!-- assay-summary -->";
+
+/// The most items of a list rendered; the rest are counted (H-13).
+pub(super) const MAX_ITEMS: usize = 50;
+
+/// The most characters of one item rendered; a longer item is clipped and marked (H-13).
+pub(super) const MAX_ITEM_CHARS: usize = 200;
+
+/// What the summary shows.
+pub(super) struct Summary<'a> {
+    pub(super) conclusion: Conclusion,
+    pub(super) reasons: &'a [Reason],
+    /// What the run established; `None` for a run refused before the rubric.
+    pub(super) facts: Option<Facts<'a>>,
+    /// Why the bundle was not persisted, when that is only a warning.
+    pub(super) warning: Option<&'static str>,
+}
+
+/// What an authenticated run's decision adds to the summary.
+pub(super) struct Facts<'a> {
+    pub(super) tier: Tier,
+    pub(super) classes: &'a [PrClass],
+    pub(super) counts: Counts,
+    pub(super) degraded: &'a [DegradedRole],
+    pub(super) cost: Aeu,
+    pub(super) reasons_digest: String,
+}
+
+/// What `output.text` projects of the ledger state.
+pub(super) struct Projection<'a> {
+    pub(super) decision_key: &'a str,
+    pub(super) inputs_digest: Option<&'a str>,
+    pub(super) evidence: Option<&'a EvidenceEntry>,
+}
+
+/// `output.title`: the conclusion and the first reason code.
+pub(super) fn title(conclusion: Conclusion, reasons: &[Reason]) -> String {
+    match reasons {
+        [] => format!("assay: {}", conclusion.code()),
+        [only] => format!("assay: {} ({})", conclusion.code(), only.code.code()),
+        [first, rest @ ..] => format!(
+            "assay: {} ({} and {} more)",
+            conclusion.code(),
+            first.code.code(),
+            rest.len()
+        ),
+    }
+}
+
+/// `output.summary`: conclusion, tier and classes, AEU, counts, reasons, degraded roles, the
+/// reasons digest and how to respond.
+pub(super) fn summary(summary: &Summary<'_>) -> String {
+    let mut lines = vec![
+        format!("**assay: {}**", summary.conclusion.code()),
+        String::new(),
+    ];
+    if let Some(facts) = &summary.facts {
+        lines.extend(header(facts));
+    }
+    lines.push("Reasons:".to_owned());
+    let reasons = summary.reasons.iter().map(|reason| {
+        let fp = reason.fp.map(|fp| format!(" ({fp})")).unwrap_or_default();
+        [
+            reason.code.code(),
+            ": ",
+            reason.detail.as_str(),
+            fp.as_str(),
+        ]
+        .concat()
+    });
+    block(&mut lines, summary.reasons.len(), reasons);
+    if let Some(facts) = &summary.facts {
+        lines.push(String::new());
+        lines.push("Degraded roles:".to_owned());
+        let degraded = facts
+            .degraded
+            .iter()
+            .map(|role| [role.role.as_str(), ": ", role.reason.as_str()].concat());
+        block(&mut lines, facts.degraded.len(), degraded);
+    }
+    if let Some(warning) = summary.warning {
+        lines.push(String::new());
+        lines.push(format!(
+            "**Warning:** this run's input bundle was not persisted (`{warning}`): replay and \
+             decide-only cannot use it; a new run is needed for them."
+        ));
+    }
+    if let Some(facts) = &summary.facts {
+        lines.push(String::new());
+        lines.push(format!(
+            "Reasons digest, for `/assay override`: `{}`",
+            facts.reasons_digest
+        ));
+    }
+    lines.extend(
+        [
+            "",
+            "How to respond (an eligible owner, then `/assay recheck`):",
+            "- `/assay waive <finding-id>` waives one human-decision gate finding;",
+            "- `/assay override llm|all <reasons_digest> <reason>` overrides the verdict;",
+            "- `/assay dismiss <fp> <reason>` dismisses one reviewer finding.",
+        ]
+        .map(str::to_owned),
+    );
+    lines.join("\n")
+}
+
+/// The summary's first facts: tier, classes and AEU, the finding counts, then a blank line.
+fn header(facts: &Facts<'_>) -> [String; 3] {
+    let classes: Vec<&str> = facts.classes.iter().map(|class| class.code()).collect();
+    let classes = if classes.is_empty() {
+        "none".to_owned()
+    } else {
+        classes.join(", ")
+    };
+    let counts = facts.counts;
+    [
+        format!(
+            "Tier: {} · Classes: {classes} · AEU: {}",
+            facts.tier.code(),
+            facts.cost
+        ),
+        format!(
+            "Findings: {} blocker · {} major · {} minor · {} nit",
+            counts.blocker, counts.major, counts.minor, counts.nit
+        ),
+        String::new(),
+    ]
+}
+
+/// `output.text`: the ledger state the check projects.
+pub(super) fn text(projection: &Projection<'_>) -> String {
+    let mut lines = vec![
+        "```text".to_owned(),
+        format!("decision_key: {}", projection.decision_key),
+    ];
+    if let Some(digest) = projection.inputs_digest {
+        lines.push(format!("inputs_digest: {digest}"));
+    }
+    match projection.evidence {
+        Some(entry) => {
+            let pointer = &entry.pointer;
+            let record = &entry.record;
+            lines.push(format!(
+                "evidence pointer: run_id {}, run_attempt {}, sha256 {}",
+                pointer.run_id, pointer.run_attempt, pointer.sha256
+            ));
+            lines.push(format!(
+                "evidence record: evidence_key {}, bundle_sha256 {}, llm {}, tier {}",
+                record.evidence_key,
+                record.bundle_sha256,
+                record.llm.code(),
+                record.tier.code()
+            ));
+        }
+        None => lines.push("evidence pointer: none".to_owned()),
+    }
+    lines.push("```".to_owned());
+    lines.join("\n")
+}
+
+/// The summary comment: the marker, then the summary.
+pub(super) fn comment(summary: &str) -> String {
+    [SUMMARY_MARKER, "\n\n", summary].concat()
+}
+
+/// Appends up to [`MAX_ITEMS`] of `total` items as one fenced block whose fence is longer than
+/// any backtick run inside it, each item cleaned and clipped, then how many were left out.
+fn block(lines: &mut Vec<String>, total: usize, items: impl Iterator<Item = String>) {
+    if total == 0 {
+        lines.push("none".to_owned());
+        return;
+    }
+    let shown: Vec<String> = items.take(MAX_ITEMS).map(|item| clean(&item)).collect();
+    let longest = shown.iter().map(|item| longest_backtick_run(item)).max();
+    let fence = "`".repeat(longest.unwrap_or(0).saturating_add(1).max(3));
+    lines.push([fence.as_str(), "text"].concat());
+    let rest = total.saturating_sub(shown.len());
+    lines.extend(shown);
+    lines.push(fence);
+    if rest > 0 {
+        lines.push(format!("and {rest} more, listed in the decision."));
+    }
+}
+
+/// `item` on one line: control characters (line breaks included) become U+FFFD, and past
+/// [`MAX_ITEM_CHARS`] characters it is cut and ends with `…`.
+fn clean(item: &str) -> String {
+    let mut chars = item.chars();
+    let mut cleaned: String = chars
+        .by_ref()
+        .take(MAX_ITEM_CHARS)
+        .map(|c| if c.is_control() { '\u{fffd}' } else { c })
+        .collect();
+    if chars.next().is_some() {
+        cleaned.push('…');
+    }
+    cleaned
+}
+
+/// The length of the longest run of backticks in `text`.
+fn longest_backtick_run(text: &str) -> usize {
+    text.split(|c| c != '`').map(str::len).max().unwrap_or(0)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{MAX_ITEM_CHARS, MAX_ITEMS, block, clean, longest_backtick_run};
+
+    fn rendered(items: &[String]) -> Vec<String> {
+        let mut lines = Vec::new();
+        block(&mut lines, items.len(), items.iter().cloned());
+        lines
+    }
+
+    #[test]
+    fn a_list_of_the_cap_is_rendered_whole() {
+        let items: Vec<String> = (0..MAX_ITEMS).map(|i| format!("item {i}")).collect();
+
+        let lines = rendered(&items);
+
+        assert_eq!(lines.len(), MAX_ITEMS + 2, "fence, every item, fence");
+        assert_eq!(lines.last().map(String::as_str), Some("```"));
+    }
+
+    #[test]
+    fn a_list_past_the_cap_counts_what_it_leaves_out() {
+        let items: Vec<String> = (0..=MAX_ITEMS).map(|i| format!("item {i}")).collect();
+
+        let lines = rendered(&items);
+
+        assert_eq!(
+            lines.len(),
+            MAX_ITEMS + 3,
+            "fence, the cap, fence, the count"
+        );
+        assert_eq!(
+            lines.last().map(String::as_str),
+            Some("and 1 more, listed in the decision.")
+        );
+    }
+
+    #[test]
+    fn an_empty_list_says_none() {
+        assert_eq!(rendered(&[]), ["none"]);
+    }
+
+    #[test]
+    fn an_item_of_the_cap_is_kept_whole() {
+        let item = "a".repeat(MAX_ITEM_CHARS);
+
+        assert_eq!(clean(&item), item);
+    }
+
+    #[test]
+    fn an_item_past_the_cap_is_clipped_and_marked() {
+        let item = "é".repeat(MAX_ITEM_CHARS + 1);
+
+        assert_eq!(
+            clean(&item),
+            ["é".repeat(MAX_ITEM_CHARS), "…".to_owned()].concat()
+        );
+    }
+
+    #[test]
+    fn control_characters_cannot_break_out_of_the_line() {
+        assert_eq!(clean("a\nb\r\u{1b}c"), "a\u{fffd}b\u{fffd}\u{fffd}c");
+    }
+
+    #[test]
+    fn the_fence_is_longer_than_any_backtick_run_inside() {
+        let lines = rendered(&["````\n</details>".to_owned()]);
+
+        assert_eq!(
+            lines,
+            ["`````text", "````\u{fffd}</details>", "`````"],
+            "a four-backtick run gets a five-backtick fence"
+        );
+    }
+
+    #[test]
+    fn a_short_backtick_run_keeps_the_three_backtick_fence() {
+        let lines = rendered(&["`code`".to_owned()]);
+
+        assert_eq!(lines, ["```text", "`code`", "```"]);
+    }
+
+    #[test]
+    fn backtick_runs_are_measured() {
+        assert_eq!(longest_backtick_run("a``b```c`"), 3);
+        assert_eq!(longest_backtick_run("plain"), 0);
+    }
+}
