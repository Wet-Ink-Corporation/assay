+++ b/crates/assay-app/src/decide/ports.rs
@@ -0,0 +1,81 @@
+//! The ports `decide` reads GitHub through: the PR's live state and the run's artifacts.
+
+use std::num::NonZeroU64;
+
+use assay_domain::RunUid;
+
+use crate::config::CommitId;
+
+/// GitHub's view of the PR at decide time, read with the App token. Implemented by the forge
+/// adapter.
+pub trait PullRequestState {
+    /// Why GitHub could not be read.
+    type Error: std::error::Error;
+
+    /// The PR's current head commit and base branch (`GET /pulls/{number}`).
+    ///
+    /// # Errors
+    ///
+    /// [`Self::Error`] when the PR cannot be read.
+    fn current(&self, number: NonZeroU64) -> Result<CurrentPullRequest, Self::Error>;
+
+    /// Every PR whose head is `head`, open or not (`GET /commits/{sha}/pulls`), as far as the
+    /// adapter pages.
+    ///
+    /// # Errors
+    ///
+    /// [`Self::Error`] when the list cannot be read.
+    fn pulls_on_head(&self, head: &CommitId) -> Result<Vec<PullOnHead>, Self::Error>;
+
+    /// Whether a run of this workflow newer than `run` exists for `head`.
+    ///
+    /// # Errors
+    ///
+    /// [`Self::Error`] when the runs cannot be listed.
+    fn newer_run(&self, run: RunUid, head: &CommitId) -> Result<bool, Self::Error>;
+}
+
+/// A PR's head and base as GitHub reports them now.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct CurrentPullRequest {
+    /// The head commit.
+    pub head_sha: CommitId,
+    /// The base branch (`pull.base.ref`).
+    pub base_ref: String,
+}
+
+/// One PR on a head commit.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct PullOnHead {
+    /// Its number.
+    pub number: NonZeroU64,
+    /// Whether it is open.
+    pub open: bool,
+    /// The base branch it targets.
+    pub base_ref: String,
+}
+
+/// The run's workflow artifacts, read with the run's token. Implemented by the forge adapter.
+pub trait RunArtifacts {
+    /// Why the artifacts could not be read.
+    type Error: std::error::Error;
+
+    /// The bytes of `file` in the artifact named `artifact`, read under `limit` bytes.
+    ///
+    /// # Errors
+    ///
+    /// [`Self::Error`] when the artifact store cannot be read; an absent artifact or file is
+    /// [`Fetched::Missing`] instead.
+    fn fetch(&self, artifact: &str, file: &str, limit: usize) -> Result<Fetched, Self::Error>;
+}
+
+/// What a fetch found.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Fetched {
+    /// The file's bytes, not yet authenticated.
+    Found(Vec<u8>),
+    /// No such artifact or file (expired, or deleted by a writer).
+    Missing,
+    /// The file is larger than the limit and was not read.
+    TooLarge,
+}
diff --git a/crates/assay-app/src/decide/recompute.rs b/crates/assay-app/src/decide/recompute.rs
new file mode 100644
index 0000000..907d0a1
--- /dev/null
+++ b/crates/assay-app/src/decide/recompute.rs
@@ -0,0 +1,153 @@
+//! The plan, authenticated and recomputed (02 §4: `run.json` is not trusted by Z4): its
+//! artifact must hash to the `plan` job's output, pass its schema, and equal the document Z4
+//! writes from its own reading of base config and the PR's objects.
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::convert::Infallible;
+
+use assay_domain::Tier;
+use serde_json::Value;
+
+use super::fetch::{Artifact, Fetch};
+use super::ports::RunArtifacts;
+use super::refusal::{PlanMismatch, PlanRefusal, Refusal, Unreadable};
+use super::request::{DecideRequest, JobResult, TierDegrade};
+use super::{DecideError, Halt, Reader};
+use crate::contract::Contract;
+use crate::plan::{
+    ArtifactJob, ArtifactNonce, PlanError, PullRequestObjects, Recomputed, recompute,
+};
+
+/// The file the `plan` artifact holds.
+pub(super) const PLAN_FILE: &str = "run.json";
+
+/// The plan as Z4 recomputed and authenticated it.
+#[derive(Debug)]
+pub(super) struct AuthenticPlan {
+    pub(super) recomputed: Recomputed,
+    pub(super) artifact_names: BTreeMap<ArtifactJob, String>,
+    /// The tier the LLM stage was run at: the recomputed one, or `lite` after `admit`'s
+    /// accepted degrade.
+    pub(super) tier: Tier,
+}
+
+/// Authenticates the plan artifact and checks it against Z4's own recomputation.
+pub(super) fn authenticate_plan<O: PullRequestObjects, S, A: RunArtifacts>(
+    request: &DecideRequest,
+    reader: &mut Reader<'_, O, A>,
+) -> Result<AuthenticPlan, Halt<O::Error, S, A::Error>> {
+    let job = &request.plan_job;
+    let unreadable = |why| Refusal::ArtifactUnreadable {
+        job: ArtifactJob::Plan,
+        file: PLAN_FILE.to_owned(),
+        why,
+    };
+    let artifact = Artifact {
+        job: ArtifactJob::Plan,
+        name: &job.artifact,
+    };
+    let bytes = match reader.fetcher.fetch(artifact, PLAN_FILE, &job.document)? {
+        Fetch::Authentic(bytes) => bytes,
+        Fetch::Missing => return Err(unreadable(Unreadable::Missing).into()),
+        Fetch::TooLarge => return Err(unreadable(Unreadable::TooLarge).into()),
+        Fetch::Tampered => {
+            return Err(Refusal::ArtifactDigest {
+                job: ArtifactJob::Plan,
+                file: PLAN_FILE.to_owned(),
+            }
+            .into());
+        }
+    };
+    let document = reader
+        .validator
+        .read(Contract::Run, &bytes)
+        .map_err(|_invalid| Refusal::from(PlanMismatch::Invalid))?;
+    let artifact_names =
+        artifact_names(&document, &job.artifact).ok_or(PlanMismatch::ArtifactNames)?;
+    let recomputed = recompute::<O, Infallible>(&request.plan, reader.objects).map_err(refused)?;
+    let expected = recomputed
+        .to_json(&request.plan, &artifact_names)
+        .and_then(|json| serde_json::from_slice::<Value>(&json))
+        .map_err(DecideError::Encode)?;
+    if let Some(name) = first_difference(&expected, &document) {
+        return Err(Refusal::from(PlanMismatch::Field { name }).into());
+    }
+    let tier = degraded_tier(request, &recomputed)?;
+    Ok(AuthenticPlan {
+        recomputed,
+        artifact_names,
+        tier,
+    })
+}
+
+/// A recomputation error as a refusal when it is about the PR, as an error when the port
+/// failed.
+fn refused<O, S, A>(error: PlanError<O, Infallible>) -> Halt<O, S, A> {
+    let refusal = match error {
+        PlanError::DiffTooSlow => PlanRefusal::DiffTooSlow,
+        PlanError::FileList(error) => PlanRefusal::FileList(error),
+        PlanError::BaseConfig(error) => PlanRefusal::BaseConfig(error),
+        PlanError::Nonce(never) => match never {},
+        other => return Halt::Failed(DecideError::Recompute(other)),
+    };
+    Halt::Refused(Refusal::PlanMismatch(PlanMismatch::Recompute(refusal)))
+}
+
+/// The plan's artifact names, one `assay-<job>-<nonce>` per job with distinct nonces and its
+/// own equal to the `plan` job's output; `None` otherwise.
+fn artifact_names(document: &Value, plan_artifact: &str) -> Option<BTreeMap<ArtifactJob, String>> {
+    let names = document.get("artifact_names")?.as_object()?;
+    if names.len() != ArtifactJob::ALL.len() {
+        return None;
+    }
+    let mut nonces = BTreeSet::new();
+    let mut parsed = BTreeMap::new();
+    for job in ArtifactJob::ALL {
+        let name = names.get(job.name())?.as_str()?;
+        let nonce: ArtifactNonce = name
+            .strip_prefix("assay-")?
+            .strip_prefix(job.name())?
+            .strip_prefix('-')?
+            .parse()
+            .ok()?;
+        if !nonces.insert(nonce) {
+            return None;
+        }
+        parsed.insert(job, name.to_owned());
+    }
+    (parsed.get(&ArtifactJob::Plan).map(String::as_str) == Some(plan_artifact)).then_some(parsed)
+}
+
+/// The first top-level field, in key order, whose value differs between Z4's document and the
+/// plan's, or that only one of them has.
+fn first_difference(expected: &Value, actual: &Value) -> Option<String> {
+    let (Some(expected), Some(actual)) = (expected.as_object(), actual.as_object()) else {
+        return Some(String::new());
+    };
+    let keys: BTreeSet<&String> = expected.keys().chain(actual.keys()).collect();
+    keys.into_iter()
+        .find(|key| expected.get(*key) != actual.get(*key))
+        // Z4's own key when it has one; else the plan's, which the schema bounded.
+        .map(|key| (*key).clone())
+}
+
+/// The tier the LLM stage ran at: `admit`'s full-to-lite degrade is accepted only from a
+/// successful `admit`, on a recomputed `full` with no class (04 §2.4, R3-27).
+fn degraded_tier(request: &DecideRequest, recomputed: &Recomputed) -> Result<Tier, PlanMismatch> {
+    let tiering = &recomputed.tiering;
+    let admitted = request.admit.result == JobResult::Success;
+    match request.admit.degrade {
+        TierDegrade::FullToLite if admitted => {
+            if tiering.tier == Tier::Full && tiering.classes.is_empty() {
+                Ok(Tier::Lite)
+            } else {
+                Err(PlanMismatch::Degrade {
+                    tier: tiering.tier,
+                    // The refusal reports the classes it saw.
+                    classes: tiering.classes.clone(),
+                })
+            }
+        }
+        TierDegrade::FullToLite | TierDegrade::None => Ok(tiering.tier),
+    }
+}
diff --git a/crates/assay-app/src/decide/refusal.rs b/crates/assay-app/src/decide/refusal.rs
new file mode 100644
index 0000000..6042f69
--- /dev/null
+++ b/crates/assay-app/src/decide/refusal.rs
@@ -0,0 +1,200 @@
+//! What `decide` refuses to believe before the rubric runs: each refusal fails the run closed
+//! with one reason (06 §6, F15, F18).
+
+use assay_domain::{PrClass, Reason, ReasonCode, Tier};
+
+use super::request::{JobResult, UpstreamJob};
+use crate::plan::{ArtifactJob, BaseConfigError, FileListError};
+
+/// Which of the PR's two refs moved since `plan` pinned them (R3-03).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum Moved {
+    /// The head is another commit.
+    Head,
+    /// The PR targets another base branch.
+    BaseRef,
+    /// Both.
+    HeadAndBaseRef,
+}
+
+/// A fail-closed verdict reached before the rubric: published as `failure` with
+/// [`Refusal::reason`].
+#[derive(Debug)]
+pub enum Refusal {
+    /// The `plan` job did not succeed, so there is no plan to check.
+    PlanNotSucceeded {
+        /// How it ended.
+        result: JobResult,
+    },
+    /// An upstream job was cancelled and no newer run exists for the head: a person cancelled
+    /// it.
+    Cancelled {
+        /// The first cancelled job, in pipeline order.
+        job: UpstreamJob,
+    },
+    /// An artifact's sha256 differs from its producing job's output digest (F18): it is never
+    /// used.
+    ArtifactDigest {
+        /// The producing job.
+        job: ArtifactJob,
+        /// The file in its artifact.
+        file: String,
+    },
+    /// An artifact `decide` cannot do without could not be read.
+    ArtifactUnreadable {
+        /// The producing job.
+        job: ArtifactJob,
+        /// The file in its artifact.
+        file: String,
+        /// Why.
+        why: Unreadable,
+    },
+    /// A job's outputs do not describe what it ran.
+    Outputs {
+        /// The job.
+        job: UpstreamJob,
+        /// What is wrong with them.
+        problem: OutputsProblem,
+    },
+    /// Z4's recomputation disagrees with the plan (F15).
+    PlanMismatch(PlanMismatch),
+}
+
+/// Why an artifact could not be read.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum Unreadable {
+    /// It is gone: expired, or deleted by a writer (not forgery, F20).
+    Missing,
+    /// It is larger than `decide` reads.
+    TooLarge,
+}
+
+impl Unreadable {
+    /// The reason detail's word for it.
+    pub(super) const fn code(self) -> &'static str {
+        match self {
+            Self::Missing => "artifact-missing",
+            Self::TooLarge => "document-too-large",
+        }
+    }
+}
+
+/// What is wrong with a job's outputs.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum OutputsProblem {
+    /// A report names a plugin base config does not schedule in that job.
+    UnknownPlugin,
+    /// Two reports name one plugin.
+    DuplicatePlugin,
+    /// A skipped job reported a gate.
+    SkippedJobReported,
+    /// More documents than `decide` reads.
+    TooManyDocuments,
+    /// A document's file name is not a lowercase name and `.json`.
+    FileName,
+    /// Two documents share a file name.
+    DuplicateFile,
+}
+
+impl OutputsProblem {
+    const fn code(self) -> &'static str {
+        match self {
+            Self::UnknownPlugin => "unknown-plugin",
+            Self::DuplicatePlugin => "duplicate-plugin",
+            Self::SkippedJobReported => "skipped-job-reported",
+            Self::TooManyDocuments => "too-many-documents",
+            Self::FileName => "file-name",
+            Self::DuplicateFile => "duplicate-file",
+        }
+    }
+}
+
+/// How the plan disagrees with Z4.
+#[derive(Debug)]
+pub enum PlanMismatch {
+    /// The plan document fails `run-1.schema.json`.
+    Invalid,
+    /// Its artifact names are not one `assay-<job>-<nonce>` per job with distinct nonces, or its
+    /// own differs from the `plan` job's output.
+    ArtifactNames,
+    /// A top-level field differs from Z4's recomputation; the first in key order.
+    Field {
+        /// The field's name, as Z4's own document spells it.
+        name: String,
+    },
+    /// Z4 could not recompute the plan, where `plan` did.
+    Recompute(PlanRefusal),
+    /// `admit` degraded a run that is not a classless `full` (04 §2.4).
+    Degrade {
+        /// The recomputed tier.
+        tier: Tier,
+        /// The recomputed classes.
+        classes: Vec<PrClass>,
+    },
+}
+
+/// Why Z4's recomputation of the plan refused the PR.
+#[derive(Debug)]
+pub enum PlanRefusal {
+    /// git did not list the changed files within its cap.
+    DiffTooSlow,
+    /// The git and REST file lists disagree.
+    FileList(FileListError),
+    /// Base `.assay/` was refused.
+    BaseConfig(BaseConfigError),
+}
+
+impl PlanMismatch {
+    fn detail(&self) -> String {
+        match self {
+            Self::Invalid => "the plan fails its schema".to_owned(),
+            Self::ArtifactNames => "artifact_names".to_owned(),
+            // The reason owns its detail; the refusal keeps its own name.
+            Self::Field { name } => name.clone(),
+            Self::Recompute(PlanRefusal::DiffTooSlow) => "diff-too-slow".to_owned(),
+            Self::Recompute(PlanRefusal::FileList(_)) => "file-list".to_owned(),
+            Self::Recompute(PlanRefusal::BaseConfig(_)) => "base-config".to_owned(),
+            Self::Degrade { tier, .. } => format!("tier_degraded_from on a {} run", tier.code()),
+        }
+    }
+}
+
+impl Refusal {
+    /// The reason the check is failed with: `plan-mismatch` for a plan Z4 disagrees with,
+    /// `gate-error` for everything else.
+    #[must_use]
+    pub fn reason(&self) -> Reason {
+        let (code, detail) = match self {
+            Self::PlanNotSucceeded { result } => {
+                (ReasonCode::GateError, format!("plan: {}", result.code()))
+            }
+            Self::Cancelled { job } => {
+                (ReasonCode::GateError, format!("{}: cancelled", job.name()))
+            }
+            Self::ArtifactDigest { job, file } => (
+                ReasonCode::GateError,
+                format!("artifact-digest: {}/{file}", job.name()),
+            ),
+            Self::ArtifactUnreadable { job, file, why } => (
+                ReasonCode::GateError,
+                format!("{}: {}/{file}", why.code(), job.name()),
+            ),
+            Self::Outputs { job, problem } => (
+                ReasonCode::GateError,
+                format!("outputs: {}: {}", job.name(), problem.code()),
+            ),
+            Self::PlanMismatch(mismatch) => (ReasonCode::PlanMismatch, mismatch.detail()),
+        };
+        Reason {
+            code,
+            detail,
+            fp: None,
+        }
+    }
+}
+
+impl From<PlanMismatch> for Refusal {
+    fn from(mismatch: PlanMismatch) -> Self {
+        Self::PlanMismatch(mismatch)
+    }
+}
diff --git a/crates/assay-app/src/decide/request.rs b/crates/assay-app/src/decide/request.rs
new file mode 100644
index 0000000..c49894b
--- /dev/null
+++ b/crates/assay-app/src/decide/request.rs
@@ -0,0 +1,193 @@
+//! What the pipeline's `decide` job is given besides the PR's objects: the outputs and results
+//! of the jobs it needs, which steps PR code cannot reach wrote (02 §1). They are trusted; the
+//! artifacts they name are not until their digests match.
+
+use crate::config::Sha256Digest;
+use crate::gate::{Conclusion, GateError};
+use crate::plan::PlanRequest;
+
+/// How an upstream job ended, as `needs.<job>.result` reports it.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum JobResult {
+    /// Every step succeeded.
+    Success,
+    /// A step failed, or the job ran past its timeout.
+    Failure,
+    /// The job was cancelled, by a newer run's `cancel-in-progress` or by a person.
+    Cancelled,
+    /// The job did not run (its condition was false or a job it needs failed).
+    Skipped,
+}
+
+impl JobResult {
+    /// The result as GitHub writes it.
+    #[must_use]
+    pub const fn code(self) -> &'static str {
+        match self {
+            Self::Success => "success",
+            Self::Failure => "failure",
+            Self::Cancelled => "cancelled",
+            Self::Skipped => "skipped",
+        }
+    }
+}
+
+/// A job `decide` needs (02 §1).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord)]
+pub enum UpstreamJob {
+    /// `plan`.
+    Plan,
+    /// `gates-static`.
+    GatesStatic,
+    /// `gates-lint`.
+    GatesLint,
+    /// `gates-test`.
+    GatesTest,
+    /// `admit`.
+    Admit,
+    /// `review`.
+    Review,
+    /// `release`.
+    Release,
+}
+
+impl UpstreamJob {
+    /// The job's name in the workflow.
+    #[must_use]
+    pub const fn name(self) -> &'static str {
+        match self {
+            Self::Plan => "plan",
+            Self::GatesStatic => "gates-static",
+            Self::GatesLint => "gates-lint",
+            Self::GatesTest => "gates-test",
+            Self::Admit => "admit",
+            Self::Review => "review",
+            Self::Release => "release",
+        }
+    }
+}
+
+/// The `plan` job's outputs: its artifact and the digest of the `run.json` in it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct PlanJob {
+    /// How the job ended.
+    pub result: JobResult,
+    /// The plan artifact's name, `assay-plan-<nonce>`.
+    pub artifact: String,
+    /// The sha256 of the `run.json` the job uploaded.
+    pub document: Sha256Digest,
+}
+
+/// One gates job's outputs: a report per plugin it ran.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct GateJobOutputs {
+    /// How the job ended.
+    pub result: JobResult,
+    /// What the job reported for each plugin scheduled in it, by plugin name.
+    pub gates: Vec<ReportedGate>,
+}
+
+/// What a gates job reported for one plugin.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ReportedGate {
+    /// The plugin's name in base `.assay/plugins.toml`.
+    pub plugin: String,
+    /// How the gate ended.
+    pub reported: Reported,
+}
+
+/// How a gate ended in its job (03 §2).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Reported {
+    /// It ran cleanly and uploaded `<plugin>.json` in the job's artifact.
+    Concluded {
+        /// The conclusion assay drew from the exit code and the document.
+        conclusion: Conclusion,
+        /// The sha256 of the uploaded document.
+        document: Sha256Digest,
+    },
+    /// It is a gate error; nothing of it is uploaded.
+    Error(GateError),
+}
+
+/// Whether `admit` degraded the run's tier for budget (04 §2.4).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum TierDegrade {
+    /// No degrade.
+    None,
+    /// `budget.tier_degraded_from = "full"`: a non-trust-path `full` run reviewed as `lite`.
+    FullToLite,
+}
+
+/// The `admit` job's outputs.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct AdmitJob {
+    /// How the job ended; a degrade counts only from a successful `admit`.
+    pub result: JobResult,
+    /// Its tier degrade.
+    pub degrade: TierDegrade,
+}
+
+/// One document of the `review` artifact and its digest.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ArtifactDocument {
+    /// The file in the artifact: a lowercase name of letters, digits and `-`, then `.json`.
+    pub file: String,
+    /// Its sha256.
+    pub digest: Sha256Digest,
+}
+
+/// The `review` job's outputs.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ReviewJob {
+    /// How the job ended.
+    pub result: JobResult,
+    /// Every document it uploaded.
+    pub documents: Vec<ArtifactDocument>,
+}
+
+/// Everything `decide` is given besides the PR's objects and GitHub's live state.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct DecideRequest {
+    /// What Z4 recomputes the plan from: the triggering event's PR and pinned SHAs, this run,
+    /// Z4's own REST file list, the package sets and include targets `gates-static` reported,
+    /// and the prompt bundle hash.
+    pub plan: PlanRequest,
+    /// The `plan` job.
+    pub plan_job: PlanJob,
+    /// The `gates-static` job.
+    pub gates_static: GateJobOutputs,
+    /// The `gates-lint` job.
+    pub gates_lint: GateJobOutputs,
+    /// The `gates-test` job.
+    pub gates_test: GateJobOutputs,
+    /// The `admit` job.
+    pub admit: AdmitJob,
+    /// The `review` job.
+    pub review: ReviewJob,
+    /// How the `release` job ended.
+    pub release: JobResult,
+}
+
+impl DecideRequest {
+    /// Every upstream job's result, in pipeline order.
+    pub(super) const fn results(&self) -> [(UpstreamJob, JobResult); 7] {
+        [
+            (UpstreamJob::Plan, self.plan_job.result),
+            (UpstreamJob::GatesStatic, self.gates_static.result),
+            (UpstreamJob::GatesLint, self.gates_lint.result),
+            (UpstreamJob::GatesTest, self.gates_test.result),
+            (UpstreamJob::Admit, self.admit.result),
+            (UpstreamJob::Review, self.review.result),
+            (UpstreamJob::Release, self.release),
+        ]
+    }
+
+    /// The first upstream job that was cancelled, if any.
+    pub(super) fn cancelled(&self) -> Option<UpstreamJob> {
+        self.results()
+            .into_iter()
+            .find(|(_, result)| *result == JobResult::Cancelled)
+            .map(|(job, _)| job)
+    }
+}
diff --git a/crates/assay-app/src/gate.rs b/crates/assay-app/src/gate.rs
index b5cf403..c24f577 100644
--- a/crates/assay-app/src/gate.rs
+++ b/crates/assay-app/src/gate.rs
@@ -8,6 +8,8 @@
 
 mod job;
 
+use std::borrow::Cow;
+
 use serde_json::Value;
 use thiserror::Error;
 
@@ -120,6 +122,23 @@ pub enum GateError {
     Skipped,
