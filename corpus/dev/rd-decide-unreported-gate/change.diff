@@ -0,0 +1,529 @@
+//! `decide`'s authentication of its inputs (Z4, `docs/architecture/02-architecture.md` §1, §4
+//! and §5): what the rubric may believe, and when nothing may be published at all.
+//!
+//! Z4 believes nothing it can recompute. [`authenticate`] refuses a re-run before reading
+//! anything (R3-05); re-fetches the PR's head and base ref, and stops without a check or comment
+//! if either moved (R3-03, R3-06); yields to a newer run when an upstream job was cancelled;
+//! authenticates every artifact it reads by the sha256 its producing job published (F18);
+//! recomputes the plan from base config and the PR's objects and refuses one that differs (F15),
+//! accepting only `admit`'s full-to-lite degrade (R3-27); reads every scheduled gate, a skipped
+//! or failed one never passing; recomputes each gate finding's evidence and fingerprint; and
+//! counts the open PRs on the head (R3-19). Anything it cannot read or reconcile is refused, not
+//! modelled (wi-b5affa). Publishing is #57's; the GitHub snapshot is #58's.
+
+mod evidence;
+mod fetch;
+mod gates;
+mod ports;
+mod recompute;
+mod refusal;
+mod request;
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::convert::Infallible;
+use std::num::NonZeroU64;
+
+use assay_domain::{
+    Authorship, Finding, GateReport, InfraPolicy, LlmPolicy, OwnerApproval, Policy, PrClass,
+    PullRequest, Readiness, Tier, Tiering,
+};
+use thiserror::Error;
+
+pub use self::fetch::MAX_FETCHED_BYTES;
+use self::fetch::{Artifact, Fetch, Fetcher};
+pub use self::ports::{CurrentPullRequest, Fetched, PullOnHead, PullRequestState, RunArtifacts};
+use self::recompute::AuthenticPlan;
+pub use self::refusal::{Moved, OutputsProblem, PlanMismatch, PlanRefusal, Refusal, Unreadable};
+pub use self::request::{
+    AdmitJob, ArtifactDocument, DecideRequest, GateJobOutputs, JobResult, PlanJob, Reported,
+    ReportedGate, ReviewJob, TierDegrade, UpstreamJob,
+};
+use crate::config::{self, AssaySettings, InfraFailurePolicy, Promotion};
+use crate::contract::ContractValidator;
+use crate::plan::{ArtifactJob, EvidenceKey, PlanError, PullRequestEvent, PullRequestObjects};
+
+/// The most documents the `review` job may publish (H-13).
+pub const MAX_REVIEW_DOCUMENTS: usize = 64;
+
+/// What `decide` may do with this run.
+#[derive(Debug)]
+pub enum Authentication {
+    /// The PR's head or base ref moved since `plan`: emit `RunSuperseded` and write no check
+    /// and no comment; the ledger record and slot release still happen (R3-06).
+    Superseded(Moved),
+    /// An upstream job was cancelled and a newer run exists for the head: publish nothing and
+    /// leave the check `in_progress` for that run (R2-5).
+    YieldToNewer,
+    /// Publish `failure` with [`Refusal::reason`]: the rubric does not run.
+    Refused(Refusal),
+    /// The inputs are authenticated: build the decision from them.
+    Authenticated(Box<AuthenticatedRun>),
+}
+
+/// What Z4 established about a run, for `decide`'s inputs (04 §5).
+#[derive(Debug)]
+pub struct AuthenticatedRun {
+    run_key: EvidenceKey,
+    artifact_names: BTreeMap<ArtifactJob, String>,
+    tiering: Tiering,
+    tier: Tier,
+    policy: Policy,
+    base_ref: String,
+    open_prs_on_head: u32,
+    gates: Vec<GateReport>,
+    gate_findings: Vec<Finding>,
+    review_documents: Vec<Vec<u8>>,
+}
+
+/// The facts of GitHub's state snapshot a decision needs about the PR (#58's to compute).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Snapshot {
+    /// `owner_approved(head)` (04 §5).
+    pub owner_approval: OwnerApproval,
+    /// Whether an agent identity authored the PR.
+    pub authorship: Authorship,
+    /// The PR's draft flag at decide time.
+    pub readiness: Readiness,
+    /// How many times this head's deferred run was requeued.
+    pub requeues: u32,
+}
+
+impl AuthenticatedRun {
+    /// The evidence key Z4 recomputed (the plan's `run_key`).
+    #[must_use]
+    pub const fn run_key(&self) -> EvidenceKey {
+        self.run_key
+    }
+
+    /// Each job's artifact name, as the authenticated plan names it.
+    #[must_use]
+    pub const fn artifact_names(&self) -> &BTreeMap<ArtifactJob, String> {
+        &self.artifact_names
+    }
+
+    /// The tiering Z4 recomputed, before any degrade.
+    #[must_use]
+    pub const fn tiering(&self) -> &Tiering {
+        &self.tiering
+    }
+
+    /// The tier the LLM stage ran at: the recomputed tier, or `lite` after `admit`'s accepted
+    /// full-to-lite degrade (R3-27). With the classes it names the roles rule 8 requires.
+    #[must_use]
+    pub const fn tier(&self) -> Tier {
+        self.tier
+    }
+
+    /// Base policy (03 §1 `[assay]`).
+    #[must_use]
+    pub const fn policy(&self) -> &Policy {
+        &self.policy
+    }
+
+    /// Open PRs on the head into the PR's base, the PR itself included (rule 2a).
+    #[must_use]
+    pub const fn open_prs_on_head(&self) -> u32 {
+        self.open_prs_on_head
+    }
+
+    /// One report per gate and job the plan schedules (rule 1), in job then file order.
+    #[must_use]
+    pub fn gates(&self) -> &[GateReport] {
+        &self.gates
+    }
+
+    /// Every finding of every gate that ran, anchored by Z4: evidence replaced by the tree's
+    /// line where verified, and the rule dropped where not. Validation's `gate_findings`.
+    #[must_use]
+    pub fn gate_findings(&self) -> &[Finding] {
+        &self.gate_findings
+    }
+
+    /// The `review` job's documents, authenticated by digest and not yet read: validation's
+    /// documents.
+    #[must_use]
+    pub fn review_documents(&self) -> &[Vec<u8>] {
+        &self.review_documents
+    }
+
+    /// The PR as rubric v1 reads it: Z4's facts with the snapshot's.
+    #[must_use]
+    pub fn pull_request(&self, snapshot: Snapshot) -> PullRequest {
+        PullRequest {
+            // The decision input owns its base ref; the run keeps its own.
+            base_ref: self.base_ref.clone(),
+            open_prs_on_head: self.open_prs_on_head,
+            tier: self.tier,
+            // As above: the input owns the classes.
+            classes: self.tiering.classes.clone(),
+            owner_approval: snapshot.owner_approval,
+            authorship: snapshot.authorship,
+            readiness: snapshot.readiness,
+            requeues: snapshot.requeues,
+        }
+    }
+}
+
+/// Which call to GitHub's live state failed.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum StateStep {
+    /// [`PullRequestState::current`].
+    Current,
+    /// [`PullRequestState::pulls_on_head`].
+    PullsOnHead,
+    /// [`PullRequestState::newer_run`].
+    NewerRun,
+}
+
+impl StateStep {
+    const fn describe(self) -> &'static str {
+        match self {
+            Self::Current => "re-fetch the pull request",
+            Self::PullsOnHead => "list the pull requests on the head",
+            Self::NewerRun => "look for a newer run",
+        }
+    }
+}
+
+/// Why `decide` could not reach a verdict at all. Nothing is published; the job fails.
+#[derive(Debug, Error)]
+pub enum DecideError<O, S, A> {
+    /// The run is a re-run: privileged jobs run on attempt 1 only, and recovery is a fresh run
+    /// (R3-05, T22). Nothing was read.
+    #[error("refused attempt {attempt}: decide runs on attempt 1 only; start a fresh run")]
+    NotFirstAttempt {
+        /// The attempt.
+        attempt: NonZeroU64,
+    },
+    /// GitHub's live state could not be read.
+    #[error("could not {} on GitHub", step.describe())]
+    State {
+        /// The call that failed.
+        step: StateStep,
+        /// The port's error.
+        #[source]
+        source: S,
+    },
+    /// The artifact store could not be read.
+    #[error("could not fetch {file} of the {} artifact", job.name())]
+    Artifacts {
+        /// The producing job.
+        job: ArtifactJob,
+        /// The file asked for.
+        file: String,
+        /// The port's error.
+        #[source]
+        source: A,
+    },
+    /// The PR's objects could not be read to recompute the plan.
+    #[error("could not recompute the plan")]
+    Recompute(#[source] PlanError<O, Infallible>),
+    /// The PR's objects could not be read for gate evidence.
+    #[error("could not read the files gate findings cite")]
+    Objects(#[source] O),
+    /// The objects port returned another number of blobs than asked for.
+    #[error("asked for {asked} blobs, read {returned}")]
+    ShortRead {
+        /// Entries asked for.
+        asked: usize,
+        /// Blobs returned.
+        returned: usize,
+    },
+    /// The recomputed run description could not be encoded: a defect in `decide`.
+    #[error("could not encode the recomputed run description")]
+    Encode(#[source] serde_json::Error),
+}
+
+/// The [`DecideError`] of [`authenticate`] over `ports`' error types.
+pub type DecideFailure<O, S, A> = DecideError<
+    <O as PullRequestObjects>::Error,
+    <S as PullRequestState>::Error,
+    <A as RunArtifacts>::Error,
+>;
+
+/// The ports `decide` reads through, borrowed for one call.
+#[derive(Debug)]
+pub struct DecidePorts<'p, O, S, A> {
+    /// The PR's objects, read at the pinned SHAs only.
+    pub objects: &'p O,
+    /// GitHub's live state of the PR.
+    pub state: &'p S,
+    /// The run's artifacts.
+    pub artifacts: &'p A,
+}
+
+/// What `decide` reads documents with: the objects, the artifacts under the run's byte budget
+/// and the contract validator.
+struct Reader<'r, O, A> {
+    objects: &'r O,
+    fetcher: Fetcher<'r, A>,
+    validator: &'r ContractValidator,
+}
+
+/// [`Halt`] over `ports`' error types.
+type HaltOf<O, S, A> = Halt<
+    <O as PullRequestObjects>::Error,
+    <S as PullRequestState>::Error,
+    <A as RunArtifacts>::Error,
+>;
+
+/// Why authentication stopped early: a refusal to publish, or an error.
+#[derive(Debug)]
+enum Halt<O, S, A> {
+    Refused(Refusal),
+    Failed(DecideError<O, S, A>),
+}
+
+impl<O, S, A> From<Refusal> for Halt<O, S, A> {
+    fn from(refusal: Refusal) -> Self {
+        Self::Refused(refusal)
+    }
+}
+
+impl<O, S, A> From<PlanMismatch> for Halt<O, S, A> {
+    fn from(mismatch: PlanMismatch) -> Self {
+        Self::Refused(Refusal::PlanMismatch(mismatch))
+    }
+}
+
+impl<O, S, A> From<DecideError<O, S, A>> for Halt<O, S, A> {
+    fn from(error: DecideError<O, S, A>) -> Self {
+        Self::Failed(error)
+    }
+}
+
+/// Authenticates one pipeline run's inputs for `decide`.
+///
+/// `request`'s job outputs are read against the PR's objects, GitHub's live state and the run's
+/// artifacts through `ports`, with every document checked by `validator`.
+///
+/// # Examples
+///
+/// ```
+/// use assay_app::{
+///     Authentication, ContractValidator, DecideFailure, DecidePorts, DecideRequest,
+///     PullRequestObjects, PullRequestState, RunArtifacts, authenticate,
+/// };
+///
+/// # fn demo<O: PullRequestObjects, S: PullRequestState, A: RunArtifacts>(
+/// #     request: &DecideRequest,
+/// #     ports: &DecidePorts<'_, O, S, A>,
+/// #     validator: &ContractValidator,
+/// # ) -> Result<(), DecideFailure<O, S, A>> {
+/// match authenticate(request, ports, validator)? {
+///     // Write nothing: no check, no comment.
+///     Authentication::Superseded(_) | Authentication::YieldToNewer => {}
+///     // Publish `failure` with this reason.
+///     Authentication::Refused(refusal) => drop(refusal.reason()),
+///     // Build the decision inputs from the run.
+///     Authentication::Authenticated(run) => drop(run.gates()),
+/// }
+/// # Ok(())
+/// # }
+/// ```
+///
+/// # Errors
+///
+/// [`DecideError::NotFirstAttempt`] for a re-run, before any port is called; otherwise a port
+/// failed ([`DecideError::State`], [`DecideError::Artifacts`], [`DecideError::Recompute`],
+/// [`DecideError::Objects`], [`DecideError::ShortRead`]) or the recomputed plan could not be
+/// encoded ([`DecideError::Encode`]). A refusal is an [`Authentication`], not an error.
+pub fn authenticate<O: PullRequestObjects, S: PullRequestState, A: RunArtifacts>(
+    request: &DecideRequest,
+    ports: &DecidePorts<'_, O, S, A>,
+    validator: &ContractValidator,
+) -> Result<Authentication, DecideFailure<O, S, A>> {
+    let attempt = request.plan.run_uid.run_attempt;
+    if attempt.get() != 1 {
+        return Err(DecideError::NotFirstAttempt { attempt });
+    }
+    match run(request, ports, validator) {
+        Ok(authentication) => Ok(authentication),
+        Err(Halt::Refused(refusal)) => Ok(Authentication::Refused(refusal)),
+        Err(Halt::Failed(error)) => Err(error),
+    }
+}
+
+/// The checks of [`authenticate`] after the attempt guard, in the order of 02 §1.
+fn run<O: PullRequestObjects, S: PullRequestState, A: RunArtifacts>(
+    request: &DecideRequest,
+    ports: &DecidePorts<'_, O, S, A>,
+    validator: &ContractValidator,
+) -> Result<Authentication, HaltOf<O, S, A>> {
+    let event = &request.plan.pull_request;
+    let state = ports.state;
+    let current = state
+        .current(event.number)
+        .map_err(state_error(StateStep::Current))?;
+    if let Some(moved) = moved(event, &current) {
+        return Ok(Authentication::Superseded(moved));
+    }
+    if let Some(job) = request.cancelled() {
+        let newer = state
+            .newer_run(request.plan.run_uid, &event.head_sha)
+            .map_err(state_error(StateStep::NewerRun))?;
+        return if newer {
+            Ok(Authentication::YieldToNewer)
+        } else {
+            Err(Refusal::Cancelled { job }.into())
+        };
+    }
+    if request.plan_job.result != JobResult::Success {
+        let result = request.plan_job.result;
+        return Err(Refusal::PlanNotSucceeded { result }.into());
+    }
+    let mut reader = Reader {
+        objects: ports.objects,
+        fetcher: Fetcher::new(ports.artifacts),
+        validator,
+    };
+    let plan = recompute::authenticate_plan(request, &mut reader)?;
+    let pulls = state
+        .pulls_on_head(&event.head_sha)
+        .map_err(state_error(StateStep::PullsOnHead))?;
+    let gates = gates::gates(request, &plan, &mut reader)?;
+    let review_documents = review_documents(request, &plan, &mut reader.fetcher)?;
+    let AuthenticPlan {
+        recomputed,
+        artifact_names,
+        tier,
+    } = plan;
+    Ok(Authentication::Authenticated(Box::new(AuthenticatedRun {
+        run_key: recomputed.run_key,
+        artifact_names,
+        policy: policy(recomputed.config.plugins.assay()),
+        tiering: recomputed.tiering,
+        tier,
+        // The run owns its base ref; the request keeps its own.
+        base_ref: event.base_ref.clone(),
+        open_prs_on_head: open_prs_on_head(&pulls, event),
+        gates: gates.reports,
+        gate_findings: gates.findings,
+        review_documents,
+    })))
+}
+
+/// Wraps a state port error from `step`, for `map_err`.
+const fn state_error<O, S, A>(step: StateStep) -> impl FnOnce(S) -> Halt<O, S, A> {
+    move |source| Halt::Failed(DecideError::State { step, source })
+}
+
+/// Which of the PR's refs moved from what the run was planned for.
+fn moved(event: &PullRequestEvent, current: &CurrentPullRequest) -> Option<Moved> {
+    match (
+        current.head_sha != event.head_sha,
+        current.base_ref != event.base_ref,
+    ) {
+        (false, false) => None,
+        (true, false) => Some(Moved::Head),
+        (false, true) => Some(Moved::BaseRef),
+        (true, true) => Some(Moved::HeadAndBaseRef),
+    }
+}
+
+/// Open PRs on the head into the PR's base: the PR itself, even if the listing lags, plus every
+/// other open one, each number counted once.
+fn open_prs_on_head(pulls: &[PullOnHead], event: &PullRequestEvent) -> u32 {
+    let others: BTreeSet<NonZeroU64> = pulls
+        .iter()
+        .filter(|pull| pull.open && pull.base_ref == event.base_ref && pull.number != event.number)
+        .map(|pull| pull.number)
+        .collect();
+    // More PRs than `u32::MAX` are still more than one.
+    u32::try_from(others.len())
+        .unwrap_or(u32::MAX)
+        .saturating_add(1)
+}
+
+/// The `review` job's documents, each authenticated by the digest the job published.
+fn review_documents<O, S, A: RunArtifacts>(
+    request: &DecideRequest,
+    plan: &AuthenticPlan,
+    fetcher: &mut Fetcher<'_, A>,
+) -> Result<Vec<Vec<u8>>, Halt<O, S, A::Error>> {
+    let documents = &request.review.documents;
+    let refuse = |problem| Refusal::Outputs {
+        job: UpstreamJob::Review,
+        problem,
+    };
+    if documents.len() > MAX_REVIEW_DOCUMENTS {
+        return Err(refuse(OutputsProblem::TooManyDocuments).into());
+    }
+    let mut files = BTreeSet::new();
+    for document in documents {
+        if !is_document_name(&document.file) {
+            return Err(refuse(OutputsProblem::FileName).into());
+        }
+        if !files.insert(document.file.as_str()) {
+            return Err(refuse(OutputsProblem::DuplicateFile).into());
+        }
+    }
+    let job = ArtifactJob::Review;
+    let Some(name) = plan.artifact_names.get(&job) else {
+        return Err(PlanMismatch::ArtifactNames.into());
+    };
+    let artifact = Artifact { job, name };
+    documents
+        .iter()
+        .map(|document| {
+            let file = &document.file;
+            let unreadable = |why| Refusal::ArtifactUnreadable {
+                job,
+                // The refusal names the file it could not read.
+                file: file.clone(),
+                why,
+            };
+            match fetcher.fetch(artifact, file, &document.digest)? {
+                Fetch::Authentic(bytes) => Ok(bytes),
+                Fetch::Missing => Err(unreadable(Unreadable::Missing).into()),
+                Fetch::TooLarge => Err(unreadable(Unreadable::TooLarge).into()),
+                Fetch::Tampered => Err(Refusal::ArtifactDigest {
+                    job,
+                    file: file.clone(),
+                }
+                .into()),
+            }
+        })
+        .collect()
+}
+
+/// Whether `file` is a lowercase name of letters, digits and `-` (1 to 64 bytes, starting with
+/// a letter or digit) followed by `.json`: never a path.
+fn is_document_name(file: &str) -> bool {
+    file.strip_suffix(".json").is_some_and(|stem| {
+        stem.len() <= 64
+            && stem
+                .bytes()
+                .next()
+                .is_some_and(|first| first.is_ascii_lowercase() || first.is_ascii_digit())
+            && stem
+                .bytes()
+                .all(|byte| byte.is_ascii_lowercase() || byte.is_ascii_digit() || byte == b'-')
+    })
+}
+
+/// Base policy as the rubric reads it.
+fn policy(settings: &AssaySettings) -> Policy {
+    let llm = |promotion| match promotion {
+        Promotion::Advisory => LlmPolicy::Advisory,
+        Promotion::Block => LlmPolicy::Block,
+    };
+    Policy {
+        // The policy owns its list; the configuration keeps its own.
+        protected_bases: settings.protected_bases.clone(),
+        llm_blockers: llm(settings.llm_blockers),
+        llm_majors: llm(settings.llm_majors),
+        on_infra_failure: match settings.on_infra_failure {
+            InfraFailurePolicy::Warn => InfraPolicy::Warn,
+            InfraFailurePolicy::Block => InfraPolicy::Block,
+        },
+        block_on_infra_for: settings
+            .block_on_infra_for
+            .iter()
+            .map(|class| match class {
+                config::PrClass::TrustPath => PrClass::TrustPath,
+                config::PrClass::ExecSurface => PrClass::ExecSurface,
+            })
+            .collect(),
+    }
+}
diff --git a/crates/assay-app/src/decide/evidence.rs b/crates/assay-app/src/decide/evidence.rs
new file mode 100644
index 0000000..7394280
--- /dev/null
+++ b/crates/assay-app/src/decide/evidence.rs
@@ -0,0 +1,244 @@
+//! Gate findings with Z4's own evidence and fingerprint (03 §3: no producer-supplied `fp`;
+//! 03 §2.1 step 6: a gate's evidence is the tree's line at its `file:line`).
+//!
+//! A finding is *verified* when its file and line exist on its side and that line, normalised,
+//! is the first line of content of its evidence. Its evidence is then replaced by the tree's line
+//! and its fingerprint is taken over it, in its enclosing function, with its occurrence index.
+//! Any other finding keeps its evidence and is fingerprinted at file scope, and its rule is
+//! dropped, so no waiver can clear it (fail closed): a gate's synthesised spot, a deleted file,
+//! a file past the read budget, or a quote the tree does not hold.
+
+use std::collections::{BTreeMap, BTreeSet, HashMap};
+
+use assay_domain::{FileChange, Finding, Fingerprint, Side, normalise};
+
+use super::DecideError;
+use crate::config::CommitId;
+use crate::plan::{EntryKind, PullRequestObjects, TreeEntry};
+use crate::validation::enclosing_functions;
+
+/// The most distinct files read for gate evidence in one run (H-13).
+pub(super) const MAX_EVIDENCE_FILES: usize = 1_000;
+
+/// The most bytes read for gate evidence in one run, charged by listed size before the read.
+pub(super) const MAX_EVIDENCE_BYTES: u64 = 64 << 20;
+
+/// The most characters evidence may hold (`findings-1.schema.json`).
+const MAX_EVIDENCE_CHARS: usize = 400;
+
+/// The texts gate findings cite, as far as the budget reads, with renames resolved.
+#[derive(Debug, Default)]
+pub(super) struct Texts {
+    head: BTreeMap<String, String>,
+    base: BTreeMap<String, String>,
+    /// Head path by base path, for files the change renamed.
+    renamed: BTreeMap<String, String>,
+}
+
+/// The paths gate findings cite, by side.
+#[derive(Debug, Default)]
+pub(super) struct Cited<'f> {
+    head: BTreeSet<&'f str>,
+    base: BTreeSet<&'f str>,
+}
+
+impl<'f> Cited<'f> {
+    /// Adds the file `finding` cites on its side (head unless it says base).
+    pub(super) fn add(&mut self, finding: &'f Finding) {
+        let paths = match finding.side.unwrap_or(Side::Right) {
+            Side::Right => &mut self.head,
+            Side::Left => &mut self.base,
+        };
+        paths.insert(finding.file.as_str());
+    }
+}
+
+/// Reads the files `cited` names on each side, head first and in path order, until the budget
+/// is spent.
+pub(super) fn read_texts<O: PullRequestObjects, S, A>(
+    objects: &O,
+    (base, head): (&CommitId, &CommitId),
+    files: &[FileChange],
+    cited: &Cited<'_>,
+) -> Result<Texts, DecideError<O::Error, S, A>> {
+    let mut budget = Budget {
+        files: MAX_EVIDENCE_FILES,
+        bytes: MAX_EVIDENCE_BYTES,
+    };
+    let renamed = files
+        .iter()
+        .filter_map(|file| {
+            let from = file.renamed_from.as_ref()?;
+            // The map owns both paths; the change keeps its own.
+            Some((from.clone(), file.path.clone()))
+        })
+        .collect();
+    let head = side_texts(objects, head, cited.head.iter().copied(), &mut budget)?;
+    let base = side_texts(objects, base, cited.base.iter().copied(), &mut budget)?;
+    Ok(Texts {
+        head,
+        base,
+        renamed,
+    })
+}
+
+/// What the evidence reads may still spend.
+struct Budget {
+    files: usize,
+    bytes: u64,
+}
+
+/// The UTF-8 regular files among `paths` at `commit` that fit the budget, read in one batch.
+fn side_texts<'p, O: PullRequestObjects, S, A>(
+    objects: &O,
+    commit: &CommitId,
+    paths: impl Iterator<Item = &'p str>,
+    budget: &mut Budget,
+) -> Result<BTreeMap<String, String>, DecideError<O::Error, S, A>> {
+    let mut paths = paths.peekable();
+    if paths.peek().is_none() {
+        return Ok(BTreeMap::new());
+    }
+    let listed = objects.list(commit, None).map_err(DecideError::Objects)?;
+    let by_path: BTreeMap<&str, &TreeEntry> = listed
+        .iter()
+        .filter(|entry| entry.kind == EntryKind::File)
+        .map(|entry| (entry.path.as_str(), entry))
+        .collect();
+    let mut wanted: Vec<&TreeEntry> = Vec::new();
+    for path in paths {
+        let Some(entry) = by_path.get(path) else {
+            continue;
+        };
+        let size = entry.size.unwrap_or(u64::MAX);
+        if budget.files == 0 || size > budget.bytes {
+            break;
+        }
+        budget.files = budget.files.saturating_sub(1);
+        budget.bytes = budget.bytes.saturating_sub(size);
+        wanted.push(entry);
+    }
+    if wanted.is_empty() {
+        return Ok(BTreeMap::new());
+    }
+    let blobs = objects.read(&wanted).map_err(DecideError::Objects)?;
+    if blobs.len() != wanted.len() {
+        return Err(DecideError::ShortRead {
+            asked: wanted.len(),
+            returned: blobs.len(),
+        });
+    }
+    Ok(wanted
+        .into_iter()
+        .zip(blobs)
+        // The listing is dropped here, so the map owns its keys; a file that is not UTF-8 is not
+        // read, and its findings stay unverified.
+        .filter_map(|(entry, blob)| Some((entry.path.clone(), String::from_utf8(blob).ok()?)))
+        .collect())
+}
+
+/// One cited file, indexed once: its lines, the function each belongs to, and how many earlier
+/// lines of that function normalise alike.
+struct Indexed<'t> {
+    lines: Vec<&'t str>,
+    functions: Vec<&'t str>,
+    occurrences: Vec<u32>,
+}
+
+impl<'t> Indexed<'t> {
+    fn of(text: &'t str) -> Self {
+        let lines: Vec<&str> = text.lines().collect();
+        let functions = enclosing_functions(text);
+        let mut seen: HashMap<(&str, String), u32> = HashMap::new();
+        let occurrences = lines
+            .iter()
+            .zip(&functions)
+            .map(|(line, function)| {
+                let count = seen.entry((*function, normalise(line))).or_insert(0);
+                let earlier = *count;
+                *count = count.saturating_add(1);
+                earlier
+            })
+            .collect();
+        Self {
+            lines,
+            functions,
+            occurrences,
+        }
+    }
+}
+
+/// Anchors gate findings against the texts, indexing each file once.
+pub(super) struct Anchors<'t> {
+    texts: &'t Texts,
+    indexed: HashMap<(Side, &'t str), Indexed<'t>>,
+}
+
+impl<'t> Anchors<'t> {
+    pub(super) fn new(texts: &'t Texts) -> Self {
+        Self {
+            texts,
+            indexed: HashMap::new(),
+        }
+    }
+
+    /// `finding`'s fingerprint, with its evidence replaced and its rule kept when it is verified
+    /// and its rule dropped otherwise; `None` when not even its own evidence has content.
+    pub(super) fn anchor(&mut self, finding: &mut Finding) -> Option<Fingerprint> {
+        let side = finding.side.unwrap_or(Side::Right);
+        let (function, occurrence) =
+            if let Some((line, function, occurrence)) = self.verified(side, finding) {
+                finding.evidence = line.chars().take(MAX_EVIDENCE_CHARS).collect();
+                finding.side = Some(side);
+                (function, occurrence)
+            } else {
+                finding.rule = None;
+                ("", 0)
+            };
+        let texts: &'t Texts = self.texts;
+        let file_at_head = match side {
+            Side::Right => finding.file.as_str(),
+            Side::Left => texts
+                .renamed
+                .get(&finding.file)
+                .map_or(finding.file.as_str(), String::as_str),
+        };
+        finding
+            .anchor(file_at_head, function)
+            .fingerprint(occurrence)
+    }
+
+    /// The cited line, its function and occurrence index, when the finding is verified.
+    fn verified(&mut self, side: Side, finding: &Finding) -> Option<(&'t str, &'t str, u32)> {
+        let all: &'t Texts = self.texts;
+        let texts = match side {
+            Side::Right => &all.head,
+            Side::Left => &all.base,
+        };
+        let (path, text) = texts.get_key_value(&finding.file)?;
+        let indexed = self
+            .indexed
+            .entry((side, path.as_str()))
+            .or_insert_with(|| Indexed::of(text));
+        let index = usize::try_from(finding.line.get().checked_sub(1)?).ok()?;
+        let line = *indexed.lines.get(index)?;
+        let quoted = finding.evidence.lines().find_map(content)?;
+        if content(line)? != quoted {
+            return None;
+        }
+        Some((
+            line,
+            *indexed.functions.get(index)?,
+            *indexed.occurrences.get(index)?,
+        ))
+    }
+}
+
+/// `line` normalised, when it holds something other than blanks and wildcards.
+fn content(line: &str) -> Option<String> {
+    let normalised = normalise(line);
+    normalised
+        .chars()
+        .any(|c| c != '…' && !c.is_whitespace())
+        .then_some(normalised)
+}
diff --git a/crates/assay-app/src/decide/fetch.rs b/crates/assay-app/src/decide/fetch.rs
new file mode 100644
index 0000000..2d5226e
--- /dev/null
+++ b/crates/assay-app/src/decide/fetch.rs
@@ -0,0 +1,79 @@
+//! Reading the run's artifacts under a byte budget and authenticating each by its producing
+//! job's output digest (02 §1, F18).
+
+use super::DecideError;
+use super::ports::{Fetched, RunArtifacts};
+use crate::config::Sha256Digest;
+use crate::contract::MAX_DOCUMENT_BYTES;
+use crate::plan::ArtifactJob;
+
+/// The most bytes one `decide` run fetches across every artifact (H-13).
+pub const MAX_FETCHED_BYTES: usize = 64 << 20;
+
+/// What one fetch established.
+pub(super) enum Fetch {
+    /// The bytes, whose digest matches the producing job's output.
+    Authentic(Vec<u8>),
+    /// The file is gone.
+    Missing,
+    /// The file is larger than one document or the run's remaining budget.
+    TooLarge,
+    /// The bytes do not hash to the producing job's output: never used.
+    Tampered,
+}
+
+/// One job's artifact, by name.
+#[derive(Debug, Clone, Copy)]
+pub(super) struct Artifact<'a> {
+    /// The producing job.
+    pub(super) job: ArtifactJob,
+    /// The artifact's name, as the authenticated plan gives it.
+    pub(super) name: &'a str,
+}
+
+/// The run's artifact store with what is left of the byte budget.
+pub(super) struct Fetcher<'a, A> {
+    artifacts: &'a A,
+    remaining: usize,
+}
+
+impl<'a, A: RunArtifacts> Fetcher<'a, A> {
+    pub(super) const fn new(artifacts: &'a A) -> Self {
+        Self {
+            artifacts,
+            remaining: MAX_FETCHED_BYTES,
+        }
+    }
+
+    /// Fetches `file` of `artifact` and checks it hashes to `digest`.
+    pub(super) fn fetch<O, S>(
+        &mut self,
+        artifact: Artifact<'_>,
+        file: &str,
+        digest: &Sha256Digest,
+    ) -> Result<Fetch, DecideError<O, S, A::Error>> {
+        let limit = MAX_DOCUMENT_BYTES.min(self.remaining);
+        let fetched = self
+            .artifacts
+            .fetch(artifact.name, file, limit)
+            .map_err(|source| DecideError::Artifacts {
+                job: artifact.job,
+                file: file.to_owned(),
+                source,
+            })?;
+        Ok(match fetched {
+            Fetched::Missing => Fetch::Missing,
+            Fetched::TooLarge => Fetch::TooLarge,
+            // The adapter is held to the limit too: more than asked for is not read on.
+            Fetched::Found(bytes) if bytes.len() > limit => Fetch::TooLarge,
+            Fetched::Found(bytes) => {
+                self.remaining = self.remaining.saturating_sub(bytes.len());
+                if Sha256Digest::of(&bytes) == *digest {
+                    Fetch::Authentic(bytes)
+                } else {
+                    Fetch::Tampered
+                }
+            }
+        })
+    }
+}
diff --git a/crates/assay-app/src/decide/gates.rs b/crates/assay-app/src/decide/gates.rs
new file mode 100644
index 0000000..e74e79f
--- /dev/null
+++ b/crates/assay-app/src/decide/gates.rs
@@ -0,0 +1,317 @@
+//! Every gate the recomputed plan schedules, as `decide` reads it (04 §5 rule 1): what its job
+//! reported, its document authenticated and validated, and its findings fingerprinted by Z4. A
+//! required gate that did not report is never a pass.
+
+use std::collections::{BTreeMap, BTreeSet};
+
+use assay_domain::{
+    FindingsDocument, GateConclusion, GateFinding, GateOutcome, GateReport, SourceKind,
+    StepAttribution,
+};
+use serde_json::Value;
+
+use super::evidence::{Anchors, Cited, read_texts};
+use super::fetch::{Artifact, Fetch};
+use super::ports::RunArtifacts;
+use super::recompute::AuthenticPlan;
+use super::refusal::{OutputsProblem, Refusal};
+use super::request::{DecideRequest, GateJobOutputs, JobResult, Reported, UpstreamJob};
+use super::{Halt, Reader};
+use crate::config::{Plugin, Sha256Digest};
+use crate::contract::{Contract, ContractValidator};
+use crate::gate::{BuildJob, Conclusion, GateError, GateJob, scheduled};
+use crate::plan::{ArtifactJob, PullRequestObjects};
+
+/// The gates of a run, with the gate findings as Z4 anchored them.
+#[derive(Debug, Default)]
+pub(super) struct Gates {
+    pub(super) reports: Vec<GateReport>,
+    pub(super) findings: Vec<assay_domain::Finding>,
+}
+
+/// One scheduled gate before its findings are anchored.
+struct Pending<'p> {
+    plugin: &'p Plugin,
+    state: State,
+}
+
+/// What a gate's job and document say.
+enum State {
+    /// Settled without a document.
+    Settled(GateOutcome),
+    /// Ran, with an authenticated, schema-valid document.
+    Ran {
+        conclusion: GateConclusion,
+        findings: Vec<assay_domain::Finding>,
+    },
+}
+
+/// Reads every scheduled gate of every gates job.
+pub(super) fn gates<O: PullRequestObjects, S, A: RunArtifacts>(
+    request: &DecideRequest,
+    plan: &AuthenticPlan,
+    reader: &mut Reader<'_, O, A>,
+) -> Result<Gates, Halt<O::Error, S, A::Error>> {
+    let jobs = [
+        (GateJob::Static, &request.gates_static),
+        (GateJob::Build(BuildJob::Lint), &request.gates_lint),
+        (GateJob::Build(BuildJob::Test), &request.gates_test),
+    ];
+    let mut pending = Vec::new();
+    for (job, outputs) in jobs {
+        let plugins: Vec<&Plugin> = plan
+            .recomputed
+            .config
+            .plugins
+            .plugins()
+            .iter()
+            .filter(|plugin| scheduled(plugin, job))
+            .collect();
+        let reports = reports_by_plugin(job, outputs, &plugins)?;
+        let artifact = plan
+            .artifact_names
+            .get(&artifact_job(job))
+            .map(|name| Artifact {
+                job: artifact_job(job),
+                name,
+            });
+        for plugin in plugins {
+            let state = match (reports.get(plugin.name().as_str()), artifact) {
+                (
+                    Some(Reported::Concluded {
+                        conclusion,
+                        document,
+                    }),
+                    Some(artifact),
+                ) => {
+                    let reported = Report {
+                        conclusion: *conclusion,
+                        artifact,
+                        digest: document,
+                    };
+                    documented(&reported, plugin, reader)?
+                }
+                (Some(Reported::Error(error)), _) => State::Settled(errored(&error.detail())),
+                (Some(Reported::Concluded { .. }), None) | (None, _) => {
+                    State::Settled(unreported(outputs.result))
+                }
+            };
+            pending.push(Pending { plugin, state });
+        }
+    }
+    anchored(request, plan, reader.objects, pending)
+}
+
+/// What a gate's job reported with a document: its conclusion, the job's artifact and the
+/// digest the job published for the document.
+struct Report<'r> {
+    conclusion: Conclusion,
+    artifact: Artifact<'r>,
+    digest: &'r Sha256Digest,
+}
+
+/// The state of a gate whose job `reported` a document. A document whose bytes are not the
+/// published ones refuses the run (F18).
+fn documented<O: PullRequestObjects, S, A: RunArtifacts>(
+    reported: &Report<'_>,
+    plugin: &Plugin,
+    reader: &mut Reader<'_, O, A>,
+) -> Result<State, Halt<O::Error, S, A::Error>> {
+    let file = format!("{}.json", plugin.name());
+    let fetched = reader
+        .fetcher
+        .fetch(reported.artifact, &file, reported.digest)?;
+    let bytes = match fetched {
+        Fetch::Authentic(bytes) => bytes,
+        Fetch::Tampered => {
+            let job = reported.artifact.job;
+            return Err(Refusal::ArtifactDigest { job, file }.into());
+        }
+        Fetch::Missing => return Ok(State::Settled(errored("artifact-missing"))),
+        Fetch::TooLarge => {
+            let detail = GateError::DocumentTooLarge.detail();
+            return Ok(State::Settled(errored(&detail)));
+        }
+    };
+    Ok(read_document(
+        &bytes,
+        plugin,
+        reported.conclusion,
+        reader.validator,
+    ))
+}
+
+/// The job's reports by plugin, refusing outputs that name a plugin base config does not
+/// schedule there, name one twice, or come from a skipped job.
+fn reports_by_plugin<'o>(
+    job: GateJob,
+    outputs: &'o GateJobOutputs,
+    plugins: &[&Plugin],
+) -> Result<BTreeMap<&'o str, &'o Reported>, Refusal> {
+    let refuse = |problem| Refusal::Outputs {
+        job: upstream_job(job),
+        problem,
+    };
+    if outputs.result == JobResult::Skipped && !outputs.gates.is_empty() {
+        return Err(refuse(OutputsProblem::SkippedJobReported));
+    }
+    let known: BTreeSet<&str> = plugins
+        .iter()
+        .map(|plugin| plugin.name().as_str())
+        .collect();
+    let mut reports = BTreeMap::new();
+    for report in &outputs.gates {
+        let plugin = report.plugin.as_str();
+        if !known.contains(plugin) {
+            return Err(refuse(OutputsProblem::UnknownPlugin));
+        }
+        if reports.insert(plugin, &report.reported).is_some() {
+            return Err(refuse(OutputsProblem::DuplicatePlugin));
+        }
+    }
+    Ok(reports)
+}
+
+/// A gate its job did not report: skipped when the job was, an error when the job failed
+/// before reporting it, and skipped when the job succeeded without it.
+fn unreported(result: JobResult) -> GateOutcome {
+    match result {
+        JobResult::Failure => errored("job-failed"),
+        JobResult::Success | JobResult::Skipped | JobResult::Cancelled => GateOutcome::Skipped,
+    }
+}
+
+fn errored(detail: &str) -> GateOutcome {
+    GateOutcome::Error {
+        detail: detail.to_owned(),
+    }
+}
+
+/// The state of a gate from its authenticated document: `invalid-document` unless it is a
+/// schema-valid gate document from `plugin` whose conclusion agrees with the job's, where a
+/// failure on either side is a failure.
+fn read_document(
+    bytes: &[u8],
+    plugin: &Plugin,
+    reported: Conclusion,
+    validator: &ContractValidator,
+) -> State {
+    let invalid = || State::Settled(errored(&GateError::InvalidDocument.detail()));
+    let Some(document) = validator
+        .read(Contract::Findings, bytes)
+        .ok()
+        .and_then(|value| gate_document(value, plugin))
+    else {
+        return invalid();
+    };
+    let Some(written) = document.conclusion else {
+        return invalid();
+    };
+    let conclusion = match (conclusion(reported), written) {
+        (GateConclusion::Fail, _) | (_, GateConclusion::Fail) => GateConclusion::Fail,
+        (from_job, written) if from_job == written => written,
+        // The job and the document disagree on a conclusion that is not a failure.
+        _ => return invalid(),
+    };
+    State::Ran {
+        conclusion,
+        findings: document.findings,
+    }
+}
+
+/// A schema-valid document as `plugin`'s gate document, if it is one.
+fn gate_document(value: Value, plugin: &Plugin) -> Option<FindingsDocument> {
+    let document: FindingsDocument = serde_json::from_value(value).ok()?;
+    (document.source.kind == SourceKind::Gate && document.source.name == plugin.name().as_str())
+        .then_some(document)
+}
+
+const fn conclusion(conclusion: Conclusion) -> GateConclusion {
+    match conclusion {
+        Conclusion::Pass => GateConclusion::Pass,
+        Conclusion::Fail => GateConclusion::Fail,
+        Conclusion::Neutral => GateConclusion::Neutral,
+    }
+}
+
+/// The reports, with every finding of a gate that ran anchored on the trees.
+fn anchored<O: PullRequestObjects, S, A>(
+    request: &DecideRequest,
+    plan: &AuthenticPlan,
+    objects: &O,
+    pending: Vec<Pending<'_>>,
+) -> Result<Gates, Halt<O::Error, S, A>> {
+    let mut cited = Cited::default();
+    for gate in &pending {
+        if let State::Ran { findings, .. } = &gate.state {
+            for finding in findings {
+                cited.add(finding);
+            }
+        }
+    }
+    let pull_request = &request.plan.pull_request;
+    let texts = read_texts(
+        objects,
+        (&pull_request.base_sha, &pull_request.head_sha),
+        &plan.recomputed.files,
+        &cited,
+    )?;
+    let mut anchors = Anchors::new(&texts);
+    let mut gates = Gates::default();
+    for gate in pending {
+        let (outcome, findings) = match gate.state {
+            State::Settled(outcome) => (outcome, Vec::new()),
+            State::Ran {
+                conclusion,
+                mut findings,
+            } => {
+                let outcome = GateOutcome::Ran {
+                    conclusion,
+                    steps: StepAttribution::Unknown,
+                };
+                let fingerprints: Option<Vec<GateFinding>> = findings
+                    .iter_mut()
+                    .map(|finding| {
+                        let fp = anchors.anchor(finding)?;
+                        Some(GateFinding {
+                            fp,
+                            // The report and the anchored finding each own the rule.
+                            rule: finding.rule.clone(),
+                            severity: finding.severity,
+                        })
+                    })
+                    .collect();
+                match fingerprints {
+                    Some(reported) => {
+                        gates.findings.append(&mut findings);
+                        (outcome, reported)
+                    }
+                    None => (errored("evidence-missing"), Vec::new()),
+                }
+            }
+        };
+        gates.reports.push(GateReport {
+            name: gate.plugin.name().to_string(),
+            required: gate.plugin.required(),
+            outcome,
+            findings,
+        });
+    }
+    Ok(gates)
+}
+
+const fn artifact_job(job: GateJob) -> ArtifactJob {
+    match job {
+        GateJob::Static => ArtifactJob::GatesStatic,
+        GateJob::Build(BuildJob::Lint) => ArtifactJob::GatesLint,
+        GateJob::Build(BuildJob::Test) => ArtifactJob::GatesTest,
+    }
+}
+
+const fn upstream_job(job: GateJob) -> UpstreamJob {
+    match job {
+        GateJob::Static => UpstreamJob::GatesStatic,
+        GateJob::Build(BuildJob::Lint) => UpstreamJob::GatesLint,
+        GateJob::Build(BuildJob::Test) => UpstreamJob::GatesTest,
+    }
+}
diff --git a/crates/assay-app/src/decide/ports.rs b/crates/assay-app/src/decide/ports.rs
new file mode 100644
index 0000000..27952db
