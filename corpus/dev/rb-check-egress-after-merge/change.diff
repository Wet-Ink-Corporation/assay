@@ -0,0 +1,36 @@
+//! The one port local mode adds to those `plan`, `gate` and the model runner define: the
+//! change's unified diff, file by file.
+
+use assay_domain::FileChange;
+
+use crate::config::CommitId;
+use crate::validation::Hunk;
+
+/// One changed file's unified diff and its hunks, as git prints them over `base...head` with
+/// rename detection and three lines of context (what GitHub shows of a PR).
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct FilePatch {
+    /// The diff text, for the review's context pack; empty for an unchanged file.
+    pub text: String,
+    /// Its `@@ -base +head @@` hunks, for validation's placement; none for a binary file.
+    pub hunks: Vec<Hunk>,
+}
+
+/// The change's patches, read as data (nothing is checked out or run).
+pub trait ChangePatches {
+    /// Why the patches could not be read.
+    type Error: std::error::Error;
+
+    /// The patch of each of `files` over `base...head`, in the same order: a renamed file's
+    /// covers both its paths.
+    ///
+    /// # Errors
+    ///
+    /// [`Self::Error`] when a diff cannot be produced or read.
+    fn patches(
+        &self,
+        base: &CommitId,
+        head: &CommitId,
+        files: &[FileChange],
+    ) -> Result<Vec<FilePatch>, Self::Error>;
+}
diff --git a/crates/assay-app/src/check/report.rs b/crates/assay-app/src/check/report.rs
new file mode 100644
index 0000000..59e7cc5
--- /dev/null
+++ b/crates/assay-app/src/check/report.rs
@@ -0,0 +1,248 @@
+//! The local report: what `assay check --local` writes to `.git/assay/<tree>.json` and shows in
+//! the terminal.
+//!
+//! It is not a contract. Its `schema` is `assay.local-check/1`, which no schema in `schemas/`
+//! describes and [`ContractValidator`](crate::ContractValidator) refuses for every contract, and
+//! it says `advisory: true`: CI never reads it (R-10, P9).
+
+use assay_domain::{Aeu, Decision, Finding, Tier};
+use serde::{Serialize, Serializer};
+
+use super::gates::LocalGate;
+use super::review::{Reviewed, Stage};
+use crate::prompt_bundle::Role;
+use crate::publish::clean;
+
+/// The local report's own schema name: never a contract's.
+pub(super) const SCHEMA: &str = "assay.local-check/1";
+
+/// The terminal report's first line.
+const BANNER: &str = "assay check --local: advisory, CI never reads this report";
+
+/// How the local review went.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum ReviewStatus {
+    /// The tier has no LLM stage.
+    NotRun,
+    /// The model returned structured output, validated as `decide` validates it.
+    Completed,
+    /// The call ran out of budget, turns or time, or its output stayed malformed after the retry.
+    Degraded,
+    /// No usable call could be made: the CLI did not start, the session was not confined, or
+    /// the context pack was not a valid prompt.
+    Unavailable,
+}
+
+/// The local review as the report shows it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct LocalReview {
+    /// How it went.
+    pub status: ReviewStatus,
+    /// The role that reviewed; `None` when the tier has no LLM stage.
+    pub role: Option<Role>,
+    /// Why it did not complete, or what validation refused, in assay's words.
+    pub note: Option<String>,
+    /// The findings that survived validation; their free text is the model's.
+    pub findings: Vec<Finding>,
+    /// What the attempts cost; a call whose cost is unknown is charged its cap.
+    pub cost: Aeu,
+}
+
+/// [`LocalReview`] as JSON: the role by its code and the cost as AEU text (`0.12`).
+#[derive(Serialize)]
+struct ShownReview<'r> {
+    status: ReviewStatus,
+    role: Option<&'static str>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    note: Option<&'r str>,
+    findings: &'r [Finding],
+    cost: String,
+}
+
+impl Serialize for LocalReview {
+    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        ShownReview {
+            status: self.status,
+            role: self.role.map(Role::code),
+            note: self.note.as_deref(),
+            findings: &self.findings,
+            cost: self.cost.to_string(),
+        }
+        .serialize(serializer)
+    }
+}
+
+/// The advisory result of `assay check --local`.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct LocalReport {
+    /// Always [`SCHEMA`].
+    pub(super) schema: &'static str,
+    /// Always `true`.
+    pub(super) advisory: bool,
+    pub(super) tree: String,
+    /// The base commit and the snapshot commit.
+    pub(super) base: String,
+    pub(super) head: String,
+    pub(super) tier: Tier,
+    pub(super) gates: Vec<LocalGate>,
+    pub(super) review: LocalReview,
+    pub(super) decision: Decision,
+}
+
+impl LocalReport {
+    /// The tree fingerprint the report is about.
+    #[must_use]
+    pub fn tree(&self) -> &str {
+        &self.tree
+    }
+
+    /// The tier `plan` computed for the working tree.
+    #[must_use]
+    pub const fn tier(&self) -> Tier {
+        self.tier
+    }
+
+    /// Every scheduled gate, in job then file order.
+    #[must_use]
+    pub fn gates(&self) -> &[LocalGate] {
+        &self.gates
+    }
+
+    /// The review.
+    #[must_use]
+    pub const fn review(&self) -> &LocalReview {
+        &self.review
+    }
+
+    /// What the rubric decided from the local inputs.
+    #[must_use]
+    pub const fn decision(&self) -> &Decision {
+        &self.decision
+    }
+
+    /// The report as pretty JSON ending in a newline, for `.git/assay/<tree>.json`.
+    ///
+    /// # Errors
+    ///
+    /// [`serde_json::Error`] when it cannot be encoded.
+    pub fn to_json(&self) -> Result<Vec<u8>, serde_json::Error> {
+        let mut json = serde_json::to_vec_pretty(self)?;
+        json.push(b'\n');
+        Ok(json)
+    }
+
+    /// The report for a terminal: one item per line, every gate, model and path text on one
+    /// line with its control and format characters replaced, so nothing it quotes can move the
+    /// cursor, clear the screen or reorder the text.
+    #[must_use]
+    pub fn render(&self) -> String {
+        let mut lines = vec![
+            BANNER.to_owned(),
+            ["tree ", &clean(&self.tree), ", tier ", self.tier.code()].concat(),
+            "gates:".to_owned(),
+        ];
+        if self.gates.is_empty() {
+            lines.push("  none scheduled".to_owned());
+        }
+        for gate in &self.gates {
+            let mut line = [
+                "  ",
+                &clean(&gate.outcome),
+                " ",
+                &clean(&gate.name),
+                " (",
+                gate.job,
+                ")",
+            ]
+            .concat();
+            if let Some(cause) = &gate.cause {
+                line.extend([": ", &clean(cause)]);
+            }
+            lines.push(line);
+            lines.extend(
+                gate.findings
+                    .iter()
+                    .map(|finding| finding_line("    ", finding)),
+            );
+        }
+        let review = &self.review;
+        let mut line = ["review: ", status_code(review.status)].concat();
+        if let Some(role) = review.role {
+            line.extend([" (", role.code(), ", ", &review.cost.to_string(), " AEU)"]);
+        }
+        if let Some(note) = &review.note {
+            line.extend([": ", &clean(note)]);
+        }
+        lines.push(line);
+        lines.extend(
+            review
+                .findings
+                .iter()
+                .map(|finding| finding_line("  ", finding)),
+        );
+        lines.push(["decision: ", self.decision.conclusion.code()].concat());
+        for reason in &self.decision.reasons {
+            lines.push(["  ", reason.code.code(), ": ", &clean(&reason.detail)].concat());
+        }
+        for degraded in &self.decision.degraded {
+            let (role, why) = (clean(&degraded.role), clean(&degraded.reason));
+            lines.push(["  degraded ", &role, ": ", &why].concat());
+        }
+        let mut text = lines.join("\n");
+        text.push('\n');
+        text
+    }
+}
+
+/// The review part of the report and the decision, from how the review went.
+pub(super) fn review(reviewed: Option<(Role, Reviewed)>) -> LocalReview {
+    let Some((role, reviewed)) = reviewed else {
+        return LocalReview {
+            status: ReviewStatus::NotRun,
+            role: None,
+            note: None,
+            findings: Vec::new(),
+            cost: Aeu::ZERO,
+        };
+    };
+    let (status, findings) = match reviewed.stage {
+        Stage::Completed(valid) => (
+            ReviewStatus::Completed,
+            valid.into_iter().map(|valid| valid.finding).collect(),
+        ),
+        Stage::Degraded(_) => (ReviewStatus::Degraded, Vec::new()),
+        Stage::Unavailable => (ReviewStatus::Unavailable, Vec::new()),
+    };
+    LocalReview {
+        status,
+        role: Some(role),
+        note: reviewed.note,
+        findings,
+        cost: reviewed.cost,
+    }
+}
+
+/// `<indent><severity> <file>:<line> <title>`.
+fn finding_line(indent: &str, finding: &Finding) -> String {
+    [
+        indent,
+        finding.severity.code(),
+        " ",
+        &clean(&finding.file),
+        ":",
+        &finding.line.to_string(),
+        " ",
+        &clean(&finding.title),
+    ]
+    .concat()
+}
+
+const fn status_code(status: ReviewStatus) -> &'static str {
+    match status {
+        ReviewStatus::NotRun => "not-run",
+        ReviewStatus::Completed => "completed",
+        ReviewStatus::Degraded => "degraded",
+        ReviewStatus::Unavailable => "unavailable",
+    }
+}
diff --git a/crates/assay-app/src/check/review.rs b/crates/assay-app/src/check/review.rs
new file mode 100644
index 0000000..5d630c2
--- /dev/null
+++ b/crates/assay-app/src/check/review.rs
@@ -0,0 +1,207 @@
+//! The local review: one model call with the tier's role, its output stamped with assay's own
+//! `source` and validated as `decide` validates a review job's documents (04 §4).
+//!
+//! The v1 bundle has two instructions, so `micro` is reviewed by `combined-micro` and `lite` and
+//! `full` by `combined`; a `full` PR's specialist roster is the review job's (#85), and the
+//! decision reports those roles missing.
+
+use assay_domain::{Aeu, CallFailure, Disposition, Finding, FindingsSchema, SourceKind, Tier};
+use serde_json::{Map, Value, json};
+
+use super::ReviewSetup;
+use crate::contract::{Contract, ContractValidator};
+use crate::model_runner::{
+    ModelAttempts, ModelCall, ModelOutcome, ModelResult, ModelRunner, RetryError, run_with_retry,
+};
+use crate::plan::EvidenceKey;
+use crate::prompt_bundle::Role;
+use crate::session_init::{CLEAN_TOOLS, InitReadError, SessionInit};
+use crate::validation::{Change, FindingRef, Inputs, SuppressRules, ValidFinding, validate};
+
+/// The reviewer name local mode stamps on its document.
+const REVIEWER: &str = "assay-local";
+
+/// The role that reviews `tier`; `None` for a tier without an LLM stage.
+pub(super) const fn role(tier: Tier) -> Option<Role> {
+    match tier {
+        Tier::Micro => Some(Role::CombinedMicro),
+        Tier::Lite | Tier::Full => Some(Role::Combined),
+        Tier::Trivial | Tier::NeedsSplit => None,
+    }
+}
+
+/// No base `suppress` rules: local mode has no parser for them yet, so it shows every finding.
+struct NoSuppression;
+
+impl SuppressRules for NoSuppression {
+    fn suppresses(&self, _finding: &Finding, _file_at_head: &str) -> bool {
+        false
+    }
+}
+
+/// What the review's document is validated against: the change, and the gate findings, as in
+/// Z4. There are no owner dismissals locally.
+pub(super) fn inputs<'a>(
+    repository: &'a str,
+    change: &'a Change,
+    gate_findings: &'a [Finding],
+) -> Inputs<'a> {
+    Inputs {
+        repository,
+        change,
+        suppress: &NoSuppression,
+        dismissals: &[],
+        gate_findings,
+    }
+}
+
+/// How the review ended.
+#[derive(Debug)]
+pub(super) enum Stage {
+    /// The model returned structured output; these findings survived validation.
+    Completed(Vec<ValidFinding>),
+    /// The call ran and produced nothing usable.
+    Degraded(CallFailure),
+    /// No usable call could be made.
+    Unavailable,
+}
+
+/// The review's outcome, with what the report says about it.
+#[derive(Debug)]
+pub(super) struct Reviewed {
+    pub(super) stage: Stage,
+    /// Why it did not complete, or what validation refused, in assay's words.
+    pub(super) note: Option<String>,
+    /// Every attempt's cost; a call whose cost is unknown is charged its cap.
+    pub(super) cost: Aeu,
+}
+
+impl Reviewed {
+    fn unavailable(note: String, cost: Aeu) -> Self {
+        Self {
+            stage: Stage::Unavailable,
+            note: Some(note),
+            cost,
+        }
+    }
+
+    fn degraded(failure: CallFailure, cost: Aeu) -> Self {
+        Self {
+            stage: Stage::Degraded(failure),
+            note: Some(format!("the review degraded: {}", failure.code())),
+            cost,
+        }
+    }
+}
+
+/// Makes the review's call.
+pub(super) struct Reviewer<'a, M> {
+    pub(super) setup: &'a ReviewSetup<'a>,
+    pub(super) model: &'a M,
+    pub(super) validator: &'a ContractValidator,
+    pub(super) run_key: EvidenceKey,
+}
+
+impl<M: ModelRunner> Reviewer<'_, M> {
+    /// Reviews the change `pack` describes as `role`, validating the output against `inputs`.
+    ///
+    /// # Errors
+    ///
+    /// [`serde_json::Error`] when the stamped document cannot be encoded.
+    pub(super) fn review(
+        &self,
+        role: Role,
+        pack: &str,
+        inputs: &Inputs<'_>,
+    ) -> Result<Reviewed, serde_json::Error> {
+        let Ok(user_prompt) = self.setup.bundle.user_prompt(role, pack) else {
+            let note = "the context pack is not a valid prompt".to_owned();
+            return Ok(Reviewed::unavailable(note, Aeu::ZERO));
+        };
+        let call = ModelCall {
+            system_prompt_file: self.setup.system_prompt_file.to_path_buf(),
+            user_prompt,
+            json_schema: Contract::Findings.schema_text().to_owned(),
+            add_dir: self.setup.tree_dir.to_path_buf(),
+            max_turns: role.max_turns(),
+            budget: role.cap(),
+            timeout: self.setup.timeout,
+        };
+        let attempts = match run_with_retry(self.model, &call) {
+            Ok(attempts) => attempts,
+            Err(RetryError::First(error)) => {
+                return Ok(Reviewed::unavailable(error.to_string(), role.cap()));
+            }
+            Err(RetryError::Retry { first, source }) => {
+                let cost = first.cost.saturating_add(role.cap());
+                return Ok(Reviewed::unavailable(source.to_string(), cost));
+            }
+        };
+        let cost = attempts.cost();
+        let ModelAttempts { first, retry } = attempts;
+        let ModelResult { outcome, init, .. } = retry.unwrap_or(first);
+        if let Err(note) = confined(&init) {
+            return Ok(Reviewed::unavailable(note, cost));
+        }
+        let structured = match outcome {
+            ModelOutcome::Ok(structured) => structured,
+            ModelOutcome::Malformed => return Ok(Reviewed::degraded(CallFailure::Malformed, cost)),
+            ModelOutcome::BudgetExhausted => return Ok(Reviewed::degraded(CallFailure::Cap, cost)),
+            ModelOutcome::TurnsExhausted => {
+                return Ok(Reviewed::degraded(CallFailure::Turns, cost));
+            }
+            ModelOutcome::Timeout => return Ok(Reviewed::degraded(CallFailure::Timeout, cost)),
+            ModelOutcome::QuotaExhausted => {
+                return Ok(Reviewed::degraded(CallFailure::Unavailable, cost));
+            }
+        };
+        let document = serde_json::to_vec(&self.stamp(structured.into_value(), role))?;
+        let validated = validate(self.validator, inputs, &[document.as_slice()]);
+        let refused = validated.transitions.iter().any(|transition| {
+            matches!(transition.at, FindingRef::Document { .. })
+                && transition.code == Disposition::Schema
+        });
+        Ok(Reviewed {
+            stage: Stage::Completed(validated.findings),
+            note: refused.then(|| "the model's document failed the findings schema".to_owned()),
+            cost,
+        })
+    }
+
+    /// `output` as an `assay.findings/1` document whose `schema` and `source` are assay's: a
+    /// model-written `source` is replaced, so validation holds the findings to `role`'s
+    /// ceiling. Anything but an object is left alone, and validation refuses it.
+    fn stamp(&self, output: Value, role: Role) -> Value {
+        let mut document: Map<String, Value> = match output {
+            Value::Object(document) => document,
+            other => return other,
+        };
+        document.insert("schema".to_owned(), json!(FindingsSchema::V1.code()));
+        document.insert(
+            "source".to_owned(),
+            json!({
+                "kind": SourceKind::Reviewer.code(),
+                "name": REVIEWER,
+                "version": env!("CARGO_PKG_VERSION"),
+                "role": role.code(),
+                "run_key": self.run_key.to_string(),
+            }),
+        );
+        Value::Object(document)
+    }
+}
+
+/// Whether the session that answered was confined to `Read`, `Grep` and `Glob` with no MCP
+/// server: the part of the clean-init rule (03 §8) that holds whatever CLI version the developer
+/// runs. Its output is not used otherwise.
+fn confined(init: &Result<SessionInit, InitReadError>) -> Result<(), String> {
+    let init = init
+        .as_ref()
+        .map_err(|error| format!("the session's init could not be read: {error}"))?;
+    let mut tools: Vec<&str> = init.tools().iter().map(String::as_str).collect();
+    tools.sort_unstable();
+    if tools != CLEAN_TOOLS || !init.mcp_servers().is_empty() {
+        return Err("the session was not confined to Read, Grep and Glob".to_owned());
+    }
+    Ok(())
+}
