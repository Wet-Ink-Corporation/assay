+//! The `assay.status/1` document and its plain-text rendering.
+
+use std::num::NonZeroU64;
+
+use assay_domain::{Class, Decision, Disposition, WeighIn};
+use serde::Serialize;
+
+use super::findings::Finding;
+use super::ports::{ObservedConclusion, PullView, Viewer};
+use super::verdict::{Check, Observed};
+use super::{MAX_REASONS, StatusError, StatusRequest, StatusUnreadable};
+use crate::CommitId;
+use crate::publish::{CheckStatus, clean};
+
+/// The longest GitHub login, before a `[bot]` suffix.
+const MAX_LOGIN_BYTES: usize = 39;
+
+/// `assay.status/1`, in its schema's field order.
+#[derive(Debug, Serialize)]
+pub(super) struct Document<'a> {
+    schema: &'static str,
+    source: &'static str,
+    repo: &'a str,
+    pr: NonZeroU64,
+    branch: &'a str,
+    head_sha: &'a str,
+    local_head_sha: Option<&'a str>,
+    stale: bool,
+    check: Option<CheckEntry>,
+    decision: Option<DecisionEntry>,
+    tier: Option<&'static str>,
+    gates: Vec<GateEntry>,
+    findings: Vec<FindingEntry>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    weigh_in: Option<WeighInEntry>,
+    viewer: ViewerEntry<'a>,
+    fetched_at: &'a str,
+}
+
+#[derive(Debug, Serialize)]
+struct CheckEntry {
+    conclusion: Option<&'static str>,
+    status: &'static str,
+    url: String,
+}
+
+#[derive(Debug, Serialize)]
+struct DecisionEntry {
+    conclusion: &'static str,
+    reasons: Vec<ReasonEntry>,
+    reasons_digest: String,
+    counts: assay_domain::Counts,
+    degraded: Vec<DegradedEntry>,
+    advisory_blockers: Vec<String>,
+}
+
+#[derive(Debug, Serialize)]
+struct ReasonEntry {
+    code: &'static str,
+    detail: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    fp: Option<String>,
+}
+
+#[derive(Debug, Serialize)]
+struct DegradedEntry {
+    role: String,
+    reason: String,
+}
+
+#[derive(Debug, Serialize)]
+struct GateEntry {
+    plugin: String,
+    conclusion: Option<&'static str>,
+    url: String,
+}
+
+#[derive(Debug, Serialize)]
+struct FindingEntry {
+    fp: String,
+    finding_id: String,
+    severity: &'static str,
+    class: Option<&'static str>,
+    title: Option<String>,
+    file: Option<String>,
+    line: Option<NonZeroU64>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    url: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    disposition: Option<&'static str>,
+    waivable: bool,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    body: Option<String>,
+}
+
+#[derive(Debug, Serialize)]
+struct WeighInEntry {
+    blocking: bool,
+    pending_triage: bool,
+}
+
+#[derive(Debug, Serialize)]
+struct ViewerEntry<'a> {
+    login: &'a str,
+    is_owner: bool,
+    is_agent: bool,
+}
+
+/// What was read for one PR, the document's facts besides the request.
+pub(super) struct Facts<'a> {
+    /// The PR.
+    pub(super) pull: &'a PullView,
+    /// Its checks, and the decision the verdict check names.
+    pub(super) observed: Observed,
+    /// The decision's findings.
+    pub(super) findings: Vec<Finding>,
+    /// Who is asking.
+    pub(super) viewer: &'a Viewer,
+}
+
+impl<'a> Document<'a> {
+    /// The document for `facts.pull`, from what was observed and read.
+    pub(super) fn new<E, B>(
+        request: &StatusRequest<'a>,
+        facts: Facts<'a>,
+    ) -> Result<Self, StatusError<E, B>> {
+        let Facts {
+            pull,
+            observed,
+            findings,
+            viewer,
+        } = facts;
+        let head_sha = pull.head_sha.as_str();
+        let local_head_sha = request.local_head.map(CommitId::as_str);
+        let (decision, tier, weigh_in) = match &observed.decided {
+            Some(decided) => (
+                Some(decision(&decided.decision)?),
+                Some(decided.inputs.pr.tier.code()),
+                weigh_in(decided.inputs.weigh_in),
+            ),
+            None => (None, None, None),
+        };
+        Ok(Self {
+            schema: "assay.status/1",
+            source: "ci",
+            repo: &request.repository.name,
+            pr: pull.number,
+            branch: &pull.head_ref,
+            head_sha,
+            local_head_sha,
+            stale: local_head_sha.is_some_and(|local| local != head_sha),
+            check: observed.check.map(check_entry),
+            decision,
+            tier,
+            gates: observed
+                .gates
+                .into_iter()
+                .map(|(plugin, check)| GateEntry {
+                    plugin: plugin.as_str().to_owned(),
+                    conclusion: check.conclusion.map(ObservedConclusion::code),
+                    url: check.url,
+                })
+                .collect(),
+            findings: findings.into_iter().map(finding_entry).collect(),
+            weigh_in,
+            viewer: viewer_entry(request, viewer).map_err(StatusError::Unreadable)?,
+            fetched_at: request.fetched_at,
+        })
+    }
+
+    /// The same facts for a person, one per line, ending in a newline.
+    pub(super) fn text(&self) -> String {
+        let local = match self.local_head_sha {
+            None => "unknown",
+            Some(_) if self.stale => "differs: this status is for another commit",
+            Some(_) => "matches",
+        };
+        let mut lines = vec![
+            format!("assay status: {} #{} ({})", self.repo, self.pr, self.branch),
+            format!("Head: {} (local HEAD {local})", self.head_sha),
+            match &self.check {
+                None => "Check: none yet".to_owned(),
+                Some(check) => format!(
+                    "Check: {} {} {}",
+                    check.status,
+                    check.conclusion.unwrap_or("-"),
+                    check.url
+                ),
+            },
+        ];
+        self.decision_lines(&mut lines);
+        lines.push(heading("Gates", self.gates.is_empty()));
+        lines.extend(self.gates.iter().map(|gate| {
+            format!(
+                "  {} {} {}",
+                gate.plugin,
+                gate.conclusion.unwrap_or("-"),
+                gate.url
+            )
+        }));
+        lines.push(heading("Findings", self.findings.is_empty()));
+        lines.extend(self.findings.iter().map(finding_line));
+        if let Some(weigh_in) = &self.weigh_in {
+            lines.push(format!(
+                "Weigh-In: blocking {}, pending triage {}",
+                yes_no(weigh_in.blocking),
+                yes_no(weigh_in.pending_triage)
+            ));
+        }
+        let role = match (self.viewer.is_owner, self.viewer.is_agent) {
+            (true, _) => "owner",
+            (false, true) => "agent",
+            (false, false) => "other",
+        };
+        lines.push(format!("Viewer: {} ({role})", self.viewer.login));
+        lines.push(format!("Fetched: {}", self.fetched_at));
+        let mut text = lines.join("\n");
+        text.push('\n');
+        text
+    }
+
+    fn decision_lines(&self, lines: &mut Vec<String>) {
+        let Some(decision) = &self.decision else {
+            lines.push("Decision: none".to_owned());
+            return;
+        };
+        lines.push(format!(
+            "Decision: {} (tier {})",
+            decision.conclusion,
+            self.tier.unwrap_or("-")
+        ));
+        lines.extend(decision.reasons.iter().map(|reason| match &reason.fp {
+            Some(fp) => format!("  reason {}: {} ({fp})", reason.code, reason.detail),
+            None => format!("  reason {}: {}", reason.code, reason.detail),
+        }));
+        let counts = decision.counts;
+        lines.push(format!(
+            "  counts: {} blocker, {} major, {} minor, {} nit",
+            counts.blocker, counts.major, counts.minor, counts.nit
+        ));
+        lines.extend(
+            decision
+                .degraded
+                .iter()
+                .map(|degraded| format!("  degraded {}: {}", degraded.role, degraded.reason)),
+        );
+        lines.extend(
+            decision
+                .advisory_blockers
+                .iter()
+                .map(|fp| format!("  advisory blocker {fp}")),
+        );
+        lines.push(format!("  reasons digest: {}", decision.reasons_digest));
+    }
+}
+
+/// `Name:`, or `Name: none` for an empty list.
+fn heading(name: &str, empty: bool) -> String {
+    if empty {
+        format!("{name}: none")
+    } else {
+        format!("{name}:")
+    }
+}
+
+/// One finding on one line: fingerprint, severity, whether it is waivable, then what was
+/// published (class, place, title) where it was. The title is cleaned onto one line.
+fn finding_line(finding: &FindingEntry) -> String {
+    let mut parts = vec![
+        "  ".to_owned() + finding.fp.as_str(),
+        finding.severity.to_owned(),
+    ];
+    if finding.waivable {
+        parts.push("waivable".to_owned());
+    }
+    if let Some(class) = finding.class {
+        parts.push(class.to_owned());
+    }
+    if let (Some(file), Some(line)) = (&finding.file, finding.line) {
+        parts.push(format!("{file}:{line}"));
+    }
+    if let Some(title) = &finding.title {
+        parts.push(clean(title));
+    }
+    parts.join(" ")
+}
+
+fn yes_no(flag: bool) -> &'static str {
+    if flag { "yes" } else { "no" }
+}
+
+fn check_entry(check: Check) -> CheckEntry {
+    CheckEntry {
+        conclusion: check.conclusion.map(ObservedConclusion::code),
+        status: match check.status {
+            CheckStatus::Queued => "queued",
+            CheckStatus::InProgress => "in_progress",
+            CheckStatus::Completed => "completed",
+        },
+        url: check.url,
+    }
+}
+
+/// The decision as published: reason details and degraded roles cleaned as the summary cleans
+/// them; refused past [`MAX_REASONS`].
+fn decision<E, B>(decision: &Decision) -> Result<DecisionEntry, StatusError<E, B>> {
+    let count = decision.reasons.len().max(decision.degraded.len());
+    if count > MAX_REASONS {
+        return Err(StatusError::TooManyReasons { count });
+    }
+    Ok(DecisionEntry {
+        conclusion: decision.conclusion.code(),
+        reasons: decision
+            .reasons
+            .iter()
+            .map(|reason| ReasonEntry {
+                code: reason.code.code(),
+                detail: clean(&reason.detail),
+                fp: reason.fp.map(|fp| fp.to_string()),
+            })
+            .collect(),
+        reasons_digest: decision.reasons_digest(),
+        counts: decision.counts,
+        degraded: decision
+            .degraded
+            .iter()
+            .map(|degraded| DegradedEntry {
+                role: clean(&degraded.role),
+                reason: clean(&degraded.reason),
+            })
+            .collect(),
+        advisory_blockers: decision
+            .advisory_blockers
+            .iter()
+            .map(ToString::to_string)
+            .collect(),
+    })
+}
+
+fn weigh_in(weigh_in: WeighIn) -> Option<WeighInEntry> {
+    match weigh_in {
+        WeighIn::NotRequired => None,
+        WeighIn::Clear | WeighIn::OpenBlocking | WeighIn::PendingTriage | WeighIn::NoEvidence => {
+            Some(WeighInEntry {
+                blocking: weigh_in == WeighIn::OpenBlocking,
+                pending_triage: weigh_in == WeighIn::PendingTriage,
+            })
+        }
+    }
+}
+
+fn finding_entry(finding: Finding) -> FindingEntry {
+    let fp = finding.fp.to_string();
+    let (class, title, file, line, url, body) = match finding.published {
+        Some(published) => (
+            published.class.map(Class::code),
+            published.title,
+            Some(published.file),
+            published.line,
+            Some(published.url),
+            published.body,
+        ),
+        None => (None, None, None, None, None, None),
+    };
+    FindingEntry {
+        // The id `/assay waive` takes is the fingerprint: the document carries both fields.
+        finding_id: fp.clone(),
+        fp,
+        severity: finding.severity.code(),
+        class,
+        title: title.or(finding.gate_title),
+        file,
+        line,
+        url,
+        disposition: finding.disposition.map(Disposition::code),
+        waivable: finding.waivable,
+        body,
+    }
+}
+
+/// The viewer, when their login reads as a GitHub login (`[bot]` allowed), with whether their
+/// id is in the privileged set and in `.assay/agents`.
+fn viewer_entry<'a>(
+    request: &StatusRequest<'_>,
+    viewer: &'a Viewer,
+) -> Result<ViewerEntry<'a>, StatusUnreadable> {
+    let login = viewer.login.as_str();
+    let name = login.strip_suffix("[bot]").unwrap_or(login);
+    let readable = name.len() <= MAX_LOGIN_BYTES
+        && name
+            .bytes()
+            .next()
+            .is_some_and(|first| first.is_ascii_alphanumeric())
+        && name
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || byte == b'-');
+    if !readable {
+        return Err(StatusUnreadable::Login);
+    }
+    Ok(ViewerEntry {
+        login,
+        is_owner: request.identities.privileged.contains(&viewer.id),
+        is_agent: request.identities.agents.contains(&viewer.id),
+    })
+}
diff --git a/crates/assay-app/src/status/findings.rs b/crates/assay-app/src/status/findings.rs
new file mode 100644
index 0000000..fd7087d
--- /dev/null
+++ b/crates/assay-app/src/status/findings.rs
@@ -0,0 +1,178 @@
+//! The decision's findings, one per fingerprint, with what the App's inline comments published
+//! about each and whether `/assay waive` may clear it.
+
+use std::collections::BTreeMap;
+use std::collections::btree_map::Entry;
+use std::num::NonZeroU64;
+
+use assay_domain::{
+    Class, DecisionInputs, Disposition, Fingerprint, Severity, waivable_fingerprints,
+};
+
+use super::ports::{PullView, StatusForge};
+use super::verdict::Decided;
+use super::{Detail, MAX_FINDINGS, StatusError, StatusRequest, StatusStep, page};
+use crate::publish::{MAX_PRIOR_COMMENTS, clean, read_published};
+
+/// The longest published body `--full` shows, in characters (the schema's cap); a longer one is
+/// left out rather than cut.
+const MAX_BODY_CHARS: usize = 16_384;
+
+/// One finding as the status lists it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(super) struct Finding {
+    pub(super) fp: Fingerprint,
+    pub(super) severity: Severity,
+    pub(super) published: Option<Published>,
+    /// What the per-gate check published for the first gate finding carrying the fingerprint:
+    /// `<plugin>: <rule>`, cleaned as the check's summary cleans it.
+    pub(super) gate_title: Option<String>,
+    pub(super) disposition: Option<Disposition>,
+    pub(super) waivable: bool,
+}
+
+/// What the App's inline comment published about a finding.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(super) struct Published {
+    pub(super) class: Option<Class>,
+    pub(super) title: Option<String>,
+    pub(super) file: String,
+    pub(super) line: Option<NonZeroU64>,
+    pub(super) url: String,
+    pub(super) body: Option<String>,
+}
+
+/// The decision's gate findings, then its reviewer findings, one entry per fingerprint at the
+/// highest severity carrying it; refused past [`MAX_FINDINGS`] before any comment is read.
+pub(super) fn findings<F: StatusForge, B>(
+    request: &StatusRequest<'_>,
+    forge: &F,
+    pull: &PullView,
+    decided: &Decided,
+) -> Result<Vec<Finding>, StatusError<F::Error, B>> {
+    let inputs = &decided.inputs;
+    let count = inputs
+        .gates
+        .iter()
+        .map(|gate| gate.findings.len())
+        .fold(inputs.findings.len(), usize::saturating_add);
+    if count > MAX_FINDINGS {
+        return Err(StatusError::TooManyFindings { count });
+    }
+    let entries = carried(inputs, count);
+    let mut published = comments(request, forge, pull)?;
+    let waivable = waivable_fingerprints(request.rubric, &inputs.gates);
+    let last_disposition: BTreeMap<Fingerprint, Disposition> = decided
+        .decision
+        .dispositions
+        .iter()
+        .map(|disposition| (disposition.fp, disposition.code))
+        .collect();
+    Ok(entries
+        .into_iter()
+        .map(|carrier| Finding {
+            fp: carrier.fp,
+            severity: carrier.severity,
+            published: published.remove(&carrier.fp),
+            gate_title: carrier.gate.map(|(gate, rule)| match rule {
+                Some(rule) => clean(&[gate, ": ", rule].concat()),
+                None => clean(gate),
+            }),
+            disposition: last_disposition.get(&carrier.fp).copied(),
+            waivable: waivable.contains(&carrier.fp),
+        })
+        .collect())
+}
+
+/// One finding the decision carries: its fingerprint, severity and, for a gate finding, its
+/// gate and rule.
+struct Carried<'a> {
+    fp: Fingerprint,
+    severity: Severity,
+    gate: Option<(&'a str, Option<&'a str>)>,
+}
+
+/// The `count` findings `inputs` carries, gate findings first, merged to one per fingerprint in
+/// first-seen order at the highest severity, keeping the first gate and rule seen.
+fn carried(inputs: &DecisionInputs, count: usize) -> Vec<Carried<'_>> {
+    let all = inputs
+        .gates
+        .iter()
+        .flat_map(|gate| {
+            gate.findings.iter().map(|finding| Carried {
+                fp: finding.fp,
+                severity: finding.severity,
+                gate: Some((gate.name.as_str(), finding.rule.as_deref())),
+            })
+        })
+        .chain(inputs.findings.iter().map(|finding| Carried {
+            fp: finding.fp,
+            severity: finding.severity,
+            gate: None,
+        }));
+    let mut entries: Vec<Carried<'_>> = Vec::with_capacity(count);
+    let mut index: BTreeMap<Fingerprint, usize> = BTreeMap::new();
+    for carrier in all {
+        match index.entry(carrier.fp) {
+            Entry::Vacant(vacant) => {
+                vacant.insert(entries.len());
+                entries.push(carrier);
+            }
+            Entry::Occupied(occupied) => {
+                if let Some(kept) = entries.get_mut(*occupied.get()) {
+                    kept.severity = kept.severity.max(carrier.severity);
+                    kept.gate = kept.gate.or(carrier.gate);
+                }
+            }
+        }
+    }
+    entries
+}
+
+/// The App's inline finding comments by fingerprint, the first for each; refused past
+/// [`MAX_PRIOR_COMMENTS`].
+fn comments<F: StatusForge, B>(
+    request: &StatusRequest<'_>,
+    forge: &F,
+    pull: &PullView,
+) -> Result<BTreeMap<Fingerprint, Published>, StatusError<F::Error, B>> {
+    let views = forge
+        .review_comments(pull.number, request.app)
+        .map_err(|source| StatusError::Forge {
+            step: StatusStep::ReviewComments,
+            source,
+        })?;
+    if views.len() > MAX_PRIOR_COMMENTS {
+        return Err(StatusError::TooManyComments { count: views.len() });
+    }
+    let repository = request.repository.name.as_str();
+    let mut published = BTreeMap::new();
+    for view in views.iter().filter(|view| view.app == Some(request.app)) {
+        let Some(comment) = read_published(&view.body) else {
+            continue;
+        };
+        if published.contains_key(&comment.fp) {
+            continue;
+        }
+        let url = page(&view.url, repository).map_err(StatusError::Unreadable)?;
+        let body = match request.detail {
+            Detail::Summary => None,
+            Detail::Full => comment
+                .rest
+                .filter(|rest| rest.chars().count() <= MAX_BODY_CHARS)
+                .map(str::to_owned),
+        };
+        published.insert(
+            comment.fp,
+            Published {
+                class: comment.class,
+                title: comment.title.map(str::to_owned),
+                file: clean(&view.path),
+                line: view.line,
+                url,
+                body,
+            },
+        );
+    }
+    Ok(published)
+}
diff --git a/crates/assay-app/src/status/ports.rs b/crates/assay-app/src/status/ports.rs
new file mode 100644
index 0000000..7ee466a
--- /dev/null
+++ b/crates/assay-app/src/status/ports.rs
@@ -0,0 +1,158 @@
+//! The one narrow read port `status` reads GitHub through, and what it returns. The run's
+//! artifacts are read through [`BundleSource`](crate::BundleSource), as replay reads them.
+
+use std::num::NonZeroU64;
+
+use crate::config::CommitId;
+use crate::publish::CheckStatus;
+
+/// What `assay status` reads from GitHub with the viewer's own `gh` token. Implemented by the
+/// forge adapter (#53). Every text it returns is untrusted: `status` validates it.
+pub trait StatusForge {
+    /// Why GitHub could not be read.
+    type Error: std::error::Error;
+
+    /// PR `number`, open or not; `None` when the repository has no such PR.
+    ///
+    /// # Errors
+    ///
+    /// [`Self::Error`] when the PR cannot be read.
+    fn pull(&self, number: NonZeroU64) -> Result<Option<PullView>, Self::Error>;
+
+    /// The open PRs of the repository whose head is `branch` of the repository itself.
+    ///
+    /// # Errors
+    ///
+    /// [`Self::Error`] when the PRs cannot be listed.
+    fn open_pulls(&self, branch: &str) -> Result<Vec<PullView>, Self::Error>;
+
+    /// Every check run on `head`, of any app, across all pages, each with the id of the app
+    /// that created it. `status` keeps only the configured App's.
+    ///
+    /// # Errors
+    ///
+    /// [`Self::Error`] when the check runs cannot be listed.
+    fn check_runs(&self, head: &CommitId) -> Result<Vec<CheckView>, Self::Error>;
+
+    /// The review comments on PR `number` authored by App `app`, across all pages. A comment by
+    /// anyone else is never returned; `status` checks each one's [`ReviewCommentView::app`]
+    /// again.
+    ///
+    /// # Errors
+    ///
+    /// [`Self::Error`] when the review comments cannot be listed.
+    fn review_comments(
+        &self,
+        number: NonZeroU64,
+        app: AppId,
+    ) -> Result<Vec<ReviewCommentView>, Self::Error>;
+
+    /// The authenticated `gh` user running the command.
+    ///
+    /// # Errors
+    ///
+    /// [`Self::Error`] when the user cannot be read.
+    fn viewer(&self) -> Result<Viewer, Self::Error>;
+}
+
+/// A GitHub App's numeric id (`check_run.app.id`, the ruleset's `integration_id`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord)]
+pub struct AppId(pub NonZeroU64);
+
+/// A GitHub user's numeric id, the authoritative identity of 03 §1.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord)]
+pub struct UserId(pub NonZeroU64);
+
+/// A PR as GitHub shows it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct PullView {
+    /// Its number.
+    pub number: NonZeroU64,
+    /// Its head commit.
+    pub head_sha: CommitId,
+    /// Its head branch.
+    pub head_ref: String,
+    /// Its base branch, which names the verdict check (R3-03).
+    pub base_ref: String,
+}
+
+/// One check run on a commit, of any app.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct CheckView {
+    /// The app that created it.
+    pub app: AppId,
+    /// Its name.
+    pub name: String,
+    /// Its status.
+    pub status: CheckStatus,
+    /// Its conclusion, once completed.
+    pub conclusion: Option<ObservedConclusion>,
+    /// Its `external_id`, if set.
+    pub external_id: Option<String>,
+    /// Its `output.text`, if set.
+    pub output_text: Option<String>,
+    /// Its page (`html_url`).
+    pub url: String,
+}
+
+/// A check run's conclusion, as GitHub can report it for any app.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum ObservedConclusion {
+    /// `success`.
+    Success,
+    /// `failure`.
+    Failure,
+    /// `neutral`.
+    Neutral,
+    /// `cancelled`.
+    Cancelled,
+    /// `skipped`.
+    Skipped,
+    /// `timed_out`.
+    TimedOut,
+    /// `action_required`.
+    ActionRequired,
+    /// `stale`: GitHub closed a check left incomplete for 14 days.
+    Stale,
+}
+
+impl ObservedConclusion {
+    /// The conclusion's wire word.
+    #[must_use]
+    pub const fn code(self) -> &'static str {
+        match self {
+            Self::Success => "success",
+            Self::Failure => "failure",
+            Self::Neutral => "neutral",
+            Self::Cancelled => "cancelled",
+            Self::Skipped => "skipped",
+            Self::TimedOut => "timed_out",
+            Self::ActionRequired => "action_required",
+            Self::Stale => "stale",
+        }
+    }
+}
+
+/// One review comment on a PR's diff.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ReviewCommentView {
+    /// The app that authored it; `None` for a user.
+    pub app: Option<AppId>,
+    /// Its body as GitHub returns it.
+    pub body: String,
+    /// The file it is on.
+    pub path: String,
+    /// Its line (GitHub's `line`); `None` once the line is outdated.
+    pub line: Option<NonZeroU64>,
+    /// Its page (`html_url`).
+    pub url: String,
+}
+
+/// The user `gh` is authenticated as.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Viewer {
+    /// Their numeric id.
+    pub id: UserId,
+    /// Their login, for display.
+    pub login: String,
+}
diff --git a/crates/assay-app/src/status/verdict.rs b/crates/assay-app/src/status/verdict.rs
new file mode 100644
index 0000000..bdf3d2e
--- /dev/null
+++ b/crates/assay-app/src/status/verdict.rs
@@ -0,0 +1,222 @@
+//! The App's checks on the head: the verdict check, the decision its evidence pointer names,
+//! and the per-gate checks.
+
+use std::collections::BTreeMap;
+
+use assay_domain::{Decision, DecisionInputs, RunUid};
+
+use super::ports::{AppId, CheckView, ObservedConclusion, PullView, StatusForge};
+use super::{
+    BundleProblem, MAX_CHECK_RUNS, StatusError, StatusPorts, StatusRequest, StatusStep,
+    StatusUnreadable, page,
+};
+use crate::config::{GateName, Sha256Digest};
+use crate::publish::read_text;
+use crate::publish::{BUNDLE_FILE, CheckName, CheckStatus, EvidencePointer, MAX_BUNDLE_BYTES};
+use crate::replay::{self, BundleSource, StoredBundle};
+
+/// What a gate check's name starts with (`assay / gate: <plugin>`, 04 §6).
+const GATE_PREFIX: &str = "assay / gate: ";
+
+/// What the App's checks on the head say.
+pub(super) struct Observed {
+    /// The verdict check, if the App has one.
+    pub(super) check: Option<Check>,
+    /// The decision the check carries, if it names a persisted one.
+    pub(super) decided: Option<Decided>,
+    /// The per-gate checks, by plugin.
+    pub(super) gates: BTreeMap<GateName, Check>,
+}
+
+/// One App check as the status shows it.
+pub(super) struct Check {
+    pub(super) status: CheckStatus,
+    pub(super) conclusion: Option<ObservedConclusion>,
+    pub(super) url: String,
+}
+
+/// A decision read from its authenticated bundle.
+pub(super) struct Decided {
+    pub(super) decision: Decision,
+    pub(super) inputs: DecisionInputs,
+}
+
+/// What the verdict check's `external_id` says.
+enum Stamp<'a> {
+    /// `open`'s `pending:<run_id>:<seq>`: a run is in progress and nothing is decided yet.
+    Open,
+    /// A decision key: `decide` wrote the check.
+    Decided(&'a str),
+}
+
+/// Reads the head's check runs and, when the verdict check names a persisted decision, its
+/// bundle.
+pub(super) fn observe<F: StatusForge, B: BundleSource>(
+    request: &StatusRequest<'_>,
+    ports: &StatusPorts<'_, F, B>,
+    pull: &PullView,
+) -> Result<Observed, StatusError<F::Error, B::Error>> {
+    let runs = ports
+        .forge
+        .check_runs(&pull.head_sha)
+        .map_err(|source| StatusError::Forge {
+            step: StatusStep::CheckRuns,
+            source,
+        })?;
+    if runs.len() > MAX_CHECK_RUNS {
+        return Err(StatusError::TooManyChecks { count: runs.len() });
+    }
+    let repository = request.repository.name.as_str();
+    let name = CheckName::for_base(&pull.base_ref, &request.repository.default_branch);
+    let verdicts: Vec<&CheckView> = app_checks(&runs, request.app)
+        .filter(|run| run.name == name.as_str())
+        .collect();
+    let (check, decided) = match verdicts.as_slice() {
+        [] => (None, None),
+        [verdict] => {
+            let check = check(verdict, repository).map_err(StatusError::Unreadable)?;
+            let decided = match stamp(verdict).map_err(StatusError::Unreadable)? {
+                Stamp::Open => None,
+                Stamp::Decided(key) => decision(request, ports.bundles, verdict, key)?,
+            };
+            (Some(check), decided)
+        }
+        many => return Err(StatusError::DuplicateVerdict { count: many.len() }),
+    };
+    Ok(Observed {
+        check,
+        decided,
+        gates: gates(&runs, request.app, repository)?,
+    })
+}
+
+/// The check runs `app` created.
+fn app_checks(runs: &[CheckView], app: AppId) -> impl Iterator<Item = &CheckView> {
+    runs.iter().filter(move |run| run.app == app)
+}
+
+/// `run` as the status shows it, when its status and conclusion agree and its page reads.
+fn check(run: &CheckView, repository: &str) -> Result<Check, StatusUnreadable> {
+    let completed = run.status == CheckStatus::Completed;
+    if completed != run.conclusion.is_some() {
+        return Err(StatusUnreadable::CheckState);
+    }
+    Ok(Check {
+        status: run.status,
+        conclusion: run.conclusion,
+        url: page(&run.url, repository)?,
+    })
+}
+
+/// The App's `assay / gate: <plugin>` checks, by plugin, each plugin once.
+fn gates<E, B>(
+    runs: &[CheckView],
+    app: AppId,
+    repository: &str,
+) -> Result<BTreeMap<GateName, Check>, StatusError<E, B>> {
+    let mut gates = BTreeMap::new();
+    for run in app_checks(runs, app) {
+        let Some(plugin) = run.name.strip_prefix(GATE_PREFIX) else {
+            continue;
+        };
+        // The validated name owns its copy of the plugin name.
+        let plugin = GateName::new(plugin.to_owned())
+            .map_err(|_not_a_plugin| StatusError::Unreadable(StatusUnreadable::GateName))?;
+        let check = check(run, repository).map_err(StatusError::Unreadable)?;
+        if gates.contains_key(&plugin) {
+            return Err(StatusError::DuplicateGate { plugin });
+        }
+        gates.insert(plugin, check);
+    }
+    Ok(gates)
+}
+
+/// What the verdict check's `external_id` says, or that it says neither thing assay writes.
+fn stamp(run: &CheckView) -> Result<Stamp<'_>, StatusUnreadable> {
+    let id = run
+        .external_id
+        .as_deref()
+        .ok_or(StatusUnreadable::ExternalId)?;
+    if let Some(stamp) = id.strip_prefix("pending:") {
+        let digits = |text: &str| !text.is_empty() && text.bytes().all(|b| b.is_ascii_digit());
+        return match stamp.split_once(':') {
+            Some((run_id, seq)) if digits(run_id) && digits(seq) => Ok(Stamp::Open),
+            _ => Err(StatusUnreadable::ExternalId),
+        };
+    }
+    match id.parse::<Sha256Digest>() {
+        Ok(_) => Ok(Stamp::Decided(id)),
+        Err(_) => Err(StatusUnreadable::ExternalId),
+    }
+}
+
+/// The decision a decided verdict check names: none when its run persisted no bundle, else the
+/// bundle's, once authenticated against the pointer and the check's key.
+fn decision<E, B: BundleSource>(
+    request: &StatusRequest<'_>,
+    bundles: &B,
+    run: &CheckView,
+    key: &str,
+) -> Result<Option<Decided>, StatusError<E, B::Error>> {
+    let text = run
+        .output_text
+        .as_deref()
+        .and_then(read_text)
+        .filter(|text| text.decision_key == key)
+        .ok_or(StatusError::Unreadable(StatusUnreadable::CheckText))?;
+    let Some(pointer) = text.pointer else {
+        return Ok(None);
+    };
+    let decided = authenticated(request, bundles, &pointer, key).map_err(StatusError::Bundle)?;
+    Ok(Some(decided))
+}
+
+/// The bundle `pointer` names, read under its cap, hashing to the pointer, consistent with it
+/// and itself, decided under `request.rubric` and carrying the decision keyed `key`.
+fn authenticated<B: BundleSource>(
+    request: &StatusRequest<'_>,
+    bundles: &B,
+    pointer: &EvidencePointer,
+    key: &str,
+) -> Result<Decided, BundleProblem<B::Error>> {
+    if pointer.run_attempt.get() != 1 {
+        return Err(BundleProblem::NotFirstAttempt);
+    }
+    let run = RunUid {
+        repo_id: request.repository.id,
+        run_id: pointer.run_id,
+        run_attempt: pointer.run_attempt,
+    };
+    let bytes = match bundles
+        .fetch(run, BUNDLE_FILE, MAX_BUNDLE_BYTES)
+        .map_err(BundleProblem::Fetch)?
+    {
+        StoredBundle::Found(bytes) if bytes.len() > MAX_BUNDLE_BYTES => {
+            return Err(BundleProblem::TooLarge);
+        }
+        StoredBundle::Found(bytes) => bytes,
+        StoredBundle::Missing => return Err(BundleProblem::Missing),
+        StoredBundle::Expired => return Err(BundleProblem::Expired),
+        StoredBundle::TooLarge => return Err(BundleProblem::TooLarge),
+    };
+    if Sha256Digest::of(&bytes) != pointer.sha256 {
+        return Err(BundleProblem::Digest);
+    }
+    let bundle = replay::read(&bytes).map_err(BundleProblem::Shape)?;
+    drop(bytes);
+    if replay::inconsistency(&bundle, run).is_some() {
+        return Err(BundleProblem::Inconsistent);
+    }
+    if bundle.rubric_version != request.rubric.version() {
+        return Err(BundleProblem::RubricVersion);
+    }
+    let decision: Decision = serde_json::from_value(bundle.decision)
+        .map_err(|_not_a_decision| BundleProblem::Decision)?;
+    if decision.key != key {
+        return Err(BundleProblem::Decision);
+    }
+    Ok(Decided {
+        decision,
+        inputs: bundle.inputs,
+    })
+}
