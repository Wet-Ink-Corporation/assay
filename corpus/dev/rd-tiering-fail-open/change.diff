+    #[test]
+    fn every_shipped_glob_is_valid() {
+        let lists: [&[&str]; 8] = [
+            &TRUST,
+            &RISK,
+            &CODE,
+            &NEVER_TRIVIAL,
+            &DOCS,
+            &EXCLUDED,
+            &VENDOR,
+            &BUILD_SCRIPT,
+        ];
+
+        let invalid: Vec<_> = lists
+            .iter()
+            .flat_map(|list| list.iter())
+            .filter(|pattern| pattern.parse::<Glob>().is_err())
+            .collect();
+
+        assert_eq!(invalid, Vec::<&&str>::new());
+    }
+}
