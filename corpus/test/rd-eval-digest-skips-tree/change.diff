+/// Published 95% Wilson upper bounds (z = 1.96), to four decimals.
+#[test]
+fn the_wilson_upper_bound_of_none_in_thirty_is_0_1135() {
+    assert!((upper(0, 30) - 0.1135).abs() < 5e-5, "{}", upper(0, 30));
+}
