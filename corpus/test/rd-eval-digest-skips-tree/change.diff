@@ -0,0 +1,265 @@
+//! One eval case: its `case.json` (format `assay.eval-case/1`, read strictly) and its diff.
+
+use std::fmt;
+use std::num::NonZeroU64;
+
+use assay_domain::Class;
+use serde::Deserialize;
+use thiserror::Error;
+
+use crate::contract::parse_json_strict;
+
+/// The `schema` every `case.json` carries.
+pub const CASE_SCHEMA: &str = "assay.eval-case/1";
+
+/// The most labels (fixing hunks) one case may hold.
+pub const MAX_LABELS: usize = 64;
+
+/// The longest authoring model id, in bytes.
+pub const MAX_AUTHORING_MODEL_BYTES: usize = 64;
+
+/// The longest labelled file path, in bytes.
+pub const MAX_LABEL_PATH_BYTES: usize = 1024;
+
+/// The authoring model's id for a human-written change.
+const HUMAN: &str = "human";
+
+/// Who wrote the change under review (04 §8), so self-review recall is reported apart from
+/// human-authored recall.
+#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum AuthoringModel {
+    /// A person (`"human"`).
+    Human,
+    /// A model, by id: 1 to 64 bytes of `a-z`, `0-9`, `.`, `_` and `-` (`claude-opus-5-5`).
+    Model(String),
+}
+
+impl AuthoringModel {
+    /// Reads `"human"` or a model id; `None` for anything else.
+    fn parse(text: String) -> Option<Self> {
+        if text == HUMAN {
+            return Some(Self::Human);
+        }
+        let allowed = |byte: &u8| {
+            byte.is_ascii_lowercase() || byte.is_ascii_digit() || matches!(byte, b'.' | b'_' | b'-')
+        };
+        let shaped = !text.is_empty()
+            && text.len() <= MAX_AUTHORING_MODEL_BYTES
+            && text.as_bytes().iter().all(allowed);
+        shaped.then_some(Self::Model(text))
+    }
+}
+
+impl fmt::Display for AuthoringModel {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Human => f.write_str(HUMAN),
+            Self::Model(id) => f.write_str(id),
+        }
+    }
+}
+
+/// Where a case came from (04 §8's sources).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Deserialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum CaseSource {
+    /// A real PR whose merged code later needed a fix; the labels are the fix's hunks.
+    RealDefect,
+    /// A mutation-seeded defect (smoke only).
+    Mutation,
+    /// A PR with nothing to find, for noise. Holds no label.
+    TrueNegative,
+    /// Hostile text the pipeline must survive; labelled or not.
+    Injection,
+    /// A rebase or force-push fixture.
+    Rebase,
+    /// A cross-file "consumer not updated" fixture.
+    CrossFile,
+}
+
+/// One fixing hunk: a file, its lines at the reviewed head (inclusive) and the defect's class.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Label {
+    file: String,
+    first: NonZeroU64,
+    last: NonZeroU64,
+    class: Class,
+}
+
+impl Label {
+    /// A label; refused when `last` is before `first` or the path is not a plain relative
+    /// path (empty, absolute, over [`MAX_LABEL_PATH_BYTES`], holding NUL, or with an empty,
+    /// `.` or `..` segment).
+    pub(crate) fn new(
+        file: impl Into<String>,
+        first: NonZeroU64,
+        last: NonZeroU64,
+        class: Class,
+    ) -> Result<Self, LabelProblem> {
+        let file = file.into();
+        if first > last {
+            return Err(LabelProblem::Span);
+        }
+        let plain = file.len() <= MAX_LABEL_PATH_BYTES
+            && !file.contains('\0')
+            && file
+                .split('/')
+                .all(|segment| !matches!(segment, "" | "." | ".."));
+        if !plain {
+            return Err(LabelProblem::Path);
+        }
+        Ok(Self {
+            file,
+            first,
+            last,
+            class,
+        })
+    }
+
+    /// The file, relative to the repository root.
+    #[must_use]
+    pub fn file(&self) -> &str {
+        &self.file
+    }
+
+    /// The hunk's first line.
+    #[must_use]
+    pub const fn first(&self) -> NonZeroU64 {
+        self.first
+    }
+
+    /// The hunk's last line.
+    #[must_use]
+    pub const fn last(&self) -> NonZeroU64 {
+        self.last
+    }
+
+    /// The defect's class.
+    #[must_use]
+    pub const fn class(&self) -> Class {
+        self.class
+    }
+}
+
+/// Why a label was refused.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum LabelProblem {
+    /// It ends before it starts.
+    Span,
+    /// Its path is not a plain relative path.
+    Path,
+}
+
+/// Why a `case.json` was refused.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Error)]
+pub enum CaseProblem {
+    /// Not one JSON object of exactly the case fields (an unknown or repeated key, a wrong
+    /// type, an unknown source or class), at this 1-based line.
+    #[error("case.json is not an {CASE_SCHEMA} document (line {line})")]
+    Syntax {
+        /// The line the parser stopped at.
+        line: usize,
+    },
+    /// The `schema` is not [`CASE_SCHEMA`].
+    #[error("case.json is not {CASE_SCHEMA}")]
+    Schema,
+    /// The `authoring_model` is neither `human` nor a model id.
+    #[error("the authoring model is neither \"human\" nor a model id")]
+    AuthoringModel,
+    /// A `true-negative` case holds a label.
+    #[error("a true-negative case holds a label")]
+    LabelsOnTrueNegative,
+    /// A defect case (any source but `true-negative` and `injection`) holds no label.
+    #[error("a defect case holds no label")]
+    NoLabels,
+    /// More than [`MAX_LABELS`] labels.
+    #[error("more than {MAX_LABELS} labels")]
+    TooManyLabels,
+    /// The label at `index` ends before it starts.
+    #[error("label {index} ends before it starts")]
+    LabelSpan {
+        /// The label's 0-based position.
+        index: usize,
+    },
+    /// The label at `index` names no plain relative path.
+    #[error("label {index} names no plain relative path")]
+    LabelPath {
+        /// The label's 0-based position.
+        index: usize,
+    },
+}
+
+/// A `case.json`, as written.
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct CaseDocument {
+    schema: String,
+    authoring_model: String,
+    source: CaseSource,
+    labels: Vec<LabelDocument>,
+}
+
+/// One label, as written.
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct LabelDocument {
+    file: String,
+    start_line: NonZeroU64,
+    end_line: NonZeroU64,
+    class: Class,
+}
+
+/// What a `case.json` holds once read.
+#[derive(Debug)]
+pub(crate) struct CaseFile {
+    pub(crate) authoring_model: AuthoringModel,
+    pub(crate) source: CaseSource,
+    pub(crate) labels: Vec<Label>,
+}
+
+/// Reads a `case.json` strictly. The caller bounds its size.
+pub(crate) fn read_case(json: &[u8]) -> Result<CaseFile, CaseProblem> {
+    let syntax = |error: serde_json::Error| CaseProblem::Syntax { line: error.line() };
+    let value = parse_json_strict(json).map_err(syntax)?;
+    let document = CaseDocument::deserialize(value).map_err(syntax)?;
+    if document.schema != CASE_SCHEMA {
+        return Err(CaseProblem::Schema);
+    }
+    let authoring_model =
+        AuthoringModel::parse(document.authoring_model).ok_or(CaseProblem::AuthoringModel)?;
+    if document.labels.len() > MAX_LABELS {
+        return Err(CaseProblem::TooManyLabels);
+    }
+    match document.source {
+        CaseSource::TrueNegative if !document.labels.is_empty() => {
+            return Err(CaseProblem::LabelsOnTrueNegative);
+        }
+        CaseSource::TrueNegative | CaseSource::Injection => {}
+        CaseSource::RealDefect
+        | CaseSource::Mutation
+        | CaseSource::Rebase
+        | CaseSource::CrossFile => {
+            if document.labels.is_empty() {
+                return Err(CaseProblem::NoLabels);
+            }
+        }
+    }
+    let labels = document
+        .labels
+        .into_iter()
+        .enumerate()
+        .map(|(index, label)| {
+            Label::new(label.file, label.start_line, label.end_line, label.class).map_err(
+                |problem| match problem {
+                    LabelProblem::Span => CaseProblem::LabelSpan { index },
+                    LabelProblem::Path => CaseProblem::LabelPath { index },
+                },
+            )
+        })
+        .collect::<Result<_, _>>()?;
+    Ok(CaseFile {
+        authoring_model,
+        source: document.source,
+        labels,
+    })
+}
diff --git a/crates/assay-app/src/eval/corpus.rs b/crates/assay-app/src/eval/corpus.rs
new file mode 100644
index 0000000..e2505ba
--- /dev/null
+++ b/crates/assay-app/src/eval/corpus.rs
@@ -0,0 +1,343 @@
+//! One split of the eval corpus (`corpus/{dev,test,inject}`, 04 §8), as the caller listed it.
+//!
+//! A split holds an optional `README.md` and one directory per case, named by its id. A case
+//! directory holds exactly `case.json`, `change.diff` and `tree/` (the reviewed head, which the
+//! model reads; the labels stay outside it). Everything past a cap, anything else and anything
+//! that is neither a directory nor a regular file is refused (wi-b5affa).
+
+use std::collections::BTreeMap;
+use std::{fmt, mem};
+
+use assay_domain::ContentHash;
+use thiserror::Error;
+
+use super::case::{AuthoringModel, CaseProblem, CaseSource, Label, read_case};
+use crate::check::MAX_DIFF_BYTES;
+use crate::golden::{CorpusEntry, CorpusEntryKind};
+
+/// The most entries a split may list, directories and tree files included.
+pub const MAX_EVAL_ENTRIES: usize = 65_536;
+
+/// The most cases a split may hold.
+pub const MAX_EVAL_CASES: usize = 512;
+
+/// The largest `case.json`, in bytes: 64 KiB.
+pub const MAX_CASE_BYTES: usize = 64 << 10;
+
+/// The longest case id, in bytes.
+pub const MAX_CASE_ID_BYTES: usize = 64;
+
+/// The case metadata and labels.
+const CASE_FILE: &str = "case.json";
+/// The change under review, as a unified diff.
+const DIFF_FILE: &str = "change.diff";
+/// The reviewed head the model may read.
+const TREE_DIR: &str = "tree";
+/// The one file allowed beside the cases.
+const README: &str = "README.md";
+
+/// A corpus split (04 §8).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum Split {
+    /// Prompt work runs against it.
+    Dev,
+    /// Held out: never read during prompt iteration.
+    Test,
+    /// Hostile-text fixtures.
+    Inject,
+}
+
+impl Split {
+    /// The split's directory under `corpus/`.
+    #[must_use]
+    pub const fn dir(self) -> &'static str {
+        match self {
+            Self::Dev => "dev",
+            Self::Test => "test",
+            Self::Inject => "inject",
+        }
+    }
+}
+
+impl fmt::Display for Split {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(self.dir())
+    }
+}
+
+/// One case, read and checked.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct EvalCase {
+    id: String,
+    authoring_model: AuthoringModel,
+    source: CaseSource,
+    labels: Vec<Label>,
+    diff: String,
+    content: ContentHash,
+}
+
+impl EvalCase {
+    /// The case's id: its directory name.
+    #[must_use]
+    pub fn id(&self) -> &str {
+        &self.id
+    }
+
+    /// Who wrote the change.
+    #[must_use]
+    pub const fn authoring_model(&self) -> &AuthoringModel {
+        &self.authoring_model
+    }
+
+    /// Where the case came from.
+    #[must_use]
+    pub const fn source(&self) -> CaseSource {
+        self.source
+    }
+
+    /// The fixing hunks; empty for a case with nothing to find.
+    #[must_use]
+    pub fn labels(&self) -> &[Label] {
+        &self.labels
+    }
+
+    /// The change under review, as a unified diff.
+    #[must_use]
+    pub fn diff(&self) -> &str {
+        &self.diff
+    }
+
+    /// The digest of the case's `case.json` and `change.diff`, as read.
+    #[must_use]
+    pub const fn content(&self) -> ContentHash {
+        self.content
+    }
+}
+
+/// A split's cases, in id order.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct EvalCorpus {
+    split: Split,
+    cases: Vec<EvalCase>,
+}
+
+impl EvalCorpus {
+    /// The split.
+    #[must_use]
+    pub const fn split(&self) -> Split {
+        self.split
+    }
+
+    /// The cases, in id order.
+    #[must_use]
+    pub fn cases(&self) -> &[EvalCase] {
+        &self.cases
+    }
+}
+
+/// Why a split was refused. Paths are relative to the split directory and shown escaped.
+#[derive(Debug, Clone, PartialEq, Eq, Error)]
+pub enum CorpusError {
+    /// More than [`MAX_EVAL_ENTRIES`] entries were listed; none was looked at.
+    #[error("the split lists more than {limit} entries")]
+    TooManyEntries {
+        /// The cap.
+        limit: usize,
+    },
+    /// More than [`MAX_EVAL_CASES`] cases.
+    #[error("the split holds more than {limit} cases")]
+    TooManyCases {
+        /// The cap.
+        limit: usize,
+    },
+    /// An entry that does not belong (the first in path order): not a directory or regular
+    /// file, a directory not named as a case id, or a file other than the case files.
+    #[error("unexpected entry {path:?} in the eval corpus")]
+    UnexpectedEntry {
+        /// The entry.
+        path: String,
+    },
+    /// A case lacks one of `case.json`, `change.diff` and `tree/`.
+    #[error("case {case:?} has no {missing}")]
+    Incomplete {
+        /// The case id.
+        case: String,
+        /// The missing entry's name.
+        missing: &'static str,
+    },
+    /// A case file is over its cap ([`MAX_CASE_BYTES`] for `case.json`, `MAX_DIFF_BYTES` for
+    /// `change.diff`); it was not read.
+    #[error("{path:?} is over {limit} bytes")]
+    TooLarge {
+        /// The file.
+        path: String,
+        /// The cap.
+        limit: usize,
+    },
+    /// A case's `change.diff` is not UTF-8 text without NUL.
+    #[error("the change.diff of case {case:?} is not text")]
+    DiffNotText {
+        /// The case id.
+        case: String,
+    },
+    /// A case's `case.json` was refused.
+    #[error("the case.json of case {case:?} was refused")]
+    Case {
+        /// The case id.
+        case: String,
+        /// Why.
+        #[source]
+        problem: CaseProblem,
+    },
+}
+
+/// The entries of one case directory.
+#[derive(Debug, Default)]
+struct CaseEntries<'a> {
+    json: Option<&'a [u8]>,
+    diff: Option<&'a [u8]>,
+    tree: bool,
+}
+
+/// Reads one split from every entry under its directory (at any depth; tree files' bytes are
+/// not read). Linear in the entries after the [`MAX_EVAL_ENTRIES`] check, plus a sort of the
+/// case ids.
+///
+/// # Examples
+///
+/// ```
+/// use assay_app::{CorpusEntry, CorpusEntryKind, CorpusError, Split, read_eval_corpus};
+///
+/// let entries = [CorpusEntry {
+///     path: "README.md".to_owned(),
+///     kind: CorpusEntryKind::File(b"# dev\n".to_vec()),
+/// }];
+///
+/// let corpus = read_eval_corpus(Split::Dev, &entries)?;
+///
+/// // A split with no case reads, but `run_eval` refuses to run it.
+/// assert!(corpus.cases().is_empty());
+/// # Ok::<(), CorpusError>(())
+/// ```
+///
+/// # Errors
+/// [`CorpusError`] for the first problem found: the entry cap, then unexpected entries (the
+/// first in path order) and the case cap, then each case in id order.
+pub fn read_eval_corpus(split: Split, entries: &[CorpusEntry]) -> Result<EvalCorpus, CorpusError> {
+    if entries.len() > MAX_EVAL_ENTRIES {
+        return Err(CorpusError::TooManyEntries {
+            limit: MAX_EVAL_ENTRIES,
+        });
+    }
+    let mut cases: BTreeMap<&str, CaseEntries<'_>> = BTreeMap::new();
+    let mut unexpected: Option<&str> = None;
+    for entry in entries {
+        if !sort_entry(entry, &mut cases) {
+            let path = entry.path.as_str();
+            unexpected = Some(unexpected.map_or(path, |first| first.min(path)));
+        }
+    }
+    if let Some(path) = unexpected {
+        return Err(CorpusError::UnexpectedEntry {
+            path: path.to_owned(),
+        });
+    }
+    if cases.len() > MAX_EVAL_CASES {
+        return Err(CorpusError::TooManyCases {
+            limit: MAX_EVAL_CASES,
+        });
+    }
+    let cases = cases
+        .into_iter()
+        .map(|(id, entries)| read_one(id, &entries))
+        .collect::<Result<_, _>>()?;
+    Ok(EvalCorpus { split, cases })
+}
+
+/// Files `entry` under its case; `false` when it does not belong in a split or repeats a case
+/// file. Linear in the path's length.
+fn sort_entry<'a>(entry: &'a CorpusEntry, cases: &mut BTreeMap<&'a str, CaseEntries<'a>>) -> bool {
+    let (id, rest) = match entry.path.split_once('/') {
+        Some((id, rest)) => (id, Some(rest)),
+        None => (entry.path.as_str(), None),
+    };
+    let plain = |path: &str| {
+        path.split('/')
+            .all(|segment| !matches!(segment, "" | "." | ".."))
+    };
+    if !rest.is_none_or(plain) {
+        return false;
+    }
+    let file = match &entry.kind {
+        CorpusEntryKind::File(bytes) => Some(bytes.as_slice()),
+        CorpusEntryKind::Directory => None,
+        CorpusEntryKind::Other => return false,
+    };
+    if id == README && rest.is_none() {
+        return file.is_some();
+    }
+    if !is_case_id(id) {
+        return false;
+    }
+    let case = cases.entry(id).or_default();
+    // A repeated case file or tree is refused, never kept in place of the first.
+    match (rest, file) {
+        (None, None) => true,
+        (Some(TREE_DIR), None) => !mem::replace(&mut case.tree, true),
+        (Some(path), _) if path.starts_with("tree/") => true,
+        (Some(CASE_FILE), Some(bytes)) => case.json.replace(bytes).is_none(),
+        (Some(DIFF_FILE), Some(bytes)) => case.diff.replace(bytes).is_none(),
+        _ => false,
+    }
+}
+
+/// Whether `id` names a case: 1 to [`MAX_CASE_ID_BYTES`] bytes of `a-z`, `0-9` and `-`.
+fn is_case_id(id: &str) -> bool {
+    !id.is_empty()
+        && id.len() <= MAX_CASE_ID_BYTES
+        && id
+            .bytes()
+            .all(|byte| byte.is_ascii_lowercase() || byte.is_ascii_digit() || byte == b'-')
+}
+
+/// Checks and reads one case's files.
+fn read_one(id: &str, entries: &CaseEntries<'_>) -> Result<EvalCase, CorpusError> {
+    let incomplete = |missing| CorpusError::Incomplete {
+        case: id.to_owned(),
+        missing,
+    };
+    let json = entries.json.ok_or_else(|| incomplete(CASE_FILE))?;
+    let diff = entries.diff.ok_or_else(|| incomplete(DIFF_FILE))?;
+    if !entries.tree {
+        return Err(incomplete(TREE_DIR));
+    }
+    let too_large = |file: &str, limit| CorpusError::TooLarge {
+        path: format!("{id}/{file}"),
+        limit,
+    };
+    if json.len() > MAX_CASE_BYTES {
+        return Err(too_large(CASE_FILE, MAX_CASE_BYTES));
+    }
+    if diff.len() > MAX_DIFF_BYTES {
+        return Err(too_large(DIFF_FILE, MAX_DIFF_BYTES));
+    }
+    let diff = str::from_utf8(diff)
+        .ok()
+        .filter(|text| !text.contains('\0'))
+        .ok_or_else(|| CorpusError::DiffNotText {
+            case: id.to_owned(),
+        })?;
+    let content = ContentHash::of_files([(CASE_FILE, json), (DIFF_FILE, diff.as_bytes())]);
+    let case = read_case(json).map_err(|problem| CorpusError::Case {
+        case: id.to_owned(),
+        problem,
+    })?;
+    Ok(EvalCase {
+        id: id.to_owned(),
+        authoring_model: case.authoring_model,
+        source: case.source,
+        labels: case.labels,
+        diff: diff.to_owned(),
+        content,
+    })
+}
