diff --git a/crates/assay-runner/src/stream/init.rs b/crates/assay-runner/src/stream/init.rs
new file mode 100644
index 0000000..2a8cd5a
--- /dev/null
+++ b/crates/assay-runner/src/stream/init.rs
@@ -0,0 +1,104 @@
+//! The `system/init` message of a stream-json transcript (03 §8), read into the application's
+//! [`SessionInit`] and judged there.
+//!
+//! It refuses rather than models (wi-b5affa): the init must be the first message, appear once,
+//! and carry every field the rule reads in the shape Claude Code 2.1.296 writes; a plugin entry
+//! must have exactly `name`, `path` and `source`. Fields the rule does not read are ignored.
+
+use assay_app::{InitParts, InitPlugin, InitReadError, MAX_BUILTINS, SessionInit};
+use serde_json::{Map, Value};
+
+/// The keys of an `init.plugins` entry, all strings.
+const PLUGIN_KEYS: [&str; 3] = ["name", "path", "source"];
+
+/// Reads the `system/init` message that opens `transcript`.
+///
+/// # Errors
+/// [`InitReadError::Missing`] when the first non-blank line is not a `system/init` message,
+/// [`InitReadError::Repeated`] when another follows, [`InitReadError::Field`] or
+/// [`InitReadError::Entry`] for a field or list entry of the wrong shape, and
+/// [`InitReadError::TooMany`] or [`InitReadError::Name`] for one out of bounds.
+pub fn read_session_init(transcript: &[u8]) -> Result<SessionInit, InitReadError> {
+    let mut lines = transcript
+        .split(|&byte| byte == b'\n')
+        .filter(|line| !line.trim_ascii().is_empty());
+    let first = lines
+        .next()
+        .and_then(init_object)
+        .ok_or(InitReadError::Missing)?;
+    if lines.any(|line| init_object(line).is_some()) {
+        return Err(InitReadError::Repeated);
+    }
+    SessionInit::new(InitParts {
+        cli_version: string_field(&first, "claude_code_version")?,
+        tools: strings(&first, "tools")?,
+        mcp_servers: entries(&first, "mcp_servers", mcp_server)?,
+        plugins: entries(&first, "plugins", plugin)?,
+        skills: strings(&first, "skills")?,
+        agents: strings(&first, "agents")?,
+    })
+}
+
+/// `line` as an object, when it is a `system` message with subtype `init`.
+fn init_object(line: &[u8]) -> Option<Map<String, Value>> {
+    let Ok(Value::Object(object)) = serde_json::from_slice::<Value>(line) else {
+        return None;
+    };
+    let is_init = object.get("type").and_then(Value::as_str) == Some("system")
+        && object.get("subtype").and_then(Value::as_str) == Some("init");
+    is_init.then_some(object)
+}
+
+fn string_field(object: &Map<String, Value>, field: &'static str) -> Result<String, InitReadError> {
+    object
+        .get(field)
+        .and_then(Value::as_str)
+        .map(str::to_owned)
+        .ok_or(InitReadError::Field { field })
+}
+
+/// The array `field`, each entry read by `read` (`None` for a malformed entry).
+fn entries<T>(
+    object: &Map<String, Value>,
+    field: &'static str,
+    read: impl Fn(&Value) -> Option<T>,
+) -> Result<Vec<T>, InitReadError> {
+    let array = object
+        .get(field)
+        .and_then(Value::as_array)
+        .ok_or(InitReadError::Field { field })?;
+    if array.len() > MAX_BUILTINS {
+        return Err(InitReadError::TooMany {
+            field,
+            count: array.len(),
+        });
+    }
+    array
+        .iter()
+        .enumerate()
+        .map(|(index, entry)| read(entry).ok_or(InitReadError::Entry { field, index }))
+        .collect()
+}
+
+fn strings(object: &Map<String, Value>, field: &'static str) -> Result<Vec<String>, InitReadError> {
+    entries(object, field, |entry| entry.as_str().map(str::to_owned))
+}
+
+/// An `mcp_servers` entry's `name`; its other keys (`status`) are not read.
+fn mcp_server(entry: &Value) -> Option<String> {
+    entry.get("name")?.as_str().map(str::to_owned)
+}
+
+/// A `plugins` entry with exactly the string keys `name`, `path` and `source`.
+fn plugin(entry: &Value) -> Option<InitPlugin> {
+    let object = entry.as_object()?;
+    if object.len() != PLUGIN_KEYS.len() {
+        return None;
+    }
+    let text = |key| object.get(key)?.as_str().map(str::to_owned);
+    Some(InitPlugin {
+        name: text("name")?,
+        path: text("path")?,
+        source: text("source")?,
+    })
+}
diff --git a/crates/assay-runner/tests/fixtures/fake-claude-canary b/crates/assay-runner/tests/fixtures/fake-claude-canary
new file mode 100755
index 0000000..d08b0aa
--- /dev/null
+++ b/crates/assay-runner/tests/fixtures/fake-claude-canary
@@ -0,0 +1,44 @@
+#!/bin/sh
+# A stand-in for `claude` in the canary tests (#121). Tests copy it into a scratch directory
+# beside a `knobs` file, since the runner clears the environment; it records how it was started
+# and what was planted there, prints a recorded stream and, when the knobs say the CLI ignores
+# its safety flags, behaves as a CLI that loads mods and AGENTS.md would:
+#   STREAM=<file>       stream-json to print on stdout
+#   RUN_MODS=1          run every planted mod's session.start hook (write its marker)
+#   FOLLOW_AGENTS=1     follow the planted AGENTS.md: print the canary word it asks for
+#   BREAK_MARKERS=1     replace the marker directory with a file, so markers cannot be inspected
+#   REMOVE_SANDBOX=1    delete the whole canary sandbox before exiting
+dir=${0%/*}
+. "$dir/knobs"
+add_dir=
+prev=
+for arg in "$@"; do
+  if [ "$prev" = --add-dir ]; then add_dir=$arg; fi
+  prev=$arg
+done
+for arg in "$@"; do printf '%s\0' "$arg"; done > "$dir/argv"
+/bin/cat > "$dir/stdin"
+pwd -P > "$dir/cwd"
+/usr/bin/env > "$dir/env"
+/bin/cat "$HOME/.claude/settings.json" > "$dir/settings.json"
+/bin/cat "$PWD/AGENTS.md" > "$dir/AGENTS.md"
+(cd "$HOME" && /usr/bin/find . -type f | /usr/bin/sort) > "$dir/home-files"
+(cd "$PWD" && /usr/bin/find . -type f | /usr/bin/sort) > "$dir/cwd-files"
+(cd "$add_dir" && /usr/bin/find . -type f | /usr/bin/sort) > "$dir/pr-files"
+for register in $(/usr/bin/find "$HOME" "$PWD" "$add_dir" -name register.ts); do
+  marker=$(/bin/sed -n 's/.*\$\.fs\.write(\("[^"]*"\).*/\1/p' "$register" | /bin/sed 's/"//g')
+  echo "$marker" >> "$dir/markers"
+  if [ "${RUN_MODS:-}" = 1 ]; then : > "$marker"; fi
+done
+/bin/cat "$STREAM"
+if [ "${FOLLOW_AGENTS:-}" = 1 ]; then
+  word=$(/bin/sed -n 's/.*`\([A-Z]*\)` immediately followed by `\([0-9a-f]*\)`.*/\1\2/p' "$PWD/AGENTS.md")
+  printf '{"type":"assistant","message":{"content":[{"type":"text","text":"ready %s"}]}}\n' "$word"
+fi
+if [ "${BREAK_MARKERS:-}" = 1 ]; then
+  markers=$(/bin/sed -n '1s|/[^/]*$||p' "$dir/markers")
+  /bin/rm -rf "$markers" && : > "$markers"
+fi
+if [ "${REMOVE_SANDBOX:-}" = 1 ]; then
+  /bin/rm -rf "${HOME%/*}"
+fi
