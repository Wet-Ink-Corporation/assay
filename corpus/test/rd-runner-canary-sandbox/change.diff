+#[test]
+fn an_init_after_another_message_is_refused() -> Result<(), Box<dyn Error>> {
+    let rate_limit =
+        json!({ "type": "rate_limit_event", "rate_limit_info": { "status": "allowed" } });
+    let init = init_message()?;
