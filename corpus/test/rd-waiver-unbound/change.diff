@@ -0,0 +1,252 @@
+//! `decide` rules 1 to 5 and 9 of `docs/architecture/04-pipeline.md` §5, and the precedence
+//! between rules.
+
+use std::error::Error;
+
+use assay_domain::{
+    Conclusion, Decision, DecisionInputs, GateConclusion, GateOutcome, LlmStage, OwnerApproval,
+    PrClass, ReasonCode, Tier, WeighIn, decide,
+};
+
+use crate::support::{clean_inputs, gate, reason, rubric_v1};
+
+fn decided(inputs: &DecisionInputs) -> Result<Decision, Box<dyn Error>> {
+    Ok(decide(&rubric_v1()?, inputs))
+}
+
+#[test]
+fn clean_inputs_succeed_with_no_reasons() -> Result<(), Box<dyn Error>> {
+    let decision = decided(&clean_inputs())?;
+
+    assert_eq!(decision.conclusion, Conclusion::Success);
+    assert_eq!(decision.reasons, []);
+    Ok(())
+}
+
+#[test]
+fn the_decision_carries_the_keys_and_the_rubric_version() -> Result<(), Box<dyn Error>> {
+    let decision = decided(&clean_inputs())?;
+
+    assert_eq!(decision.key, "dec-42-1");
+    assert_eq!(decision.evidence_key, "run-42-1");
+    assert_eq!(decision.rubric_version, "1");
+    Ok(())
+}
+
+#[test]
+fn a_failed_required_gate_fails_the_pr() -> Result<(), Box<dyn Error>> {
+    let mut inputs = clean_inputs();
+    inputs.gates = vec![gate("temper", GateConclusion::Fail, Vec::new())];
+
+    let decision = decided(&inputs)?;
+
+    assert_eq!(decision.conclusion, Conclusion::Failure);
+    assert_eq!(decision.reasons, [reason(ReasonCode::GateFailed, "temper")]);
+    Ok(())
+}
+
+#[test]
+fn a_gate_error_fails_the_pr_with_its_detail() -> Result<(), Box<dyn Error>> {
+    let mut inputs = clean_inputs();
+    let mut errored = gate("temper", GateConclusion::Pass, Vec::new());
+    errored.outcome = GateOutcome::Error {
+        detail: "timeout".to_owned(),
+    };
+    inputs.gates = vec![errored];
+
+    let decision = decided(&inputs)?;
+
+    assert_eq!(decision.conclusion, Conclusion::Failure);
+    assert_eq!(
+        decision.reasons,
+        [reason(ReasonCode::GateError, "temper: timeout")]
+    );
+    Ok(())
+}
+
+#[test]
+fn a_skipped_required_gate_fails_the_pr() -> Result<(), Box<dyn Error>> {
+    let mut inputs = clean_inputs();
+    let mut skipped = gate("temper", GateConclusion::Pass, Vec::new());
+    skipped.outcome = GateOutcome::Skipped;
+    inputs.gates = vec![skipped];
+
+    let decision = decided(&inputs)?;
+
+    assert_eq!(decision.conclusion, Conclusion::Failure);
+    assert_eq!(
+        decision.reasons,
+        [reason(ReasonCode::GateSkipped, "temper")]
+    );
+    Ok(())
+}
+
+#[test]
+fn a_failed_optional_gate_does_not_fail_the_pr() -> Result<(), Box<dyn Error>> {
+    let mut inputs = clean_inputs();
+    let mut optional = gate("custom-lint", GateConclusion::Fail, Vec::new());
+    optional.required = false;
+    inputs.gates.push(optional);
+
+    let decision = decided(&inputs)?;
+
+    assert_eq!(decision.conclusion, Conclusion::Success);
+    assert_eq!(decision.reasons, []);
+    Ok(())
+}
+
+#[test]
+fn an_unprotected_base_fails_base_not_protected() -> Result<(), Box<dyn Error>> {
+    let mut inputs = clean_inputs();
+    inputs.pr.base_ref = "release".to_owned();
+
+    let decision = decided(&inputs)?;
+
+    assert_eq!(decision.conclusion, Conclusion::Failure);
+    assert_eq!(
+        decision.reasons,
+        [reason(ReasonCode::BaseNotProtected, "release")]
+    );
+    Ok(())
+}
+
+#[test]
+fn two_open_prs_on_the_head_fail_ambiguous_head() -> Result<(), Box<dyn Error>> {
+    let mut inputs = clean_inputs();
+    inputs.pr.open_prs_on_head = 2;
+
+    let decision = decided(&inputs)?;
+
+    assert_eq!(decision.conclusion, Conclusion::Failure);
+    assert_eq!(
+        decision.reasons,
+        [reason(ReasonCode::AmbiguousHead, "2 open PRs on this head")]
+    );
+    Ok(())
+}
+
+#[test]
+fn a_needs_split_tier_fails_needs_split() -> Result<(), Box<dyn Error>> {
+    let mut inputs = clean_inputs();
+    inputs.pr.tier = Tier::NeedsSplit;
+    inputs.llm = LlmStage::NotRun;
+
+    let decision = decided(&inputs)?;
+
+    assert_eq!(decision.conclusion, Conclusion::Failure);
+    assert_eq!(
+        decision.reasons,
+        [reason(ReasonCode::NeedsSplit, "over the line budget")]
+    );
+    Ok(())
+}
+
+#[test]
+fn an_unapproved_trust_path_change_fails_trust_path_unapproved() -> Result<(), Box<dyn Error>> {
+    let mut inputs = clean_inputs();
+    inputs.pr.tier = Tier::Full;
+    inputs.pr.classes = vec![PrClass::TrustPath, PrClass::ExecSurface];
+
+    let decision = decided(&inputs)?;
+
+    assert_eq!(decision.conclusion, Conclusion::Failure);
+    assert_eq!(
+        decision.reasons,
+        [reason(
+            ReasonCode::TrustPathUnapproved,
+            "trust-path, exec-surface"
+        )]
+    );
+    Ok(())
+}
+
+#[test]
+fn an_owner_approved_trust_path_change_succeeds() -> Result<(), Box<dyn Error>> {
+    let mut inputs = clean_inputs();
+    inputs.pr.tier = Tier::Full;
+    inputs.pr.classes = vec![PrClass::ExecSurface];
+    inputs.pr.owner_approval = OwnerApproval::Approved;
+
+    let decision = decided(&inputs)?;
+
+    assert_eq!(decision.conclusion, Conclusion::Success);
+    assert_eq!(decision.reasons, []);
+    Ok(())
+}
+
+#[test]
+fn a_required_weigh_in_gate_fails_on_each_blocking_state() -> Result<(), Box<dyn Error>> {
+    let states = [
+        (WeighIn::OpenBlocking, ReasonCode::WeighInOpenBlocking),
+        (WeighIn::PendingTriage, ReasonCode::WeighInPendingTriage),
+        (WeighIn::NoEvidence, ReasonCode::WeighInNoEvidence),
+    ];
+
+    for (state, code) in states {
+        let mut inputs = clean_inputs();
+        inputs.weigh_in = state;
+
+        let decision = decided(&inputs)?;
+
+        assert_eq!(decision.conclusion, Conclusion::Failure, "{state:?}");
+        assert_eq!(decision.reasons, [reason(code, "weigh-in")], "{state:?}");
+    }
+    Ok(())
+}
+
+#[test]
+fn a_clear_weigh_in_gate_succeeds() -> Result<(), Box<dyn Error>> {
+    let mut inputs = clean_inputs();
+    inputs.weigh_in = WeighIn::Clear;
+
+    let decision = decided(&inputs)?;
+
+    assert_eq!(decision.conclusion, Conclusion::Success);
+    Ok(())
+}
+
+#[test]
+fn every_firing_rule_is_a_reason_in_rule_order() -> Result<(), Box<dyn Error>> {
+    let mut inputs = clean_inputs();
+    inputs.weigh_in = WeighIn::OpenBlocking;
+    inputs.pr.classes = vec![PrClass::TrustPath];
+    inputs.pr.base_ref = "release".to_owned();
+    inputs.gates = vec![gate("temper", GateConclusion::Fail, Vec::new())];
+
+    let decision = decided(&inputs)?;
+
+    assert_eq!(decision.conclusion, Conclusion::Failure);
+    assert_eq!(
+        decision.reasons,
+        [
+            reason(ReasonCode::GateFailed, "temper"),
+            reason(ReasonCode::BaseNotProtected, "release"),
+            reason(ReasonCode::TrustPathUnapproved, "trust-path"),
+            reason(ReasonCode::WeighInOpenBlocking, "weigh-in"),
+        ]
+    );
+    Ok(())
+}
+
+#[test]
+fn a_gate_failure_wins_over_a_deferred_llm_stage() -> Result<(), Box<dyn Error>> {
+    let mut inputs = clean_inputs();
+    inputs.pr.classes = vec![PrClass::TrustPath];
+    inputs.pr.owner_approval = OwnerApproval::Approved;
+    inputs.llm = LlmStage::Deferred {
+        reason: assay_domain::Deferral::BudgetDeferred,
+    };
+    inputs.gates = vec![gate("temper", GateConclusion::Fail, Vec::new())];
+
+    let decision = decided(&inputs)?;
+
+    assert_eq!(decision.conclusion, Conclusion::Failure);
+    assert_eq!(
+        decision.reasons,
+        [
+            reason(ReasonCode::GateFailed, "temper"),
+            reason(ReasonCode::BudgetDeferred, "requeued 0 of 3 times"),
+        ]
+    );
+    Ok(())
+}
diff --git a/crates/assay-domain/tests/it/decide_commands.rs b/crates/assay-domain/tests/it/decide_commands.rs
new file mode 100644
index 0000000..1808060
--- /dev/null
+++ b/crates/assay-domain/tests/it/decide_commands.rs
@@ -0,0 +1,286 @@
+//! `decide` waive and override (`docs/architecture/04-pipeline.md` §5), and the parts of the
+//! decision that describe findings: counts, dispositions and the digests.
+
+use std::error::Error;
+
+use assay_domain::{
+    Conclusion, Counts, Decision, DecisionInputs, Deferral, Disposition, FindingDisposition,
+    GateConclusion, LlmStage, Override, OverrideScope, OwnerApproval, PrClass, ReasonCode,
+    Severity, Tier, Waived, Waiver, decide,
+};
+
+use crate::support::{clean_inputs, confirmed, gate, gate_finding, reason, rubric_v1};
+
+/// `printf 'gate-failed\n' | sha256sum`
+const GATE_FAILED_DIGEST: &str =
+    "sha256:edfab635b96543711e1a2662a111f30252334d5a72e82c9d11bb62e35ad7e231";
+/// `printf 'budget-deferred\n' | sha256sum`
+const BUDGET_DEFERRED_DIGEST: &str =
+    "sha256:ab60963112e40bec2b8fcd6c5c6970d3a93d64968fce1754d512ab6b8e767e1d";
+/// `printf 'gate-failed\nneeds-split\n' | sha256sum`
+const GATE_FAILED_NEEDS_SPLIT_DIGEST: &str =
+    "sha256:f9838b74a72d134a2d6270babd99be12097ea49c033b6ab2e780ef72f630024f";
+
+fn decided(inputs: &DecisionInputs) -> Result<Decision, Box<dyn Error>> {
+    Ok(decide(&rubric_v1()?, inputs))
+}
+
+/// A failed temper gate with a raised baseline (waivable) and, when `with_clippy`, a clippy
+/// finding (never waivable).
+fn temper_failed(with_clippy: bool) -> DecisionInputs {
+    let mut findings = vec![gate_finding("00000000000000a1", "raised", Severity::Major)];
+    if with_clippy {
+        findings.push(gate_finding(
+            "00000000000000a2",
+            "clippy::unwrap_used",
+            Severity::Blocker,
+        ));
+    }
+    let mut inputs = clean_inputs();
+    inputs.gates = vec![gate("temper", GateConclusion::Fail, findings)];
+    inputs
+}
+
+fn waiver(fp: &str) -> Waiver {
+    Waiver {
+        fp: fp.to_owned(),
+        by: "owner".to_owned(),
+    }
+}
+
+fn override_record(scope: OverrideScope, digest: &str) -> Override {
+    Override {
+        scope,
+        reasons_digest: digest.to_owned(),
+        by: "owner".to_owned(),
+    }
+}
+
+#[test]
+fn waiving_the_only_human_decision_finding_clears_the_gate() -> Result<(), Box<dyn Error>> {
+    let mut inputs = temper_failed(false);
+    inputs.waivers = vec![waiver("00000000000000a1")];
+
+    let decision = decided(&inputs)?;
+
+    assert_eq!(decision.conclusion, Conclusion::Success);
+    assert_eq!(decision.reasons, []);
+    assert_eq!(
+        decision.waived,
+        [Waived {
+            fp: "00000000000000a1".to_owned(),
+            by: "owner".to_owned(),
+        }]
+    );
+    assert_eq!(
+        decision.dispositions,
+        [FindingDisposition {
+            fp: "00000000000000a1".to_owned(),
+            code: Disposition::WaivedByOwner,
+        }]
+    );
+    Ok(())
+}
+
+#[test]
+fn a_waiver_never_removes_a_clippy_finding() -> Result<(), Box<dyn Error>> {
+    let mut inputs = temper_failed(true);
+    inputs.waivers = vec![waiver("00000000000000a2")];
+
+    let decision = decided(&inputs)?;
+
+    assert_eq!(decision.conclusion, Conclusion::Failure);
+    assert_eq!(decision.reasons, [reason(ReasonCode::GateFailed, "temper")]);
+    assert_eq!(decision.waived, []);
+    Ok(())
+}
+
+#[test]
+fn waiving_one_finding_leaves_the_gate_failed_by_the_others() -> Result<(), Box<dyn Error>> {
+    let mut inputs = temper_failed(true);
+    inputs.waivers = vec![waiver("00000000000000a1")];
+
+    let decision = decided(&inputs)?;
+
+    assert_eq!(decision.conclusion, Conclusion::Failure);
+    assert_eq!(decision.reasons, [reason(ReasonCode::GateFailed, "temper")]);
+    assert_eq!(
+        decision.waived.len(),
+        1,
+        "the raised finding is still waived"
+    );
+    Ok(())
+}
+
+#[test]
+fn an_all_override_neutralises_a_gate_failure_and_keeps_its_reasons() -> Result<(), Box<dyn Error>>
+{
+    let mut inputs = temper_failed(true);
+    inputs.override_record = Some(override_record(OverrideScope::All, GATE_FAILED_DIGEST));
+
+    let decision = decided(&inputs)?;
+
+    assert_eq!(decision.conclusion, Conclusion::Neutral);
+    assert_eq!(
+        decision.reasons,
+        [
+            reason(ReasonCode::GateFailed, "temper"),
+            reason(ReasonCode::Override, "all"),
+        ]
+    );
+    assert_eq!(decision.reasons_digest(), GATE_FAILED_DIGEST);
+    Ok(())
+}
+
+#[test]
+fn an_llm_override_does_not_neutralise_a_gate_failure() -> Result<(), Box<dyn Error>> {
+    let mut inputs = temper_failed(true);
+    inputs.override_record = Some(override_record(OverrideScope::Llm, GATE_FAILED_DIGEST));
+
+    let decision = decided(&inputs)?;
+
+    assert_eq!(decision.conclusion, Conclusion::Failure);
+    assert_eq!(decision.reasons, [reason(ReasonCode::GateFailed, "temper")]);
+    Ok(())
+}
+
+#[test]
+fn an_llm_override_neutralises_a_pending_deferral() -> Result<(), Box<dyn Error>> {
+    let mut inputs = clean_inputs();
+    inputs.pr.classes = vec![PrClass::TrustPath];
+    inputs.pr.owner_approval = OwnerApproval::Approved;
+    inputs.llm = LlmStage::Deferred {
+        reason: Deferral::BudgetDeferred,
+    };
+    inputs.override_record = Some(override_record(OverrideScope::Llm, BUDGET_DEFERRED_DIGEST));
+
+    let decision = decided(&inputs)?;
+
+    assert_eq!(decision.conclusion, Conclusion::Neutral);
+    assert_eq!(
+        decision.reasons.iter().map(|r| r.code).collect::<Vec<_>>(),
+        [ReasonCode::BudgetDeferred, ReasonCode::Override]
+    );
+    Ok(())
+}
+
+#[test]
+fn an_override_is_void_once_a_reason_is_added() -> Result<(), Box<dyn Error>> {
+    let mut inputs = temper_failed(true);
+    inputs.pr.tier = Tier::NeedsSplit;
+    inputs.override_record = Some(override_record(OverrideScope::All, GATE_FAILED_DIGEST));
+
+    let decision = decided(&inputs)?;
+
+    assert_eq!(decision.conclusion, Conclusion::Failure);
+    assert_eq!(decision.reasons_digest(), GATE_FAILED_NEEDS_SPLIT_DIGEST);
+    assert!(
+        decision
+            .reasons
+            .iter()
+            .all(|r| r.code != ReasonCode::Override),
+        "{:?}",
+        decision.reasons
+    );
+    Ok(())
+}
+
+#[test]
+fn an_override_leaves_a_success_alone() -> Result<(), Box<dyn Error>> {
+    let mut inputs = clean_inputs();
+    inputs.override_record = Some(override_record(
+        OverrideScope::All,
+        "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
+    ));
+
+    let decision = decided(&inputs)?;
+
+    assert_eq!(decision.conclusion, Conclusion::Success);
+    assert_eq!(decision.reasons, []);
+    Ok(())
+}
+
+#[test]
+fn counts_hold_reviewer_findings_and_unwaived_gate_findings() -> Result<(), Box<dyn Error>> {
+    let mut inputs = temper_failed(true);
+    inputs.waivers = vec![waiver("00000000000000a1")];
+    inputs.findings = vec![
+        confirmed("0000000000000001", Severity::Major),
+        confirmed("0000000000000002", Severity::Minor),
+        confirmed("0000000000000003", Severity::Nit),
+    ];
+
+    let decision = decided(&inputs)?;
+
+    assert_eq!(
+        decision.counts,
+        Counts {
+            blocker: 1,
+            major: 1,
+            minor: 1,
+            nit: 1,
+        }
+    );
+    Ok(())
+}
+
+#[test]
+fn upstream_dispositions_are_kept_sorted() -> Result<(), Box<dyn Error>> {
+    let mut inputs = clean_inputs();
+    let disposition = |fp: &str, code| FindingDisposition {
+        fp: fp.to_owned(),
+        code,
+    };
+    inputs.dispositions = vec![
+        disposition("00000000000000f2", Disposition::NoTrigger),
+        disposition("00000000000000f1", Disposition::DuplicateOfGate),
+    ];
+
+    let decision = decided(&inputs)?;
+
+    assert_eq!(
+        decision.dispositions,
+        [
+            disposition("00000000000000f1", Disposition::DuplicateOfGate),
+            disposition("00000000000000f2", Disposition::NoTrigger),
+        ]
+    );
+    Ok(())
+}
+
+#[test]
+fn the_inputs_digest_is_a_sha256_in_lowercase_hex() -> Result<(), Box<dyn Error>> {
+    let decision = decided(&clean_inputs())?;
+
+    let hex = decision
+        .inputs_digest
+        .strip_prefix("sha256:")
+        .ok_or("no sha256: prefix")?;
+
+    assert_eq!(hex.len(), 64, "{hex}");
+    assert!(
+        hex.bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),
+        "{hex}"
+    );
+    Ok(())
+}
+
+#[test]
+fn the_inputs_digest_changes_with_any_input() -> Result<(), Box<dyn Error>> {
+    let base = decided(&clean_inputs())?.inputs_digest;
+    let mut renamed = clean_inputs();
+    renamed.decision_key.push('x');
+    let mut requeued = clean_inputs();
+    requeued.pr.requeues = 1;
+    let mut waived = clean_inputs();
+    waived.waivers = vec![waiver("00000000000000a1")];
+
+    let digests = [renamed, requeued, waived]
+        .iter()
+        .map(|inputs| decided(inputs).map(|d| d.inputs_digest))
+        .collect::<Result<Vec<_>, _>>()?;
+
+    assert!(digests.iter().all(|d| *d != base), "{base} in {digests:?}");
+    Ok(())
+}
