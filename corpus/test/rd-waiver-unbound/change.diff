+            llm_blockers: LlmPolicy::Advisory,
+            llm_majors: LlmPolicy::Advisory,
+            on_infra_failure: InfraPolicy::Warn,
+            block_on_infra_for: vec![PrClass::TrustPath, PrClass::ExecSurface],
+        },
