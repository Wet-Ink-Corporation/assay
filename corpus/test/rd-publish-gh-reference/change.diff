+        prop_assert!(!text.contains('@'), "{text:?}");
+        prop_assert!(!text.contains('#'), "{text:?}");
+        prop_assert!(!text.contains("://"), "{text:?}");
+        prop_assert!(!text.to_ascii_lowercase().contains("www."), "{text:?}");
+        prop_assert!(
+            !text.chars().any(|c| c != '\n' && super::is_hidden(c)),
+            "{text:?}"
+        );
+        prop_assert!(
+            !text.lines().any(|line| line.starts_with(char::is_whitespace)),
+            "{text:?}"
+        );
+    }
+}
