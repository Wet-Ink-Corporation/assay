{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:assay:schema:run:1",
  "title": "assay.run/1",
  "description": "Run description written by `plan`, extended with `budget` by `admit` (docs/architecture/03-contracts.md §4). Informational for Z3 and recomputed by Z4. Unknown fields are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "run_key", "repo", "pr", "base_sha", "head_sha", "base_ref", "tier",
    "tier_reasons", "classes", "roles", "required_roles", "shards", "plugins",
    "trust_paths_changed", "exec_surface_changed", "filtered_stats", "artifact_names", "draft"
  ],
  "properties": {
    "schema": { "const": "assay.run/1" },
    "run_key": { "$ref": "#/$defs/nonEmpty" },
    "repo": { "$ref": "#/$defs/nonEmpty" },
    "pr": { "type": "integer", "minimum": 1 },
    "base_sha": { "$ref": "#/$defs/sha" },
    "head_sha": { "$ref": "#/$defs/sha" },
    "base_ref": { "$ref": "#/$defs/nonEmpty" },
    "tier": { "enum": ["trivial", "micro", "lite", "full"] },
    "tier_reasons": { "$ref": "#/$defs/strings" },
    "classes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["trust-path", "exec-surface"] }
    },
    "roles": { "$ref": "#/$defs/strings" },
    "required_roles": { "$ref": "#/$defs/strings" },
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["files"],
        "properties": { "files": { "$ref": "#/$defs/strings" } }
      }
    },
    "plugins": { "type": "array", "items": { "$ref": "#/$defs/plugin" } },
    "trust_paths_changed": { "$ref": "#/$defs/strings" },
    "exec_surface_changed": { "$ref": "#/$defs/strings" },
    "filtered_stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "lines", "excluded"],
      "properties": {
        "files": { "$ref": "#/$defs/count" },
        "lines": { "$ref": "#/$defs/count" },
        "excluded": { "$ref": "#/$defs/strings" }
      }
    },
    "artifact_names": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/nonEmpty" }
    },
    "draft": { "type": "boolean" },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger_day_spent_aeu", "day_cap_aeu", "window_state", "allowed", "slot"],
      "properties": {
        "ledger_day_spent_aeu": { "$ref": "#/$defs/aeu" },
        "day_cap_aeu": { "$ref": "#/$defs/aeu" },
        "window_state": { "$ref": "#/$defs/nonEmpty" },
        "allowed": { "type": "boolean" },
        "slot": { "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }] }
      }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "strings": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "count": { "type": "integer", "minimum": 0 },
    "aeu": { "type": "number", "minimum": 0 },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required", "pin", "steps"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmpty" },
        "required": { "type": "boolean" },
        "pin": { "$ref": "#/$defs/nonEmpty" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "job", "timeout_s"],
            "properties": {
              "name": { "$ref": "#/$defs/nonEmpty" },
              "job": { "$ref": "#/$defs/nonEmpty" },
              "timeout_s": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
